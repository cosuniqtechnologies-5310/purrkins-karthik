          "type": "url",
          "id": "report_file_4",
          "label": "Batch 4 Report File",
          "info": "Upload PDF to Content > Files and paste link here."
        },
        {
          "type": "text",
          "id": "batch_name_5",
          "label": "Batch 5 Name"
        },
        {
          "type": "url",
          "id": "report_file_5",
          "label": "Batch 5 Report File",
