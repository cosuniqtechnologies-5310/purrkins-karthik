<div id="purrkins-free-sample-{{ section.id }}" class="free-sample-block {{ section.settings.custom_class }}">
    <div class="purrkins-container fs-free-banner">
        <div class="fs-inner">
            <div class="fs-content-wrap">
                <div class="fs-illustration">
                    {% if section.settings.image != blank %}
                        <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.image.alt | escape }}" width="692" height="auto" />
                    {% else %}
                        <div class="fs-placeholder">Image</div>
                    {% endif %}
                </div>
                
                <div class="fs-text">
                    {% if shop.metafields.custom.samples_left != blank %}
                        {% assign active_samples_left = shop.metafields.custom.samples_left %}
                    {% else %}
                        {% assign active_samples_left = 128 %}
                    {% endif %}
                    
                    <h2 class="fs-heading">{{ section.settings.heading }}</h2>
                    <p class="fs-subheading">
                        {{ section.settings.subheading_prefix }} 
                        <span class="fs-highlight-number" id="fs-count-highlight-{{ section.id }}">{{ active_samples_left }}</span> 
                        {{ section.settings.subheading_suffix }}
                    </p>
                </div>
                <div class="fs-form-container">
                    {% if section.settings.api_endpoint != blank %}
                        <!-- Custom Endpoint Form -->
                        <form id="fs-raw-form-{{ section.id }}" class="fs-raw-form fs-ajax-form" data-endpoint="{{ section.settings.api_endpoint }}">
                            <div class="fs-form-success" style="display: none;">Claimed! We will reach out soon.</div>
                            <div class="fs-fields">
                                <div class="fs-form-group">
                                    <input type="text" name="fs_name" placeholder="Full Name" required />
                                </div>
                                <div class="fs-form-group">
                                    <input type="tel" name="fs_phone" placeholder="Mobile Number" required oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                                </div>
                                <div class="fs-form-group fs-form-submit">
                                    <button type="submit" class="fs-submit-btn">Claim Free Sample</button>
                                </div>
                            </div>
                        </form>
                    {% else %}
                        <!-- Native Shopify Form -->
                        {% form 'create_customer', id: 'fs-contact-form', class: 'fs-raw-form fs-ajax-form', return_to: 'back' %}
                            <div class="fs-form-success" style="display: none;">Claimed! We will reach out soon.</div>
                            <div class="fs-fields">
                                <input type="hidden" name="customer[tags]" value="free-sample-claim">
                                {% assign random_id = "now" | date: "%N" %}
                                <input type="hidden" name="customer[email]" value="lead-{{ random_id }}@noemail.purrkins.com">
                                <input type="hidden" name="customer[password]" value="Sample123!@#">
                                <input type="hidden" name="customer[addresses][0][country]" value="India">
                                <input type="hidden" name="customer[note][Phone]" value="">
                                
                                <div class="fs-form-group">
                                    <input type="text" name="customer[first_name]" placeholder="Full Name" required />
                                </div>
                                <div class="fs-form-group">
                                    <input type="tel" name="customer[addresses][0][phone]" placeholder="Mobile Number" required oninput="this.value = this.value.replace(/[^0-9]/g, '')" />
                                </div>
                                <div class="fs-form-group fs-form-submit">
                                    <button type="submit" class="fs-submit-btn">Claim Free Sample</button>
                                </div>
                            </div>
                        {% endform %}
                    {% endif %}
                </div>
            </div>

            {% assign total = section.settings.total_samples | plus: 0 %}
            {% assign left = active_samples_left | plus: 0 %}
            {% assign claimed = total | minus: left %}
            {% if total > 0 %}
                {% assign progress_percent = claimed | times: 100.0 | divided_by: total %}
            {% else %}
                {% assign progress_percent = 0 %}
            {% endif %}
            
            {% if progress_percent > 100 %}{% assign progress_percent = 100 %}{% endif %}
            {% if progress_percent < 0 %}{% assign progress_percent = 0 %}{% endif %}

            <div class="fs-progress-container">
                <div class="fs-progress-bar">
                    <div class="fs-progress-fill" id="fs-progress-fill-{{ section.id }}" style="width: {{ progress_percent }}%;">
                        <div class="fs-progress-badge">
                            <span class="fs-badge-text" id="fs-badge-text-{{ section.id }}">{{ left }} left</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.free-sample-block {
    margin: 8px auto 80px;
    width: 100%;
}
.fs-inner {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border-radius: var(--border-radius-purrkins, 12px);
    background: var(--accent-purple-light, #EAE8F9);
    align-items: center;
}

.purrkins-container.fs-free-banner {
    padding: 0 20px;
}

.fs-content-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    max-width: 1108px;
    padding: 38px 30px 60px 0;
}
.fs-illustration {
    flex: 0 0 360px;
    display: flex;
    align-items: flex-end;
}
.fs-illustration img {
    display: block;
    bottom: 0;
    position: absolute;
    max-width: 692px;
    left: 0;
    object-fit: cover;
}
.fs-placeholder {
    width: 150px;
    height: 150px;
    background: #ccc;
    display: flex;
    align-items: center;
    justify-content: center;
}
.fs-text {
    flex: 1;
    min-width: 300px;
    max-width: 330px;
    z-index: 1;
}
.fs-heading {
    margin: 0 0 8px;
    color: var(--color-text-primary, #121217);
    font-family: var(--purrkins-heading-font);
    font-size: 32px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.32px;
}
.fs-subheading {
    margin: 0;
    color: var(--purple-600, #5F4785);
    font-size: 18px;
    font-weight: 400;
    line-height: 1.44;
}

.fs-form-group {
    display: flex;
}

.fs-form-container {
    flex: 0 0 225px;
    display: flex;
    flex-direction: column;
    justify-content: center;
}
.fs-raw-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.fs-fields {
    display: flex;
    flex-direction: column;
    gap: 8px;
}
.fs-form-success {
    color: var(--purple-600, #5F4785);
    font-family: var(--purrkins-heading-font);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
    text-align: center;
    background: #FFF;
    padding: 30px 20px;
    border-radius: var(--border-radius-purrkins, 12px);
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-height: 130px;
}
.fs-raw-form input {
    width: 100%;
    outline: none;
    padding: 6.803px 13.606px;
    color: var(--semantic-text-primary, #21252A);
    font-size: 14px;
    font-weight: 400;
    line-height: 22px;
    border-radius: var(--border-radius-purrkins, 12px);
    border: 0.3px solid var(--color-text-secondary, #595961);
    background: var(--neutral-white, #FFF);
}

.fs-raw-form input::placeholder {
    color: var(--semantic-text-secondary, #424953);
}

.fs-raw-form input:focus {
    border-color: #7D8DF5;
}
.fs-submit-btn {
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    border-radius: 999px;
    background: var(--brand-slate-900, #21252A);
    display: inline-flex;
    padding: 12px 22px;
    justify-content: center;
    align-items: center;
    color: #FFF;
    font-family: var(--purrkins-heading-font);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.18px;
    border: none;
    cursor: pointer;
    margin-top: 10px;
}
.fs-submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgb(33 37 42 / 40%);
}
.fs-submit-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
}

/* Progress bar section */
.fs-progress-container {
    position: relative;
    width: 100%;
    height: 5px;
    margin-top: auto;
    background: var(--accent-purple-light, #EAE8F9);
}
.fs-progress-fill {
    height: 5px;
    position: relative;
    background: var(--accent-purple-600, #717EEF);
    transition: width 0.5s ease-out;
}
.fs-progress-badge {
    position: absolute;
    right: 0;
    top: -50px;
    transform: translateX(50%);
    white-space: nowrap;
    display: flex;
    width: 72px;
    height: 31px;
    padding: 5.507px 8.812px;
    justify-content: center;
    align-items: center;
    gap: 5.507px;
    border-radius: 11.014px;
    background: var(--neutral-white, #FFF);
    color: var(--accent-purple-500, #A49CDE);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.14px;
}
/* Triangle pointing down */
.fs-progress-badge::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 50%;
    transform: translateX(-50%);
    border-width: 6px 6px 0;
    border-style: solid;
    border-color: #FFF transparent transparent transparent;
}

/* Error Message Styling */
.fs-error-msg {
    background: #FFF0F0;
    border: 1px solid #FFCDD2;
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 16px;
    color: #D32F2F;
    font-size: 14px;
    line-height: 1.4;
}
.fs-error-msg ul {
    margin: 0;
    padding-left: 20px;
}
.fs-error-msg li {
    margin-bottom: 4px;
}
.fs-error-msg li:last-child {
    margin-bottom: 0;
}

@media(max-width: 1200px){
    .fs-illustration img{
        max-width: 560px;
    }
}

@media(max-width: 1024px){
    .fs-content-wrap{
          padding: 38px 24px 80px 0;
    }
    .fs-heading{
        font-size: 28px;
    }
    .free-sample-block{
        margin: 8px auto 60px;
    }
}

@media (max-width: 991px) {
    .fs-content-wrap {
        padding: 40px 20px 150px;
        flex-direction: column;
        text-align: center;
    }
    .fs-form-container {
        flex: 1;
        width: 100%;
        z-index: 1;
    }
    .fs-illustration {
        flex: none;
    }
    .fs-illustration img{
        margin-bottom: 0;
        height: auto;
    }
    .fs-text {
        max-width: 600px;
    }
    .fs-form-container {
        max-width: 600px;
        margin: 0 0 40px;
    }
}

@media(max-width: 767px){
    .fs-content-wrap {
                padding: 28px 20px 90px;
        gap: 0;
    }
    .fs-illustration img{
     max-width: max-content;
        max-height: 130px;

    }
    .fs-heading {
        font-size: 24px;
        max-width: 236px;
        margin: auto;
        margin-bottom: 7px;
    }
    .fs-progress-badge{
        top: -40px;
        width: auto;
        height: auto;
    }
    .fs-text{
        margin-bottom: 16px;
    }
    .fs-subheading{
        font-size: 16px;
    }
    .fs-form-group {
        display: flex;
        justify-content: center;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var form = document.querySelector('#purrkins-free-sample-{{ section.id }} .fs-ajax-form');
    var totalSamples = parseInt("{{ section.settings.total_samples }}", 10) || 1000;
    var initialLeft = parseInt("{{ active_samples_left }}", 10) || 128;
    
    var countHighlight = document.getElementById('fs-count-highlight-{{ section.id }}');
    var badgeText = document.getElementById('fs-badge-text-{{ section.id }}');
    var progressFill = document.getElementById('fs-progress-fill-{{ section.id }}');
    
    if (countHighlight) countHighlight.innerText = initialLeft;
    if (badgeText) badgeText.innerText = initialLeft + ' left';
    
    if (progressFill) {
        var claimed = totalSamples - initialLeft;
        var progress = totalSamples > 0 ? (claimed / totalSamples) * 100 : 0;
        if(progress > 100) progress = 100;
        progressFill.style.width = progress + '%';
    }

    if(form) {
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            var btn = form.querySelector('.fs-submit-btn');
            btn.innerHTML = 'Submitting...';
            btn.disabled = true;

            // Update the DOM inputs directly before creating FormData
            var phoneInput = form.querySelector('input[name="customer[addresses][0][phone]"]') || form.querySelector('input[name="fs_phone"]');
            var notePhone = form.querySelector('input[name="customer[note][Phone]"]');
            
            if (phoneInput && phoneInput.value.trim() !== '') {
                var finalPhone = '+91' + phoneInput.value.trim();
                phoneInput.value = finalPhone; // prepend country code
                if (notePhone) notePhone.value = finalPhone;
            }

            var formData = new FormData(form);

            var endpointUrl = form.getAttribute('data-endpoint');
            if (!endpointUrl || endpointUrl.trim() === '') {
                endpointUrl = form.getAttribute('action') || window.location.pathname;
            }

            fetch(endpointUrl, {
                method: 'POST',
                body: formData
            })
            .then(response => {
                var fields = form.querySelector('.fs-fields');
                var successMsg = form.querySelector('.fs-form-success');
                if (fields) fields.style.display = 'none';
                if (successMsg) successMsg.style.display = 'flex';
                
                var currentLeftStr = countHighlight.innerText;
                var currentLeft = parseInt(currentLeftStr, 10) || 0;
                
                if (currentLeft > 0) {
                    var newLeft = currentLeft - 1;
                    countHighlight.innerText = newLeft;
                    if (badgeText) badgeText.innerText = newLeft + ' left';
                    
                    var newClaimed = totalSamples - newLeft;
                    var newProgress = totalSamples > 0 ? (newClaimed / totalSamples) * 100 : 0;
                    if(newProgress > 100) newProgress = 100;
                    if (progressFill) progressFill.style.width = newProgress + '%';
                }

                setTimeout(function() {
                    if (successMsg) successMsg.style.display = 'none';
                    if (fields) fields.style.display = 'flex';
                    form.reset();
                    btn.innerHTML = 'Claim Free Sample';
                    btn.disabled = false;
                }, 8000);
            })
            .catch(error => {
                console.error("Fetch error:", error);
                btn.innerHTML = 'Claim Free Sample';
                btn.disabled = false;
                alert('Network error. Please try again.');
            });
        });
    }
});
</script>

{% schema %}
{
  "name": "Purrkins Free Sample",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Eligible cat parents in select cities can claim a free sample."
    },
    {
      "type": "text",
      "id": "subheading_prefix",
      "label": "Subheading Prefix",
      "default": "Last"
    },
    {
      "type": "text",
      "id": "subheading_suffix",
      "label": "Subheading Suffix",
      "default": "samples left. Running out fast."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Illustration Image"
    },
    {
      "type": "header",
      "content": "Sample Count Settings"
    },
    {
      "type": "number",
      "id": "total_samples",
      "label": "Total Samples Available",
      "default": 1000,
      "info": "Used to calculate the progress bar percentage."
    },
    {
      "type": "header",
      "content": "API Integration (Advanced)"
    },
    {
      "type": "text",
      "id": "api_endpoint",
      "label": "Custom API Endpoint URL",
      "info": "If you want real-time dynamic reductions synced with a database, enter your webhook or API URL here (e.g. AWS Lambda, Zapier, Make). The form will POST data to this URL. Leave empty to use local simulated reduction."
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class"
    }
  ],
  "presets": [
    {
      "name": "Purrkins Free Sample Banner"
    }
  ]
}
{% endschema %}
