{{ 'purrkins-unlock-benefit.css' | asset_url | stylesheet_tag }}

<div class="pf-ub-section purrkins-container purrkins-section-block">
    <div class="pf-ub-inner">
        <div class="pf-ub-content">
            <h3 class="pf-ub-heading purrkins-h3-text purrkins-heading-mb">{{ section.settings.heading | escape }}</h3>
            <p class="pf-ub-subheading purrkins-subtext">{{ section.settings.subheading | escape }}</p>
            <button type="button" class="pf-ub-btn purrkins-btn-primary js-ub-open-modal">
                {{ section.settings.button_text | escape }}
            </button>
        </div>
        
        <div class="pf-ub-media">
            {% if section.settings.video_url != blank %}
                <video class="pf-ub-video" autoplay loop muted playsinline preload="metadata">
                    <source src="{{ section.settings.video_url }}" type="video/mp4">
                    Your browser does not support the video tag.
                </video>
            {% elsif section.settings.image != blank %}
                {{ section.settings.image | image_url: width: 800 | image_tag: alt: section.settings.heading, loading: 'lazy', class: 'pf-ub-image' }}
            {% else %}
                <!-- Placeholder if no media uploaded -->
                <div style="width: 100%; height: 400px; background: #f0f0f1; border-radius: 20px; display: flex; align-items: center; justify-content: center; color: #475467;">
                    Please upload an MP4 video or Image in Section Settings.
                </div>
            {% endif %}
        </div>
    </div>
</div>

<!-- Unlock Benefit Modal -->
<div class="pf-ub-modal-overlay" id="ubModalOverlay-{{ section.id }}">
    <div class="pf-ub-modal">
        <button type="button" class="pf-ub-modal-close" id="ubModalClose-{{ section.id }}" aria-label="Close modal">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </button>
        
        <h2 class="pf-ub-modal-title">{{ section.settings.modal_title }}</h2>
        
        <div class="pf-ub-modal-form-wrapper">
            {% form 'contact', id: 'UnlockBenefitForm' %}
              {% if form.posted_successfully? %}
                <div class="form-success" style="color: #25D366; text-align: center; margin-bottom: 20px; font-weight: bold;">
                  Thank you! We've received your request.
                </div>
              {% endif %}
              
              {{ form.errors | default_errors }}
              
              <div class="ub-placeholder-form">
                  <div class="ub-form-row">
                      <div class="ub-form-col">
                          <label for="ContactFormName">Your Name *</label>
                          <input type="text" id="ContactFormName" name="contact[name]" placeholder="Full Name" required>
                      </div>
                      <div class="ub-form-col">
                          <label for="ContactFormPhone">Mobile Number *</label>
                          <input type="tel" id="ContactFormPhone" name="contact[phone]" placeholder="+91" required>
                      </div>
                  </div>
                  <div class="ub-form-row">
                      <div class="ub-form-col" style="flex:1;">
                          <label for="ContactFormEmail">Your Email *</label>
                          <input type="email" id="ContactFormEmail" name="contact[email]" placeholder="yourname@example.com" required>
                      </div>
                  </div>
                  
                  <input type="hidden" name="contact[subject]" value="Unlock Benefit Claim">
                  <input type="hidden" name="contact[product]" value="{{ product.title | escape }}">
                  
                  <div class="ub-form-action">
                      <button type="submit" class="pf-ub-btn purrkins-btn-primary">Claim</button>
                  </div>
              </div>
            {% endform %}
        </div>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
    // Video Lazy Loading
    var lazyVideos = [].slice.call(document.querySelectorAll(".pf-ub-section video"));
    
    if ("IntersectionObserver" in window) {
        var lazyVideoObserver = new IntersectionObserver(function(entries, observer) {
            entries.forEach(function(video) {
                if (video.isIntersecting) {
                    video.target.play();
                } else {
                    video.target.pause();
                }
            });
        });
        
        lazyVideos.forEach(function(lazyVideo) {
            lazyVideoObserver.observe(lazyVideo);
        });
    }

    // Modal Logic
    const openBtn = document.querySelector('.js-ub-open-modal');
    const overlay = document.getElementById('ubModalOverlay-{{ section.id }}');
    const closeBtn = document.getElementById('ubModalClose-{{ section.id }}');

    if (openBtn && overlay && closeBtn) {
        openBtn.addEventListener('click', function(e) {
            e.preventDefault();
            overlay.classList.add('is-active');
            document.body.style.overflow = 'hidden';
        });

        closeBtn.addEventListener('click', function() {
            overlay.classList.remove('is-active');
            document.body.style.overflow = '';
        });

        overlay.addEventListener('click', function(e) {
            if (e.target === overlay) {
                overlay.classList.remove('is-active');
                document.body.style.overflow = '';
            }
        });
    }
});
</script>

{% schema %}
{
  "name": "Unlock Benefit",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You made it all the way here. We noticed."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "If you've taken the time to understand what you're putting in your cat's bowl, we think your cat deserves a little extra care and love too."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Unlock the Benefit"
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Video URL (MP4)",
      "info": "Upload an MP4 to Shopify Files and paste the URL here. (Takes priority over image)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback Image"
    },
    {
      "type": "header",
      "content": "Modal Settings"
    },
    {
      "type": "textarea",
      "id": "modal_title",
      "label": "Modal Title",
      "default": "Claim your kitten's<br>complimentary insurance benefit"
    }
  ],
  "presets": [
    {
      "name": "Unlock Benefit"
    }
  ]
}
{% endschema %}
