<div class="byob-features-section purrkins-section-block" style="background-color: {{ section.settings.bg_color | default: '#FFE330' }}; color: {{ section.settings.text_color | default: '#121217' }};">
  <div class="purrkins-container">
    <div class="byob-features-grid">
      {% for block in section.blocks %}
        <div class="byob-feature-item" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <div class="byob-feature-icon">
              <img src="{{ block.settings.icon | image_url: width: 80 }}" alt="{{ block.settings.heading | escape }}" width="40" height="40">
            </div>
          {% endif %}
          <div class="byob-feature-text">
            <h3 class="purrkins-h3-text" style="color: inherit;">{{ block.settings.heading }}</h3>
            <p class="purrkins-subtext" style="color: inherit;">{{ block.settings.text }}</p>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>

.byob-features-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 40px;
  max-width: 1000px;
  margin: 0 auto;
}
@media (min-width: 768px) {
  .byob-features-grid {
    grid-template-columns: 1fr 1fr;
    column-gap: 80px;
    row-gap: 60px;
  }
}
.byob-feature-item {
  display: flex;
  flex-direction: column;
  gap: 16px;
  align-items: flex-start;
}

.byob-feature-icon {
    background: #ffffff;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    min-width: 80px;
}

.byob-feature-icon img {
    width: 47px;
    height: 47px;
    object-fit: contain;
}
.byob-feature-text h3 {
    margin: 0;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.28;
}
.byob-feature-text p {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    font-weight: 400;
}
@media(max-width: 1024px){
  .byob-feature-item {
    display: flex;
    flex-direction: row;
    gap: 16px;
    align-items: center;
}
}
@media(max-width: 991px){
  .byob-feature-text h3{
    font-size: 16px;
  }
  .byob-feature-text p{
    font-size: 14px;
  }
  .byob-feature-icon{
    min-width: 76px;
    height: 76px;
    width: 76px;
  }
}
</style>

{% schema %}
{
  "name": "BYOB Features",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFDE36"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#202223"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Feature Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Description of the feature goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BYOB Features",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
