<div id="purrkins-trust-features-{{ section.id }}" class="trust-features-block {{ section.settings.custom_class }}">
    
    <div class="trust-features-left-bg"></div>
    <div class="trust-features-right-bg"></div>
    
    <div class="trust-features-left-content">
        <div class="trust-features-left-inner">
            {% if section.settings.heading != blank %}
                <h3 class="trust-features-heading purrkins-h3-text">{{ section.settings.heading }}</h3>
            {% endif %}
            
            {% if section.blocks.size > 0 %}
                <div class="trust-features-grid">
                    {% for block in section.blocks %}
                        <div class="trust-feature-item" {{ block.shopify_attributes }}>
                            <div class="trust-feature-icon">
                                {% if block.settings.icon != blank %}
                                    <img src="{{ block.settings.icon | image_url: width: 200 }}" alt="{{ block.settings.icon.alt | default: block.settings.text | escape }}" width="60" height="auto" />
                                {% endif %}
                            </div>
                            {% if block.settings.text != blank %}
                                <p class="trust-feature-text">{{ block.settings.text }}</p>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
    
    <div class="trust-features-right-content">
        <div class="trust-features-right-inner">
            {% if section.settings.lab_report_heading != blank %}
                <h4 class="lab-report-heading purrkins-h6-text">{{ section.settings.lab_report_heading }}</h4>
            {% endif %}
            
            {% if section.settings.lab_report_qr != blank %}
                <div class="lab-report-qr">
                    <img src="{{ section.settings.lab_report_qr | image_url: width: 400 }}" alt="{{ section.settings.lab_report_qr.alt | escape }}" width="208" height="auto" />
                </div>
            {% endif %}
            
            {% if section.settings.lab_report_btn_url != blank and section.settings.lab_report_btn_text != blank %}
                <div class="lab-report-cta">
                    <a href="{{ section.settings.lab_report_btn_url }}" class="lab-report-btn purrkins-btn-secondary">{{ section.settings.lab_report_btn_text }}</a>
                </div>
            {% endif %}
        </div>
    </div>

</div>

<style>
/* CSS Grid approach perfectly mimics purrkins-container boundaries while allowing full-width backgrounds */
.trust-features-block {
    display: grid;
    /* Col 1: Left Margin, Col 2: Left Content (2/3 of 1336px), Col 3: Right Content (1/3), Col 4: Right Margin */
    grid-template-columns: minmax(20px, 1fr) minmax(0, 890.66px) minmax(0, 445.33px) minmax(20px, 1fr);
    width: 100%;
}

.trust-features-left-bg {
    grid-column: 1 / 3;
    grid-row: 1;
    background: var(--primary-slate-900, #21252A);
}

.trust-features-right-bg {
    grid-column: 3 / 5;
    grid-row: 1;
    background: linear-gradient(180deg, #FCF7DE 0%, #F4EEFF 100%);
}

.trust-features-left-content {
    grid-column: 2 / 3;
    grid-row: 1;
    padding: 80px 20px;
    z-index: 1;
    display: flex;
    justify-content: center;
    align-items: center;
}

.trust-features-left-inner {
    max-width: 800px;
    width: 100%;
    text-align: center;
}

.trust-features-right-content {
    grid-column: 3 / 4;
    grid-row: 1;
        padding: 40px 69px;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.trust-features-right-inner {
max-width: 358px;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
}

.trust-features-heading {
    margin-top: 0;
    margin-bottom: 60px;
    color: var(--semantic-brand, #FFE330);
}

.trust-features-grid {
    display: flex;
    justify-content: space-evenly;
    align-items: flex-start;
    gap: 30px;
    flex-wrap: wrap;
}

.trust-feature-item {
    flex: 1;
    min-width: 180px;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.trust-feature-icon {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 16px;
    height: 60px;
}

.trust-feature-icon img {
    max-height: 100%;
    width: 52px;
    height: 52px;
}

.trust-feature-text {
margin: 0;
    color: var(--color-background, #FFF);
    text-align: center;
    font-size: 20px;
    font-weight: 400;
    line-height: 1.6;
    max-width: 204px;
}

.lab-report-heading {
    margin: 0;
    color: #121217;
    max-width: 325px;   
}

.lab-report-qr {
    background: transparent;
    border-radius: 12px;
}

.lab-report-qr img {
    max-width: 208px;
    height: auto;
    display: block;
    mix-blend-mode: multiply;
}

.lab-report-cta {
    margin-top: 16px;
}

.purrkins-btn-secondary {
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    border-radius: 999px;
    background: var(--brand-slate-900, #21252A);
    display: inline-flex;
    padding: 16px 28px;
    justify-content: center;
    align-items: center;
    color: #FFF;
    font-family: var(--purrkins-heading-font);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.18px;
    border: none;
    cursor: pointer;
}

.purrkins-btn-secondary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgb(33 37 42 / 40%);
}

/* Stacking on smaller screens */
@media (max-width: 992px) {
    .trust-features-block {
        grid-template-columns: minmax(20px, 1fr) minmax(0, 1336px) minmax(20px, 1fr);
    }
    
    .trust-features-left-bg {
        grid-column: 1 / -1;
        grid-row: 1;
    }
    
    .trust-features-right-bg {
        grid-column: 1 / -1;
        grid-row: 2;
    }
    
    .trust-features-left-content {
        grid-column: 2 / 3;
        grid-row: 1;
        padding: 60px 20px 40px;
    }
    
    .trust-features-right-content {
grid-column: 2 / 3;
        grid-row: 2;
        padding: 40px 20px 60px;
    }
}

@media (max-width: 767px) {
    .lab-report-qr img {
    max-width: 172px;
    }

    .trust-features-grid {
            flex-direction: column;
        align-items: center;
        gap: 40px;
        max-width: 178px;
        margin: auto;
    }
    .trust-features-right-content {
            padding-top: 60px;
        padding-bottom: 60px;
    }
    .trust-features-heading{
            margin-bottom: 32px;
    }
    .trust-features-left-content{
             padding: 60px 0 60px;
    }
    .trust-feature-text{
        font-size: 16px;
    }
        .lab-report-cta {
        margin-top: 16px;
    }
}
</style>

{% schema %}
{
  "name": "Purrkins Trust Features",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Left Heading",
      "default": "Why parents trust Purrkins."
    },
    {
      "type": "text",
      "id": "lab_report_heading",
      "label": "Right Heading",
      "default": "Scan the QR code to read the lab report."
    },
    {
      "type": "image_picker",
      "id": "lab_report_qr",
      "label": "QR Code Image"
    },
    {
      "type": "text",
      "id": "lab_report_btn_text",
      "label": "Button Text",
      "default": "View the Lab Report"
    },
    {
      "type": "url",
      "id": "lab_report_btn_url",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Trust Feature",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purrkins Trust Features",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
