}
.pf-collection-card-wrap .price-val {
    display: flex;
    align-items: baseline;
    gap: 8px;
}
.pf-collection-card-wrap .price-sep {
    font-size: 18px;
    font-weight: 400;
    color: #E0E0E3;
}
.pf-collection-card-wrap .price-size {
    font-size: 18px;
    font-weight: 500;
    color: var(--semantic-text-primary, #21252A);
}
.pf-collection-card-wrap .pf-fbt-action {
    display: flex;
    justify-content: center;
    width: 100%;
    margin-top: auto;
}
.pf-collection-card-wrap .pf-add-to-cart-form {
      width: 100%;
    display: flex;
    justify-content: center;
}
.pf-collection-card-wrap .pf-fbt-add-btn {
    padding: 14px 22px;
}

@media(max-width: 767px){
    .pf-collection-card-wrap .price-val {
        font-size: 20px;
    }
    .pf-collection-card-wrap .price-size {
        font-size: 16px;
    }
    .pf-collection-card-wrap .pf-product-excerpt{
        font-size: 14px;
    }
}
</style>
