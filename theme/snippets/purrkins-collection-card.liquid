    padding: 77px 20px 32px 20px;
}
.pf-collection-card-wrap .pf-product-badge {
    position: absolute;
    top: 20px;
    left: 20px;
    border-radius: 999px;
    background: var(--accent-teal-500, #BFE3DF);
    display: inline-flex;
    padding: 6px 14px;
    align-items: center;
    color: var(--accent-teal-900, #1F5E58);
    font-family: var(--purrkins-heading-font);
    font-size: 14px;
    font-weight: 700;
    line-height: 20px;
    letter-spacing: 0.14px;
}
.pf-collection-card-wrap .pf-product-image img {
  max-width: 100%;
  max-height: 250px;
  object-fit: contain;
}
.pf-collection-card-wrap .pf-product-info {
    display: flex;
    padding: 0 20px 22px 20px;
    flex-direction: column;
    flex-grow: 1;
    gap: 10px;
}
.pf-collection-card-wrap .pf-product-title {
    font-size: 24px;
    font-weight: 700;
    color: var(--semantic-text-primary, #21252A);
    margin: 0;
    font-family: var(--purrkins-heading-font);
    text-align: center;
}
.pf-collection-card-wrap .pf-product-title a {
  color: inherit;
  text-decoration: none;
}
.pf-collection-card-wrap .pf-product-excerpt {
    color: #595961;
    text-align: center;
    font-size: 16px;
    font-weight: 500;
