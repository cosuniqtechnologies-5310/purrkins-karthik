{% assign collection_to_use = current_collection | default: product.collections.first %}
{% assign card_bg_color = collection_to_use.metafields.custom.card_bg_color | default: '#f9f9f9' %}
{% assign card_main_color = collection_to_use.metafields.custom.card_primary_color | default: '#333' %}
{% assign badge_text = collection_to_use.title %}

<div class="pf-collection-card-wrap">
    <div class="pf-product-card" style="background-color: {{ card_bg_color }};">
        {% if badge_text != blank %}
            <span class="pf-product-badge" style="background-color: {{ card_bg_color }}; border: 1px solid {{ card_main_color }}; color: {{ card_main_color }};">
                {{ badge_text }}
            </span>
        {% endif %}
        
        <a href="{{ product.url }}" class="pf-product-image">
            {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy" width="100%" height="auto">
            {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
        </a>
    </div>
    
    <div class="pf-product-info">
        <h4 class="pf-product-title purrkins-h6-text">
            <a href="{{ product.url }}">{{ product.title }}</a>
        </h4>
        <div class="pf-product-price">
            <span class="price-val">{{ product.price | money_without_trailing_zeros | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' }}</span>
            <span class="price-sep">|</span>
            <span class="price-size">
                {% if product.variants.first.weight > 0 %}
                    {{ product.variants.first.weight | round }}{{ product.variants.first.weight_unit }}
                {% else %}
                    70g
                {% endif %}
            </span>
        </div>
        <div class="pf-product-excerpt">
            {{ product.metafields.custom.short_description | default: 'Real broth for daily hydration' }}
        </div>
        
        <div class="pf-fbt-action">
            <form method="post" action="/cart/add" class="pf-add-to-cart-form">
                <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                <button type="submit" class="pf-fbt-add-btn purrkins-btn-primary pf-add-to-cart-btn">
                    Add to Cart
                </button>
            </form>
        </div>
    </div>
</div>

<script>
  if (!window.pfCollectionCardAjaxInitialized) {
    window.pfCollectionCardAjaxInitialized = true;
    document.addEventListener('submit', function(e) {
      if (e.target && e.target.matches('.pf-add-to-cart-form')) {
        e.preventDefault();
        const form = e.target;
        const btn = form.querySelector('.pf-add-to-cart-btn');
        let originalText = 'Add to Cart';
        
        if (btn) {
          originalText = btn.innerHTML;
          btn.innerHTML = 'Adding...';
          btn.disabled = true;
        }

        const formData = new FormData(form);
        formData.append('sections', 'cart-drawer-section');
        formData.append('sections_url', window.location.pathname);
        
        fetch((window.Shopify && window.Shopify.routes) ? window.Shopify.routes.root + 'cart/add.js' : '/cart/add.js', {
          method: 'POST',
          body: formData,
          headers: {
            'X-Requested-With': 'XMLHttpRequest'
          }
        })
        .then(res => res.json())
        .then(async data => {
          const eventName = (window.StandardEvents && window.StandardEvents.cartLinesUpdate) ? window.StandardEvents.cartLinesUpdate : 'shopify:cart:lines-update';
          const updateEvent = new CustomEvent(eventName, { bubbles: true });
          updateEvent.action = 'add';
          let resolvePromise;
          const promise = new Promise((resolve) => { resolvePromise = resolve; });
          updateEvent.promise = promise;
          document.dispatchEvent(updateEvent);

          const cartData = await fetch(window.Shopify.routes ? window.Shopify.routes.root + 'cart.js' : '/cart.js').then(r => r.json()).catch(() => null);
          resolvePromise({ cart: cartData, detail: { items: data.items || [data], sections: data.sections, itemCount: cartData ? cartData.item_count : 0 } });
          
          document.documentElement.dispatchEvent(new CustomEvent('cart:build', {bubbles: true}));

          if (btn) {
            btn.innerHTML = originalText;
            btn.disabled = false;
          }
        })
        .catch(err => {
          console.error(err);
          rejectPromise(err);
          if (btn) {
            btn.innerHTML = originalText;
            btn.disabled = false;
          }
        });
      }
    });
  }
</script>

