{% assign collection_to_use = current_collection %}
{% if collection_to_use == blank or collection_to_use.handle == 'all' or collection_to_use.handle == 'frontpage' %}
  {% for coll in product.collections %}
    {% if coll.handle != 'all' and coll.handle != 'frontpage' %}
      {% assign collection_to_use = coll %}
      {% break %}
    {% endif %}
  {% endfor %}
  {% if collection_to_use == blank %}
    {% assign collection_to_use = product.collections.first %}
  {% endif %}
{% endif %}

{% assign card_bg_color = collection_to_use.metafields.custom.card_bg_color.value | default: collection_to_use.metafields.custom.card_bg_color %}
{% assign card_main_color = collection_to_use.metafields.custom.card_primary_color.value | default: collection_to_use.metafields.custom.card_primary_color %}
{% assign badge_text = collection_to_use.title %}

{% assign p_handle = product.handle | downcase %}
{% assign p_title = product.title | downcase %}
{% assign c_handle = collection_to_use.handle | downcase %}

{% if badge_text == blank or badge_text == 'All' or badge_text == 'All Products' %}
  {% if c_handle contains 'wet' or p_handle contains 'wet' or p_title contains 'broth' or p_title contains 'chicken' or p_title contains 'mackerel' or p_title contains 'kitty' %}
    {% assign badge_text = 'Wet Fresh Food' %}
  {% elsif c_handle contains 'dry' or p_handle contains 'dry' or p_title contains 'dry' %}
    {% assign badge_text = 'Dry Food' %}
  {% elsif c_handle contains 'treat' or p_handle contains 'treat' or p_title contains 'jerky' %}
    {% assign badge_text = 'Treats' %}
  {% elsif c_handle contains 'wellness' or p_handle contains 'wellness' %}
    {% assign badge_text = 'Wellness' %}
  {% elsif c_handle contains 'combo' or p_title contains 'combo' %}
    {% assign badge_text = 'Combos' %}
  {% else %}
    {% assign badge_text = product.type | default: 'Purrkins' %}
  {% endif %}
{% endif %}

{% if card_bg_color == blank or card_bg_color == '#f9f9f9' or card_bg_color == '#fff' or card_bg_color == '#ffffff' %}
  {% if badge_text == 'Wet Fresh Food' or c_handle contains 'wet' or p_title contains 'broth' or p_title contains 'kitty' %}
    {% assign card_bg_color = '#E5F4F2' %}
    {% assign card_main_color = '#1D645E' %}
  {% elsif badge_text == 'Dry Food' or c_handle contains 'dry' %}
    {% assign card_bg_color = '#F0F6E6' %}
    {% assign card_main_color = '#4A6B22' %}
  {% elsif badge_text == 'Treats' or c_handle contains 'treat' or p_title contains 'jerky' %}
    {% assign card_bg_color = '#FDEFE2' %}
    {% assign card_main_color = '#A85923' %}
  {% elsif badge_text == 'Wellness' or c_handle contains 'wellness' %}
    {% assign card_bg_color = '#EBF4FA' %}
    {% assign card_main_color = '#285A82' %}
  {% elsif badge_text == 'Combos' or c_handle contains 'combo' %}
    {% assign card_bg_color = '#F5EEFA' %}
    {% assign card_main_color = '#6C3483' %}
  {% else %}
    {% assign card_bg_color = '#E5F4F2' %}
    {% assign card_main_color = '#1D645E' %}
  {% endif %}
{% endif %}

<div class="pf-collection-card-wrap">
    <div class="pf-product-card" style="background-color: {{ card_bg_color }};">
        {% if badge_text != blank %}
            <span class="pf-product-badge" style="background-color: {{ card_bg_color }}; border: 1px solid {{ card_main_color }}; color: {{ card_main_color }};">
                {{ badge_text }}
            </span>
        {% endif %}
        
        <a href="{{ product.url }}" class="pf-product-image">
            {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy" width="100%" height="auto">
            {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
        </a>
    </div>
    
    <div class="pf-product-info">
        <h4 class="pf-product-title purrkins-h6-text">
            <a href="{{ product.url }}">{{ product.title }}</a>
        </h4>
        <div class="pf-product-price">
            <span class="price-val">{{ product.price | money_without_trailing_zeros | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' }}</span>
            <span class="price-sep">|</span>
            <span class="price-size">
                {% if product.variants.first.weight > 0 %}
                    {{ product.variants.first.weight | round }}{{ product.variants.first.weight_unit }}
                {% else %}
                    70g
                {% endif %}
            </span>
        </div>
        <div class="pf-product-excerpt">
            {{ product.metafields.custom.short_description.value | default: product.metafields.custom.short_description | default: 'Real broth for daily hydration' }}
        </div>
        
        <div class="pf-fbt-action">
            {% assign first_selling_plan_id = '' %}
            {% for plan_group in product.selling_plan_groups %}
                {% for plan in plan_group.selling_plans %}
                    {% assign first_selling_plan_id = plan.id %}
                    {% break %}
                {% endfor %}
                {% if first_selling_plan_id != '' %}{% break %}{% endif %}
            {% endfor %}
            <form method="post" action="/cart/add" class="pf-add-to-cart-form">
                <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                {% if first_selling_plan_id != '' %}
                    <input type="hidden" name="data-first-plan" value="{{ first_selling_plan_id }}">
                {% endif %}
                <button type="submit" class="pf-fbt-add-btn purrkins-btn-primary pf-add-to-cart-btn" {% if first_selling_plan_id != '' %}data-first-plan="{{ first_selling_plan_id }}"{% endif %}>
                    Add to Cart
                </button>
            </form>
        </div>
    </div>
</div>

<script>
  if (!window.pfCollectionCardAjaxInitialized) {
    window.pfCollectionCardAjaxInitialized = true;
    document.addEventListener('submit', function(e) {
      if (e.target && e.target.matches('.pf-add-to-cart-form')) {
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        const form = e.target;
        const btn = form.querySelector('.pf-add-to-cart-btn');

        const formData = new FormData(form);
        if (window.purrkinsAddToCart) {
            Promise.resolve(window.purrkinsAddToCart(null, btn, formData)).then(() => {
              if (window.location.pathname.endsWith('/cart') || window.location.pathname.endsWith('/cart/')) {
                window.location.reload();
              }
            });
        } else {
            console.error('purrkinsAddToCart is not defined');
        }
      }
    });
  }
</script>

<style>
