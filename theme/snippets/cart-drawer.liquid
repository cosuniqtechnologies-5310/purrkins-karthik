{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
      style="position: relative; z-index: 10000;"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  {% capture empty_cart_drawer_content %}
    <div
      class="cart-drawer__content cart-drawer__content--empty"
      aria-label="{{ 'accessibility.cart' | t }}"
    >
      <div class="cart-items__wrapper cart-items__wrapper--drawer-empty" data-cart-drawer-empty>
        <p class="cart-drawer__empty-text">Your cart is currently empty.</p>
      </div>
    </div>
  {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    data-skip-node-update
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
      style="border-top-left-radius: 24px; border-bottom-left-radius: 24px; overflow: hidden; z-index: 99999; box-shadow: -8px 0 40px rgba(0,0,0,0.18);"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner{% if cart.empty? %} cart-drawer--empty{% endif %}"
          data-hydration-key="cart-drawer-inner"
        >
          {%- comment -%} Always show the full cart header with title and item count {%- endcomment -%}
          {% capture cart_badge_html %}
            <span
              class="theme-drawer__badge{% if cart.item_count == 0 %} visually-hidden{% endif %}"
              aria-hidden="true"
              {% if cart.item_count <= 99 %}
                data-maintain-ratio
              {% endif %}
            >
              {{- cart.item_count -}}
            </span>
            {% if cart.item_count > 0 %}
              <span class="visually-hidden">
                {{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}
              </span>
            {% endif %}
          {% endcapture %}
          {% assign cart_drawer_title = 'content.cart_title' | t %}
          {% render 'theme-drawer-header',
            title: cart_drawer_title,
            drawer_id: 'cart-drawer',
            heading_id: 'cart-drawer-heading',
            title_append: cart_badge_html
          %}

          {%- comment -%} Always show the tab toggle, even when cart is empty {%- endcomment -%}
          {% assign has_subscription = false %}
          {% for item in cart.items %}
            {% if item.selling_plan_allocation %}
              {% assign has_subscription = true %}
            {% endif %}
          {% endfor %}
          {%- unless cart.empty? -%}
            <div class="cart-drawer-tabs">
              <button class="cart-drawer-tab {% if has_subscription == false %}active{% endif %}" data-tab="one-time">
                One-time
              </button>
              <button class="cart-drawer-tab {% if has_subscription %}active{% endif %}" data-tab="subscribe">
                Subscribe · save 15%
              </button>
            </div>
          {%- endunless -%}

          {% capture cart_items_children %}
            {%- if cart.empty? -%}
              {{ empty_cart_drawer_content }}
            {%- else -%}
              <scroll-hint
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
              >
                <scroll-hint class="cart-drawer__items">
                  {% render 'cart-products', context: 'drawer' %}
                </scroll-hint>

                <div class="cart-drawer__summary">
                  {% render 'cart-summary', section_id: 'cart-drawer-section' %}
                </div>
              </scroll-hint>
            {%- endif -%}
          {% endcapture %}
          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

{% stylesheet %}
  cart-drawer-component {
    --cart-drawer-padding: var(--theme-drawer-padding);
    --font-paragraph--line-height: 1;
    display: contents;
    font-family: var(--font-paragraph--family);
  }

  .theme-drawer__dialog {
    font-family: var(--font-paragraph--family);
  }

  .theme-drawer__title {
    font-family: var(--purrkins-heading-font);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .cart-drawer-tab {
    font-family: var(--font-paragraph--family) !important;
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__inner > .cart-items-component {
    flex: 1;
    min-height: 0;
    height: auto;
  }

  .cart-drawer__content {
    display: flex;
    flex-direction: column;
    padding: 0;
    background-color: var(--color-background);
    flex-grow: 1;
    overflow-y: auto;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    padding-inline: var(--cart-drawer-padding);
    overflow-y: auto;
  }

  .cart-drawer__items .cart-items__table-row {
    padding-bottom: var(--gap-xl);
    border-bottom: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    margin-bottom: var(--gap-xl);
  }

  .cart-drawer__items .cart-items__table-row:has(+ .cart-items__nested-line) {
    border-bottom: none;
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__table-row:last-child {
    border-bottom: none;
    padding-block-end: 0;
    margin-block-end: 0;
  }

  .cart-drawer__close-button--empty {
    margin-inline-start: auto;
  }

  .cart-drawer__summary {
    --cart-drawer-summary-padding: var(--padding-lg);

    position: sticky;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xl);
    padding: var(--cart-drawer-summary-padding);
    margin-top: auto;
    background-color: var(--color-background);
    /* stylelint-disable-next-line color-named */
    mask-image: linear-gradient(to bottom, transparent, black var(--cart-drawer-summary-padding));

    @media screen and (min-width: 750px) {
      --cart-drawer-summary-padding: var(--padding-2xl);
    }
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__summary {
    position: static;
    mask-image: none;
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__items {
    overflow: unset;
  }

  .cart-actions summary {
    padding-inline: 0;
    padding-block: var(--padding-sm);
    line-height: 1.2;
    min-height: var(--minimum-touch-target);
  }

  .cart-drawer__summary .cart__summary-totals:not(:has(.cart__subtotal-container:empty)) {
    border-block-start: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--padding-2xl);
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-drawer--empty .cart-drawer__content {
    text-align: left;
    align-items: flex-start;
    justify-content: flex-start;
    min-height: auto;
  }

  .cart-drawer--empty .cart-drawer__items {
    padding-inline: 0;
  }

  .cart-drawer__content--empty {
    text-align: left;
    align-items: flex-start;
    justify-content: flex-start;
  }

  .cart-drawer__empty-text {
    font-family: var(--font-paragraph--family);
    font-size: 13px;
    font-weight: 400;
    color: rgb(var(--color-foreground-rgb) / 0.55);
    margin: 0;
    padding: 16px var(--cart-drawer-padding, 24px);
    letter-spacing: 0;
    line-height: 1.5;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__items {
    padding-inline: 0;
  }

  /* Cart drawer: fixed position, above header, left box-shadow */
  #cart-drawer .theme-drawer__dialog {
    position: fixed !important;
    z-index: 99999 !important;
    border-top-left-radius: 24px;
    border-bottom-left-radius: 24px;
    overflow: hidden;
    box-shadow: -8px 0 40px rgba(0, 0, 0, 0.18), -2px 0 12px rgba(0, 0, 0, 0.1);
  }

  /* Subscription tab toggle */
  .cart-drawer-tabs {
    display: flex;
    background: #f0f0f0;
    border-radius: 999px;
    margin: 0 var(--cart-drawer-padding, 24px) 12px;
    padding: 3px;
    gap: 2px;
  }

  .cart-drawer-tab {
    flex: 1;
    border-radius: 999px;
    padding: 8px 12px;
    border: none;
    background: transparent;
    color: #555;
    font-weight: 400;
    font-size: 13px;
    cursor: pointer;
    transition: all 0.2s ease;
    font-family: inherit;
    white-space: nowrap;
  }

  .cart-drawer-tab.active {
    background: #fff;
    color: #000;
    font-weight: 700;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.12);
  }

  /* Filter items based on active tab */
  body[data-cart-tab='one-time'] .cart-items__table-row[data-subscription-type='subscribe'] {
    display: none !important;
  }

  body[data-cart-tab='subscribe'] .cart-items__table-row[data-subscription-type='one-time'] {
    display: none !important;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    html:active-view-transition-type(empty-cart-drawer) {
      .theme-drawer__close-button {
        view-transition-name: cart-drawer-close-button;
      }
    }
  }

  :active-view-transition {
    .cart-drawer__header,
    .cart-drawer__content {
      background: transparent;
    }
  }
{% endstylesheet %}
