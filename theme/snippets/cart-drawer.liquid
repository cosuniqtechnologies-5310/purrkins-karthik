{% doc %}
  Renders reusable cart drawer markup for both initial page loads and Section Rendering API responses.

  @param {boolean} [render_wrapper] - When true, wraps the drawer in the section wrapper that the Section Rendering API adds automatically.
{% enddoc %}

{%- liquid
  assign render_wrapper = render_wrapper | default: true, allow_false: true
-%}

{%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
  {% if render_wrapper %}
    <div
      id="shopify-section-cart-drawer-section"
      class="shopify-section"
      style="position: relative; z-index: 9999999;"
    >
  {% endif %}

  <script
    type="module"
    src="{{ 'cart-drawer.js' | asset_url }}"
    fetchpriority="low"
  ></script>
  <script
    src="{{ 'component-cart-items.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
  <script
    src="{{ 'component-cart-quantity-selector.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
  {% capture empty_cart_drawer_content %}
    <div
      class="cart-drawer__content cart-drawer__content--empty"
      aria-label="{{ 'accessibility.cart' | t }}"
      style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; min-height: 400px; text-align: center;"
    >
      <div class="cart-items__wrapper cart-items__wrapper--drawer-empty" data-cart-drawer-empty>
        <p class="cart-drawer__empty-text" style="color: #666; font-size: 14px; background: transparent !important; margin: 0;">Your cart is currently empty.</p>
      </div>
    </div>
  {% endcapture %}

  <theme-drawer
    id="cart-drawer"
    data-skip-node-update
    no-persist
  >
    <dialog
      ref="panel"
      class="theme-drawer__dialog color-custom-drawer"
      aria-labelledby="cart-drawer-heading"
      cart-summary-sticky="true"
      style="border-top-left-radius: 24px; border-bottom-left-radius: 24px; overflow: hidden; z-index: 9999999 !important; box-shadow: -8px 0 40px rgba(0,0,0,0.18);"
    >
      <cart-drawer-component
        {% if settings.auto_open_cart_drawer and template.name != 'cart' %}
          auto-open
        {% endif %}
      >
        <template id="empty-cart-template">
          {{ empty_cart_drawer_content }}
        </template>

        <div
          class="cart-drawer__inner{% if cart.empty? %} cart-drawer--empty{% endif %}"
          data-hydration-key="cart-drawer-inner"
        >
          {%- comment -%} Always show the full cart header with title and item count {%- endcomment -%}
          {% capture cart_badge_html %}
            {%- unless cart.empty? -%}
              <span
                class="cart-drawer__item-count"
                aria-hidden="true"
              >
                ({{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %})
              </span>
              <span class="visually-hidden">
                {{ 'accessibility.cart_count' | t }}: {{ cart.item_count }}
              </span>
            {%- endunless -%}
          {% endcapture %}
          {% assign cart_drawer_title = 'content.cart_title' | t %}
          {% render 'theme-drawer-header',
            title: cart_drawer_title,
            drawer_id: 'cart-drawer',
            heading_id: 'cart-drawer-heading',
            title_append: cart_badge_html
          %}

          {%- comment -%} Always show the tab toggle, even when cart is empty {%- endcomment -%}
          {% assign has_subscription = false %}
          {% for item in cart.items %}
            {% if item.selling_plan_allocation %}
              {% assign has_subscription = true %}
            {% elsif item.properties._subscription == 'true'
              or item.properties.subscription == 'true'
              or item.properties.Frequency != blank
            %}
              {% assign has_subscription = true %}
            {% endif %}
          {% endfor %}
          {% if cart.attributes._subscription == 'true' %}
            {% assign has_subscription = true %}
          {% endif %}
          <div class="cart-drawer-tabs">
            <button class="cart-drawer-tab {% if has_subscription == false %}active{% endif %}" data-tab="one-time">
              One-time
            </button>
            <button class="cart-drawer-tab {% if has_subscription %}active{% endif %}" data-tab="subscribe">
              Subscribe · save 15%
            </button>
          </div>

          {% capture cart_items_children %}
            {%- if cart.empty? -%}
              {{ empty_cart_drawer_content }}
            {%- else -%}
              <scroll-hint
                class="cart-drawer__content"
                aria-label="{{ 'accessibility.cart' | t }}"
              >
                <scroll-hint class="cart-drawer__items">
                  {% render 'cart-products', context: 'drawer' %}
                </scroll-hint>

                <div class="cart-drawer__summary">
                  {% render 'cart-summary', section_id: 'cart-drawer-section' %}
                </div>
              </scroll-hint>
            {%- endif -%}
          {% endcapture %}
          {% render 'cart-items-component',
            children: cart_items_children,
            is_drawer: true,
            section_id: 'cart-drawer-section'
          %}
        </div>
      </cart-drawer-component>
    </dialog>
  </theme-drawer>

  {% if render_wrapper %}
    </div>
  {% endif %}
{%- endif -%}

{% stylesheet %}
  cart-drawer-component {
    --cart-drawer-padding: var(--theme-drawer-padding);
    --font-paragraph--line-height: 1;
    display: contents;
    font-family: var(--font-paragraph--family);
  }

  /* Match custom cart drawer header */
  #cart-drawer .theme-drawer__header {
    border-bottom: none;
    padding-bottom: 0;
  }
  #cart-drawer .theme-drawer__title {
    color: var(--text-primary, #16130f);
    font-family: var(--purrkins-heading-font);
    font-size: 36px;
    font-weight: 700;
    line-height: 48px;
    letter-spacing: -0.4px;
    gap: 20px;
  }
  #cart-drawer .theme-drawer__close-button {
    transition: background 0.2s;
    position: absolute;
    top: 20px;
    right: 20px;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    border-radius: 999px;
    background: var(--primary-yellow-200, #f1eabc);
    width: 34px;
    height: 34px;
    justify-content: center;
    align-items: center;
    color: var(--primary-yellow-700, #a08c0a);
    font-family: var(--purrkins-heading-font);
    font-size: 16px;
    font-weight: 700;
  }

  #cart-drawer .theme-drawer__close-button .svg-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
  }

  .theme-drawer__dialog {
    font-family: var(--font-paragraph--family);
  }

  .theme-drawer__title {
    font-family: var(--purrkins-heading-font);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .cart-drawer-tab {
    font-family: var(--font-paragraph--family) !important;
  }

  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .cart-drawer__inner > .cart-items-component {
    flex: 1;
    min-height: 0;
    height: auto;
  }

  .cart-drawer__content {
    display: flex;
    flex-direction: column;
    padding: 0;
    background-color: var(--color-background);
    flex-grow: 1;
    overflow-y: auto;
  }

  .cart-drawer__items {
    display: flex;
    flex-direction: column;
    padding-inline: var(--cart-drawer-padding);
    overflow-y: auto;
  }

  .cart-drawer__items .cart-items__table-row {
    padding-bottom: var(--gap-xl);
    border-bottom: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    margin-bottom: var(--gap-xl);
    grid-template-columns: 90px 1fr 1fr !important;
  }

  .cart-drawer__items .cart-items__table-row:has(+ .cart-items__nested-line) {
    border-bottom: none;
    margin-bottom: 0;
  }

  .cart-drawer__items .cart-items__table-row:last-child {
    border-bottom: none;
    padding-block-end: 0;
    margin-block-end: 0;
  }

  .cart-drawer__close-button--empty {
    margin-inline-start: auto;
  }

  .cart-drawer__summary {
    --cart-drawer-summary-padding: var(--padding-lg);

    position: sticky;
    bottom: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--gap-xl);
    padding: var(--cart-drawer-summary-padding);
    margin-top: auto;
    background-color: var(--color-background);
    /* stylelint-disable-next-line color-named */
    mask-image: linear-gradient(to bottom, transparent, black var(--cart-drawer-summary-padding));

    @media screen and (min-width: 750px) {
      --cart-drawer-summary-padding: var(--padding-2xl);
    }
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__summary {
    position: static;
    mask-image: none;
  }

  .theme-drawer__dialog[cart-summary-sticky='false'] .cart-drawer__items {
    overflow: unset;
  }

  .cart-actions summary {
    padding-inline: 0;
    padding-block: var(--padding-sm);
    line-height: 1.2;
    min-height: var(--minimum-touch-target);
  }

  .cart-drawer__summary .cart__summary-totals:not(:has(.cart__subtotal-container:empty)) {
    border-block-start: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--padding-2xl);
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-drawer--empty .cart-drawer__content {
    text-align: left;
    align-items: flex-start;
    justify-content: flex-start;
    min-height: auto;
  }

  .cart-drawer--empty .cart-drawer__items {
    padding-inline: 0;
  }

  .cart-drawer__content--empty {
    text-align: left;
    align-items: flex-start;
    justify-content: flex-start;
  }

  .cart-drawer__empty-text {
    font-family: var(--font-paragraph--family);
    font-size: 13px;
    font-weight: 400;
    color: rgb(var(--color-foreground-rgb) / 0.55);
    margin: 0;
    padding: 16px var(--cart-drawer-padding, 24px);
    letter-spacing: 0;
    line-height: 1.5;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__content {
    text-align: center;
    align-items: center;
    justify-content: center;
  }

  cart-drawer-component:not(:has(.cart-form)) .cart-drawer__items {
    padding-inline: 0;
  }

  /* Cart drawer: fixed position, above header, left box-shadow */
  #cart-drawer .theme-drawer__dialog {
    position: fixed !important;
    z-index: 99999 !important;
    border-top-left-radius: 24px;
    border-bottom-left-radius: 24px;
    overflow: hidden;
    box-shadow: -8px 0 40px rgba(0, 0, 0, 0.18), -2px 0 12px rgba(0, 0, 0, 0.1);
  }

  /* Subscription tab toggle */
  .cart-drawer-tabs {
    display: flex;
    margin: 16px var(--cart-drawer-padding, 24px) 36px;
    gap: 2px;
    border-radius: 999px;
    background: var(--brand-slate-50, #f0f0f1);
    height: 56px;
    padding: 4px;
  }

  .cart-drawer-tab {
    flex: 1;
    border-radius: 999px;
    padding: 8px 12px;
    border: none;
    background: transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    color: var(--color-text-secondary, #595961);
    font-size: 14px;
    font-weight: 500;
    line-height: 24px;
  }

  .cart-drawer-tab.active {
    border-radius: 999px;
    background: var(--color-background, #fff);
    padding: 13px 0;
    color: var(--color-text-primary, #121217);
    font-size: 14px;
    font-style: normal;
    font-weight: 600;
    line-height: 1.5;
  }

  /* Mode-based display toggle: never hide items! */
  body[data-cart-tab='subscribe'] .cart-item-regular-price {
    display: none !important;
  }
  body[data-cart-tab='subscribe'] .cart-item-subscription-price {
    display: inline-flex !important;
  }
  body[data-cart-tab='subscribe'] .cart-drawer-subscription-info {
    display: flex !important;
  }
  body[data-cart-tab='subscribe'] .checkout-regular-price {
    display: none !important;
  }
  body[data-cart-tab='subscribe'] .checkout-sub-price {
    display: inline !important;
  }

  body[data-cart-tab='one-time'] .cart-item-subscription-price {
    display: none !important;
  }
  body[data-cart-tab='one-time'] .cart-item-regular-price {
    display: inline-flex !important;
  }
  body[data-cart-tab='one-time'] .cart-drawer-subscription-info {
    display: none !important;
  }
  body[data-cart-tab='one-time'] .checkout-sub-price {
    display: none !important;
  }
  body[data-cart-tab='one-time'] .checkout-regular-price {
    display: inline !important;
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    html:active-view-transition-type(empty-cart-drawer) {
      .theme-drawer__close-button {
        view-transition-name: cart-drawer-close-button;
      }
    }
  }

  :active-view-transition {
    .cart-drawer__header,
    .cart-drawer__content {
      background: transparent;
    }
  }

  span.cart-drawer__item-count {
    color: var(--text-primary, #16130f);
    font-size: 20px;
    font-weight: 600;
    line-height: 32px;
  }
  .cart-drawer-quantity-row {
    display: flex;
    gap: 10px;
    margin-top: 8px;
    flex-direction: column;
    align-items: flex-start !important;
  }
  .cart-items__title {
    display: block;
    margin-block-start: 0;
    min-width: 0;
    overflow-wrap: break-word;
    color: var(--text-primary, #16130f);
    font-size: 22px !important;
    font-weight: 600;
    line-height: 1.6;
  }
  .cart-drawer-remove-btn {
    background: none;
    border: none;
    padding: 0;
    text-decoration: underline;
    cursor: pointer;
    color: var(--brand-slate-400, #8e9298);
    font-size: 14px;
    font-weight: 400;
    line-height: 22px;
    text-decoration-line: underline;
    text-decoration-style: solid;
    text-decoration-skip-ink: auto;
    text-decoration-thickness: auto;
    text-underline-offset: auto;
    text-underline-position: from-font;
  }
  text-component {
    color: var(--text-primary, #16130f) !important;
    font-size: 20px !important;
    font-weight: 600;
    line-height: 1.6;
  }
  .cart-items__variants-wrapper,
  .cart-items__unit-price-wrapper {
    font-size: 14px !important;
    font-weight: 400 !important;
    line-height: 1.5;
  }
  .cart-items__table-row--full-width-variants .cart-items__price {
    width: 100% !important;
  }
  .cart-drawer-quantity-selector .quantity-selector {
    --quantity-selector-width: 90px;
    border-radius: 999px;
    border: 2px solid var(--brand-slate-900, #21252a);
    justify-content: center;
    align-items: center;
    color: var(--color-text-primary, #121217) !important;
    font-family: var(--purrkins-heading-font);
    font-size: 18px !important;
    font-weight: 700 !important;
    line-height: 1.4 !important;
    letter-spacing: 0.18px;
  }
  .cart-security-badge__title {
    color: var(--text-primary, #16130f);
    text-align: center;
    font-size: 14px !important;
  }
  .cart-security-badge__subtitle {
    color: var(--text-primary, #16130f) !important;
    text-align: center;
    font-size: 12px !important;
    font-weight: 600;
  }
  .cart-security-badges {
    margin-bottom: 20px !important;
  }
  .cart-drawer-quantity-selector .quantity-selector input[type='number'] {
    font-size: 16px !important;
  }
  .cart__ctas .cart__checkout-button,
  .cart__ctas .cart__checkout-button text-component.cart__checkout-price {
    font-family: var(--purrkins-heading-font) !important;
    font-size: 16px !important;
    font-weight: 700 !important;
    line-height: 1.4 !important;
    letter-spacing: 0.18px !important;
  }
{% endstylesheet %}
