{%- doc -%}
  Renders the cart summary totals.

  @param {string} [accelerated_checkout_buttons_layout] - { 'vertical' } Forced layout of the additional checkout buttons, instead of relying on platform's layout.
  @param {string} [section_id] - The section ID for cart discount component.
{%- enddoc -%}

{% render 'text-component-shimmer-styles' %}
{% render 'cart-typography-styles' %}

<div class="cart-totals">
  {% # We need to keep this node in place to allow morphing to work properly # %}
  <div class="cart-totals__original-container cart-primary-typography">
    {%- if cart.cart_level_discount_applications.size > 0 -%}
      <span class="cart-totals__item cart-totals__original">
        <span class="cart-totals__original-label">{{ 'content.cart_subtotal' | t }}</span>
        <span
          class="cart-totals__original-value cart-secondary-typography"
          data-testid="cart-subtotal-value"
        >
          {{- cart.items_subtotal_price | money -}}
        </span>
      </span>
      <ul
        class="cart-discounts"
        role="list"
        aria-label="{{ 'content.discounts' | t }}"
      >
        {%- for discount in cart.cart_level_discount_applications -%}
          <li class="cart-discounts__item">
            <span class="cart-discounts__label">
              {{- 'icon-discount.svg' | inline_asset_content -}}
              {{ discount.title | escape }}
            </span>
            <span class="cart-discounts__value cart-secondary-typography"
              >-{{ discount.total_allocated_amount | money -}}
            </span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  {% if settings.show_cart_note or settings.show_add_discount_code %}
    <div class="cart-actions">
      {% if settings.show_cart_note %}
        <script
          type="module"
          src="{{ 'cart-note.js' | asset_url }}"
        ></script>

        <cart-note style="display: flex;">
          {% capture cart_note_accordion_children %}
            <details
              {% if settings.cart_note_open_by_default %}
                open
              {% endif %}
            >
              <summary class="cart-note__summary">
                <span class="cart-note__label cart-primary-typography">
                  {{ 'content.seller_note' | t }}
                </span>

                <span class="cart-totals__icon">
                  {{- 'icon-plus.svg' | inline_asset_content -}}
                </span>
              </summary>

              <div class="details-content cart-note__inner">
                <label
                  for="cart-note"
                  class="visually-hidden"
                >
                  {{- 'content.seller_note' | t -}}
                </label>
                <textarea
                  form="cart-form"
                  on:input="/updateCartNote"
                  id="cart-note"
                  class="cart-note__instructions"
                  name="note"
                  data-skip-node-update
                >{{ cart.note }}</textarea>
              </div>
            </details>
          {% endcapture %}
          {% render 'accordion-custom-component',
            children: cart_note_accordion_children,
            class: 'cart-note',
            open_by_default_on_desktop: settings.cart_note_open_by_default,
            open_by_default_on_mobile: settings.cart_note_open_by_default
          %}
        </cart-note>
      {% endif %}
      {% if settings.show_cart_note and settings.show_add_discount_code %}
        <div class="cart-actions__divider"></div>
      {% endif %}
      {% if settings.show_add_discount_code %}
        {% liquid
          assign discount_codes = cart.cart_level_discount_applications | where: 'type', 'discount_code' | map: 'title'
          for item in cart.items
            for allocation in item.line_level_discount_allocations
              if allocation.discount_application.type == 'discount_code'
                assign discount_codes = item.line_level_discount_allocations | slice: forloop.index0 | map: 'discount_application' | map: 'title' | concat: discount_codes
              endif
            endfor
          endfor

          assign discount_codes = discount_codes | uniq

          # Evaluate the boolean expression for the disclosure state
          if discount_codes.size == 0
            assign disclosure_expanded = false
          else
            assign disclosure_expanded = true
          endif
        %}

        {% capture cart_discount_accordion_children %}
          <details
            {% if disclosure_expanded %}
              open
            {% endif %}
          >
            <summary class="cart-discount__summary">
              <span class="cart-discount__label cart-primary-typography">{{ 'content.discount' | t }}</span>

              <span class="cart-totals__icon">
                {{- 'icon-plus.svg' | inline_asset_content -}}
              </span>
            </summary>

            <div class="details-content">
              <div id="cart-discount-disclosure">
                <cart-discount-component
                  {% if section_id != blank %}
                    data-section-id="{{ section_id }}"
                  {% endif %}
                >
                  <div class="cart-discount__content">
                    <form
                      on:submit="/applyDiscount"
                      onsubmit="return false;"
                      class="cart-discount__form"
                    >
                      <label
                        for="cart-discount"
                        class="visually-hidden"
                      >
                        {{- 'accessibility.discount' | t -}}
                      </label>
                      <input
                        id="cart-discount"
                        class="cart-discount__input"
                        type="text"
                        name="discount"
                        size="8"
                        placeholder="{{ 'content.discount_code' | t }}"
                        required
                        data-skip-node-update
                      >
                      <button
                        type="submit"
                        class="button cart-discount__button"
                      >
                        {{ 'actions.apply' | t }}
                      </button>
                    </form>
                  </div>
                  <div
                    class="cart-discount__error hidden"
                    role="alert"
                    ref="cartDiscountError"
                  >
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    <small
                      class="cart-discount__error-text cart-primary-typography hidden"
                      ref="cartDiscountErrorDiscountCode"
                    >
                      {{ 'content.discount_code_error' | t: code: 'test' }}
                    </small>
                    <small
                      class="cart-discount__error-text cart-primary-typography hidden"
                      ref="cartDiscountErrorShipping"
                    >
                      {{ 'content.shipping_discount_error' | t }}
                    </small>
                  </div>
                  <ul class="cart-discount__codes">
                    {% for discount_code in discount_codes %}
                      <li
                        class="cart-discount__pill"
                        data-discount-code="{{ discount_code }}"
                        aria-label="{{ 'accessibility.discount_applied' | t: code: discount_code }}"
                      >
                        <p class="cart-discount__pill-code">
                          {{ discount_code }}
                        </p>
                        <button
                          type="button"
                          on:click="/removeDiscount"
                          class="cart-discount__pill-remove svg-wrapper svg-wrapper--smaller button-unstyled"
                          aria-label="{{ 'actions.remove_discount' | t: code: discount_code }}"
                        >
                          {{- 'icon-filters-close.svg' | inline_asset_content -}}
                        </button>
                      </li>
                    {% endfor %}
                  </ul>
                </cart-discount-component>
              </div>
            </div>
          </details>
        {% endcapture %}
        {% render 'accordion-custom-component', children: cart_discount_accordion_children, class: 'cart-discount' %}
      {% endif %}
    </div>
  {% endif %}

  {%- liquid
    if settings.currency_code_enabled_cart_total
      assign total_price = cart.total_price | money_with_currency
    else
      assign total_price = cart.total_price | money
    endif
  -%}

  <div class="cart-totals__container{% if settings.show_installments %} cart-totals__container--has-installments{% endif %}">
    <span
      class="cart-totals__item cart-totals__total"
      role="status"
    >
      <span class="cart-totals__total-label cart-primary-typography">{{ 'content.cart_estimated_total' | t }}</span>
      <text-component
        ref="cartTotal"
        value="{{ total_price | strip_html }}"
        class="cart-totals__total-value cart-secondary-typography"
        {% comment %} Used by payment_terms web component {% endcomment %}
        data-testid="cart-total-value"
        data-cart-subtotal
      >
        {{ total_price }}
      </text-component>
    </span>
    {% if settings.show_installments %}
      <span class="cart-totals__item cart-totals__installments">
        {% form 'cart', cart %}
          {{ form | payment_terms }}
        {% endform %}
      </span>
    {% endif %}
    <div class="cart-totals__item cart-totals__tax-note cart-primary-typography">
      {% render 'tax-info', has_discounts_enabled: settings.show_add_discount_code %}
    </div>
  </div>
</div>

{% assign has_sub_item = false %}
{% assign sub_item = nil %}
{% assign total_sub_saving = 0 %}

{% assign default_discount_pct = 15 %}
{% if cart.attributes._subscription_discount != blank %}
  {% assign parsed_attr_pct = cart.attributes._subscription_discount | remove: '%' | times: 1 %}
  {% if parsed_attr_pct > 0 %}
    {% assign default_discount_pct = parsed_attr_pct %}
  {% endif %}
{% endif %}

{% for item in cart.items %}
  {% assign is_curr_sub = false %}
  {% if item.selling_plan_allocation %}
    {% assign is_curr_sub = true %}
  {% elsif item.properties._subscription == 'true' or item.properties.subscription == 'true' or item.properties.Frequency != blank %}
    {% assign is_curr_sub = true %}
  {% elsif cart.attributes._subscription == 'true' %}
    {% assign is_curr_sub = true %}
  {% endif %}

  {% if is_curr_sub %}
    {% assign has_sub_item = true %}
    {% if sub_item == nil %}
      {% assign sub_item = item %}
    {% endif %}

    {% assign item_discount_pct = default_discount_pct %}
    {% if item.properties._subscription_discount != blank %}
      {% assign parsed_item_pct = item.properties._subscription_discount | remove: '%' | times: 1 %}
      {% if parsed_item_pct > 0 %}
        {% assign item_discount_pct = parsed_item_pct %}
      {% endif %}
    {% endif %}

    {% assign item_saving = item.final_line_price | times: item_discount_pct | divided_by: 100 %}
    {% assign total_sub_saving = total_sub_saving | plus: item_saving %}
  {% endif %}
{% endfor %}

{% if cart.attributes._subscription == 'true' %}
  {% assign has_sub_item = true %}
{% endif %}

{% assign fallback_sub_saving = cart.total_price | times: default_discount_pct | divided_by: 100 %}
{% if total_sub_saving == 0 %}
  {% assign display_sub_saving = fallback_sub_saving %}
{% else %}
  {% assign display_sub_saving = total_sub_saving %}
{% endif %}
{% assign sub_checkout_total = cart.total_price | minus: display_sub_saving %}

{% if section_id == 'cart-drawer-section' %}
  <div class="cart-drawer-subscription-info" style="margin-bottom: 16px; width: 100%; {% unless has_sub_item %}display: none;{% endunless %}">
    <div class="cart-drawer-subscription-savings" data-saving="{{ display_sub_saving }}">
      You're saving <span class="sub-savings-amount">{{ display_sub_saving | money }}</span> on this order
    </div>

    <div class="cart-drawer-subscription-plan" id="cart-drawer-subscription-plan-card">
      <span class="plan-label">Delivers every</span>
      <div class="plan-select-wrapper">
        <select
          class="plan-select"
          id="cart-drawer-delivery-days-select"
          aria-label="Delivery frequency"
          onchange="if (window.purrkinsChangeDeliveryFrequency) { window.purrkinsChangeDeliveryFrequency(this.value, this); }"
        >
          {% assign selected_days = cart.attributes._delivery_frequency | default: '30 days' %}
          <option value="15 days" {% if selected_days == '15 days' %}selected{% endif %}>15 days</option>
          <option value="30 days" {% if selected_days == '30 days' %}selected{% endif %}>30 days</option>
          <option value="45 days" {% if selected_days == '45 days' %}selected{% endif %}>45 days</option>
          <option value="60 days" {% if selected_days == '60 days' %}selected{% endif %}>60 days</option>
        </select>
        <svg class="plan-select-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </div>
    </div>

    <div class="cart-drawer-subscription-note">Pause, skip or cancel anytime · Free delivery on every order</div>
  </div>
{% endif %}

<div class="cart__ctas">
  <div class="cart-security-badges">
    <div class="cart-security-badge">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline>
      </svg>
      <div>
        <div class="cart-security-badge__title">SECURE</div>
        <div class="cart-security-badge__subtitle">SSL ENCRYPTED</div>
      </div>
    </div>
    <div class="cart-security-badge">
      <svg
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      <div>
        <div class="cart-security-badge__title">SECURE</div>
        <div class="cart-security-badge__subtitle">Payment</div>
      </div>
    </div>
  </div>

  <button
    type="submit"
    id="checkout"
    class="cart__checkout-button button"
    name="checkout"
    {% if cart == empty %}
      disabled
    {% endif %}
    form="cart-form"
  >
    <span class="button-text">
      <text-component
        ref="cartTotal"
        value="{{ cart.total_price | money | strip_html }}"
        class="cart__checkout-price"
        data-cart-subtotal
        data-regular-total="{{ cart.total_price }}"
        data-sub-total="{{ sub_checkout_total }}"
      >
        <span class="checkout-regular-price" {% if has_sub_item %}style="display: none;"{% endif %}>{{- cart.total_price | money -}}</span>
        <span class="checkout-sub-price" {% unless has_sub_item %}style="display: none;"{% endunless %}>{{- sub_checkout_total | money -}}</span>
      </text-component>
      <span class="cart__checkout-separator">|</span>
      <span>{{ 'content.checkout' | t }}</span>
    </span>
  </button>

  <p class="cart__shipping-note">Shipping &amp; taxes calculated at checkout</p>

  {% if additional_checkout_buttons and settings.show_accelerated_checkout_buttons %}
    <div
      class="
        additional-checkout-buttons
        {% if accelerated_checkout_buttons_layout == 'vertical' %}additional-checkout-buttons--vertical{% endif %}
      "
    >
      {{ content_for_additional_checkout_buttons }}
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .cart-actions {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-block: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block: 0;
    margin-block-start: var(--margin-3xs);
  }

  .cart-actions__divider {
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
  }

  .cart-totals:not(:has(.cart-actions)) {
    margin-block-start: var(--margin-3xs);
    border-block-start: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    padding-block-start: var(--margin-xl);
  }

  .cart-totals__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-totals__tax-note {
    color: var(--color-foreground-subdued);
  }

  .cart-totals__tax-note a {
    color: var(--color-foreground-subdued);
    text-decoration-line: underline;
    text-decoration-color: currentColor;

    &:hover {
      text-decoration-color: transparent;
    }
  }

  .cart-totals__tax-note small {
    font-size: var(--font-size--2xs);
  }

  .cart-discounts {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .cart-discounts__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-discounts__label {
    display: flex;
    align-items: center;
    gap: var(--gap-2xs);
  }

  .cart-discounts__label svg {
    width: var(--icon-size-sm);
    height: var(--icon-size-sm);
    display: inline-block;
  }

  .cart-totals__original-container,
  .cart-totals__container {
    display: flex;
    flex-direction: column;
  }

  .cart-totals__container {
    row-gap: var(--gap-2xs);

    &.cart-totals__container--has-installments {
      row-gap: var(--gap-xs);
    }
  }

  .cart-totals__original-container:empty {
    display: none;
  }

  .cart-totals {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xl);
    width: 100%;
    border-block-start: none;

    &:has(> :first-child:not(.cart-totals__original-container, .cart-totals__container)) {
      padding-block-start: 0;
      border-block-start: none;
    }

    @media screen and (min-width: 750px) {
      padding-block-start: 0;
    }
  }

  .cart-totals__original-container,
  .cart-totals__original-container * {
    font-size: var(--cart-font-size--sm);
  }

  .cart-totals__total {
    align-items: baseline;
    font-weight: var(--font-weight-bold);
  }

  .cart-totals__total-label {
    font-size: var(--cart-font-size--sm);
  }

  .cart-totals__total-value {
    font-size: var(--cart-font-size--xl);

    @media screen and (max-width: 749px) {
      font-size: var(--font-size--lg);
    }
  }

  .cart-totals__installments {
    color: var(--color-foreground);
    font-size: var(--font-size--2xs);
  }

  .cart-note {
    width: 100%;
  }

  @starting-style {
    .cart-note[open-by-default-on-desktop][open-by-default-on-mobile] .details-content {
      block-size: auto;
      opacity: 1;
      overflow-y: visible;
    }
  }

  .cart-note__inner {
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  .cart-note__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-note__summary:hover {
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  .cart-note__label {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-2xs);
    font-size: var(--font-size--2xs);
    font-weight: 500;
  }

  .cart-note__instructions {
    color: var(--color-input-text);
    background-color: var(--color-input-background);
    border-width: var(--style-border-width-inputs);
    border-color: var(--color-input-border);
    transition: box-shadow var(--animation-speed) ease;
    box-shadow: var(--input-box-shadow);
    min-height: 5.5rem;
    min-width: 100%;
    max-width: 100%;
    font-size: var(--font-size--sm);
    padding: max(4px, calc(var(--style-border-radius-inputs) * (1 - cos(45deg))));
  }

  .cart-totals__icon {
    height: var(--icon-size-xs);
    width: var(--icon-size-xs);
    margin: 0;
  }

  .cart__ctas {
    width: 100%;
    display: grid;
    gap: var(--checkout-button-gap);
    grid-auto-flow: row;
    grid-template-columns: 1fr;
  }

  .cart__ctas .cart__checkout-button {
    width: 100%;
    height: 52px;
    padding-inline: 24px;
    background-color: #FED000;
    color: #16130f;
    border-radius: 9999px;
    border: none;
    font-weight: 700;
    font-size: 16px;
    cursor: pointer;
    box-shadow: none;
    transition: opacity 0.2s ease, transform 0.1s ease;
  }

  .cart__ctas .cart__checkout-button:hover {
    opacity: 0.95;
  }

  .cart__ctas .cart__checkout-button:active {
    transform: scale(0.99);
  }

  .cart__ctas .cart__checkout-button .button-text {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 16px;
    font-weight: 700;
    color: #16130f;
  }

  .cart__ctas .cart__checkout-button text-component.cart__checkout-price,
  .cart__ctas .cart__checkout-button .checkout-regular-price,
  .cart__ctas .cart__checkout-button .checkout-sub-price {
    font-family: inherit !important;
    font-size: 16px !important;
    font-weight: 700 !important;
    color: #16130f !important;
    line-height: 1 !important;
  }

  .cart__checkout-separator {
    color: #16130f;
    font-weight: 700;
    margin: 0 4px;
    opacity: 0.8;
  }

  .cart__shipping-note {
    text-align: center;
    font-size: 12px;
    color: #70707b;
    margin: 12px 0 0;
    font-weight: 400;
    line-height: 1.3;
  }

  .cart-security-badges {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 32px;
    margin-bottom: 20px;
    width: 100%;
  }

  .cart-security-badge {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cart-security-badge svg {
    flex-shrink: 0;
    color: #16130f;
  }

  .cart-security-badge__title {
    font-size: 11px !important;
    font-weight: 700 !important;
    line-height: 1.2 !important;
    color: #16130f !important;
    letter-spacing: 0.4px !important;
    text-align: left !important;
  }

  .cart-security-badge__subtitle {
    font-size: 9.5px !important;
    color: #595961 !important;
    line-height: 1.2 !important;
    font-weight: 500 !important;
    text-align: left !important;
  }

  /* In drawer: hide discount input, estimated total section — only show checkout button */
  .cart-drawer__summary .cart-totals {
    display: none !important;
  }

  .cart-drawer__summary .cart-actions {
    display: none !important;
  }

  .cart-drawer__summary .cart-note {
    @media screen and (min-width: 750px) {
      margin-block-start: var(--margin-3xs);
    }
  }

  .cart-discount__input {
    background-color: var(--color-input-background);
    color: var(--color-input-text);
    border-width: var(--style-border-width-inputs);
    border-color: var(--color-input-border);
    border-style: solid;
    border-radius: var(--style-border-radius-inputs);
    padding: var(--padding-sm) var(--padding-md);
    height: 100%;
    flex-grow: 1;
    min-width: 0;
    font-size: var(--font-size--sm);
  }

  .cart-discount__input::placeholder {
    color: rgb(var(--color-input-text-rgb) / var(--opacity-subdued-text));
  }

  .cart-discount__pill-code {
    overflow: hidden;
    max-width: 100px;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin: 0;
  }

  .cart-discount {
    width: 100%;
  }

  .cart-discount__codes {
    display: none;
    gap: var(--padding-xs);
    flex-wrap: wrap;
    list-style: none;
    padding-inline: 0;
    margin: 0;
  }

  .cart-discount__codes:has(.cart-discount__pill) {
    display: flex;
  }

  .cart-discount__button {
    height: 100%;
  }

  .cart-discount__content {
    height: calc(var(--button-size) + var(--padding-2xs) + var(--padding-sm));
  }

  .cart-discount__pill {
    display: flex;
    color: var(--color-foreground);
    gap: var(--padding-xs);
    align-items: center;
    padding: var(--padding-xs) var(--padding-sm);
    border-radius: var(--style-border-radius-pills);
    background-color: var(--color-input-background);
    text-transform: uppercase;
  }

  .cart-discount__form {
    display: flex;
    gap: var(--padding-md);
    align-items: center;
    height: 100%;
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  :is(.cart-discount__pill-remove, .cart-discount__pill-remove:hover) {
    --close-icon-opacity: 0.4;

    color: var(--color-foreground);
    background-color: transparent;
    pointer-events: all;
    cursor: pointer;
    height: 100%;
  }

  .cart-discount__error {
    display: flex;
    align-items: center;
    width: 100%;
    padding-block: var(--padding-2xs) var(--padding-sm);
  }

  .cart-discount__error .svg-wrapper {
    flex-shrink: 0;
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
    margin-inline: var(--margin-3xs) var(--margin-xs);
  }

  .cart-discount__error-text {
    margin-block-start: var(--margin-3xs);
  }

  .cart-discount__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-discount__summary:hover {
    color: rgb(var(--color-rgb, var(--color-foreground-rgb)) / var(--opacity-subdued-text));
  }

  .cart-discount__label {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-2xs);
    font-size: var(--font-size--2xs);
    font-weight: 500;
  }

  @media screen and (min-width: 750px) {
    .cart-summary--extend {
      height: 100%;
    }
  }

  /* Cart Page Specific Summary Polish */
  .cart-page .cart-actions {
    border-block: none;
    margin-bottom: 12px;
  }

  .cart-page .cart-discount__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 0;
    font-family: var(--purrkins-heading-font, inherit);
    font-size: 15px;
    font-weight: 700;
    color: #16130F;
    cursor: pointer;
  }

  .cart-page .cart-discount__input {
    border-radius: 9999px !important;
    border: 1.5px solid #E0E0E3 !important;
    padding: 10px 16px !important;
    font-size: 14px !important;
    background: #ffffff !important;
    height: 42px !important;
    box-sizing: border-box !important;
  }

  .cart-page .cart-discount__input:focus {
    border-color: #FED000 !important;
    outline: none !important;
  }

  .cart-page .cart-discount__button {
    border-radius: 9999px !important;
    background: #16130F !important;
    color: #ffffff !important;
    font-family: var(--purrkins-heading-font, inherit) !important;
    font-weight: 700 !important;
    font-size: 13.5px !important;
    padding: 0 20px !important;
    height: 42px !important;
    border: none !important;
    cursor: pointer !important;
    transition: opacity 0.2s ease !important;
  }

  .cart-page .cart-discount__button:hover {
    opacity: 0.85 !important;
  }

  .cart-page .cart-totals {
    border-block-start: none !important;
  }

  .cart-page .cart-totals__total {
    padding: 14px 0;
    border-top: 1px solid #F0F0F4;
    border-bottom: 1px solid #F0F0F4;
    margin-top: 6px;
  }

  .cart-page .cart-totals__total-label {
    font-family: var(--purrkins-heading-font, inherit);
    font-size: 16px;
    font-weight: 700;
    color: #16130F;
  }

  .cart-page .cart-totals__total-value {
    font-family: var(--purrkins-heading-font, inherit);
    font-size: 22px;
    font-weight: 800;
    color: #16130F;
  }

  .cart-page .cart-security-badges {
    background: #ffffff !important;
    border-radius: 14px;
    padding: 12px 18px;
    margin-bottom: 18px;
    border: none !important;
    display: flex;
    justify-content: space-around;
    box-sizing: border-box;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
  }

  .cart-page .cart__ctas .cart__checkout-button {
    box-shadow: 0 4px 14px rgba(254, 208, 0, 0.35);
    font-family: var(--purrkins-heading-font, inherit);
    font-size: 16px;
    font-weight: 800;
  }

  .cart-page .cart__ctas .cart__checkout-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(254, 208, 0, 0.45);
  }
{% endstylesheet %}
