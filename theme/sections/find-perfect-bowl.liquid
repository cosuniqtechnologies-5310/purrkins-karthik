<div id="find-perfect-bowl-{{ section.id }}" class="find-perfect-bowl-block {{ section.settings.custom_class }}">
     <div class="purrkins-container fpb-container-inner">
        <div class="fpb-left-section">
            {% if section.settings.image != blank %}
                <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.image.alt | escape }}" width="430" height="auto">
            {% endif %}
        </div>
    
        <div class="fpb-right-content">
            <div class="fpb-right-inner">
                {% if section.settings.heading != blank %}
                    <h3 class="fpb-heading purrkins-h3-text purrkins-heading-mb">{{ section.settings.heading }}</h3>
                {% endif %}
                
                {% if section.settings.content != blank %}
                    <div class="fpb-text purrkins-subtext">{{ section.settings.content }}</div>
                {% endif %}
                
                {% if section.settings.button_url != blank and section.settings.button_text != blank %}
                    <a href="{{ section.settings.button_url }}" class="fpb-btn purrkins-btn-secondary">{{ section.settings.button_text }}</a>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<style>
.find-perfect-bowl-block {
    width: 100%;
    background-color: var(--semantic-brand, #FFE330);
}

.fpb-container-inner {
    display: flex;
    align-items: center;
    padding: 0 20px;
    column-gap: 150px;
    height: 511px;
    position: relative;
    max-width: 1200px;
}

.fpb-left-section {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    max-width: 440px;
}

.fpb-left-section img {
    margin-bottom: -40px;
}

.fpb-right-content {
    grid-column: 3 / 4;
    grid-row: 1;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
}

.fpb-right-inner {
    max-width: 500px;
}

.fpb-heading {
    color: var(--color-text-primary, #121217);
    margin-top: 0;
}

.fpb-text {
    color: var(--semantic-text-primary, #121217);
    margin: 0 0 40px;
}

.fpb-text p {
    margin: 0;
}

.fpb-btn {
    background: var(--brand-slate-900, #21252A);
    color: #fff;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    border-radius: 999px;
    display: inline-flex;
    padding: 16px 28px;
    justify-content: center;
    align-items: center;
    font-family: var(--purrkins-heading-font);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.18px;
    border: none;
    cursor: pointer;
}
.fpb-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgb(33 37 42 / 40%);
}

/* Stacking on smaller screens */
@media(max-width: 1024px){
    .fpb-right-inner {
        max-width: 100%;
    }
    .fpb-container-inner{
        column-gap: 60px;
    }
}

@media(max-width: 991px){
    column-gap: 24px;
}

@media (max-width: 767px) {
    .fpb-container-inner{
        display: flex;
        align-items: center;
        padding: 60px 20px;
        column-gap: 180px;
        height: auto;
        position: relative;
        flex-direction: column-reverse;
    }
    .fpb-left-section {
        display: flex;
        justify-content: center;
        align-items: flex-end;
        width: 100%;
        height: 270px;
    }
    .fpb-left-section img {
        width: auto;
        object-fit: contain;
        display: block;
        position: absolute;
        max-width: 310px;
        bottom: 0;
        margin-bottom: 0;
    }
    .fpb-right-inner {
        text-align: center;
        max-width: 490px;
    }
    .fpb-text{
        margin: 0 0 24px;   
    }
    .fpb-btn{    
        font-size: 14px;
        width: 100%;
        max-width: 306px;
    }
}

@media(max-width: 400px){
    .fpb-btn{    
        width: auto;
    }
}
</style>

{% schema %}
{
  "name": "Purrkins Find Perfect",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Left Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the perfect bowl for your cat"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Discover nutrition tailored to your cat's specific needs.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Take the Quiz"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button Link"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class"
    }
  ],
  "presets": [
    {
      "name": "Purrkins Find Perfect Bowl"
    }
  ]
}
{% endschema %}
