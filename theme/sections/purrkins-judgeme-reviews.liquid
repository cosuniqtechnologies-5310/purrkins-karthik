<div class="purrkins-custom-reviews-section purrkins-container purrkins-section-block">
  <div style="clear:both"></div>
  
  <div class="pc-reviews-wrapper" id="purrkins-reviews-widget" data-product-id="{{ product.id }}">
    <div class="pc-reviews-header">
      <div class="pc-reviews-summary">
        <div class="pc-summary-average" id="pc-average-rating">5.0</div>
        <div class="pc-summary-stars" id="pc-summary-stars">
          ★★★★★
        </div>
        <div class="pc-summary-count" id="pc-total-reviews">Based on 0 reviews</div>
      </div>
      <div class="pc-reviews-actions">
        <button class="pc-write-review-btn" id="pc-write-review-btn">Write a Review</button>
      </div>
    </div>

    <!-- Write Review Form (Hidden by default) -->
    <div class="pc-review-form-container" id="pc-review-form-container" style="display: none;">
      <h3>Write a Review</h3>
      <form id="pc-review-form">
        <input type="hidden" name="productId" value="{{ product.id }}">
        
        <div class="pc-form-group">
          <label>Rating</label>
          <select name="rating" required>
            <option value="5">5 Stars</option>
            <option value="4">4 Stars</option>
            <option value="3">3 Stars</option>
            <option value="2">2 Stars</option>
            <option value="1">1 Star</option>
          </select>
        </div>

        <div class="pc-form-group">
          <label>Name</label>
          <input type="text" name="author" placeholder="John Doe" required>
        </div>

        <div class="pc-form-group">
          <label>Email</label>
          <input type="email" name="email" placeholder="john@example.com" required>
        </div>

        <div class="pc-form-group">
          <label>Review Title</label>
          <input type="text" name="title" placeholder="Great product!" required>
        </div>

        <div class="pc-form-group">
          <label>Review</label>
          <textarea name="body" rows="4" placeholder="Share your experience..." required></textarea>
        </div>

        <button type="submit" class="pc-submit-btn">Submit Review</button>
        <button type="button" class="pc-cancel-btn" id="pc-cancel-review-btn">Cancel</button>
      </form>
      <div id="pc-form-message" style="display: none; margin-top: 10px;"></div>
    </div>

    <!-- Review List -->
    <div class="pc-review-list" id="pc-review-list">
      <div class="pc-loading">Loading reviews...</div>
    </div>
  </div>
</div>

<style>
  .purrkins-custom-reviews-section {
    padding: 60px 0;
    font-family: var(--purrkins-body-font, sans-serif);
  }
  .pc-reviews-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #e0e0e3;
    padding-bottom: 30px;
    margin-bottom: 30px;
  }
  .pc-summary-average {
    font-size: 48px;
    font-weight: 800;
    font-family: var(--purrkins-heading-font, sans-serif);
    color: #21252a;
    line-height: 1;
  }
  .pc-summary-stars {
    color: #ffe330;
    font-size: 24px;
    margin-top: 5px;
  }
  .pc-summary-count {
    font-size: 14px;
    color: #595961;
    margin-top: 5px;
  }
  .pc-write-review-btn, .pc-submit-btn {
    background-color: #ffe330;
    color: #21252a;
    border-radius: 999px;
    font-weight: 700;
    padding: 12px 24px;
    border: none;
    cursor: pointer;
    transition: transform 0.2s;
  }
  .pc-write-review-btn:hover, .pc-submit-btn:hover {
    transform: translateY(-2px);
  }
  .pc-cancel-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    margin-left: 15px;
    color: #595961;
    text-decoration: underline;
  }
  
  /* Form */
  .pc-review-form-container {
    background: #f9f9fa;
    padding: 24px;
    border-radius: 8px;
    margin-bottom: 30px;
  }
  .pc-form-group {
    margin-bottom: 15px;
  }
  .pc-form-group label {
    display: block;
    margin-bottom: 5px;
    font-weight: 600;
  }
  .pc-form-group input, .pc-form-group select, .pc-form-group textarea {
    width: 100%;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 4px;
  }

  /* Review Item */
  .pc-review-item {
    border-bottom: 1px solid #f0f0f1;
    padding-bottom: 30px;
    margin-bottom: 30px;
    display: grid;
    grid-template-columns: 225px 1fr;
    gap: 20px;
  }
  .pc-reviewer-name {
    font-size: 14px;
    font-weight: 700;
    color: #21252a;
  }
  .pc-reviewer-badge {
    font-size: 12px;
    color: #595961;
  }
  .pc-review-stars {
    color: #ffe330;
    margin-bottom: 10px;
  }
  .pc-review-title {
    font-size: 20px;
    font-weight: 700;
    font-family: var(--purrkins-heading-font, sans-serif);
    margin-bottom: 8px;
  }
  .pc-review-body {
    font-size: 16px;
    color: #595961;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .pc-reviews-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    .pc-review-item {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const widget = document.getElementById('purrkins-reviews-widget');
    const productId = widget.getAttribute('data-product-id');
    const appProxyUrl = '/apps/purrkins/reviews';

    const listContainer = document.getElementById('pc-review-list');
    const writeBtn = document.getElementById('pc-write-review-btn');
    const formContainer = document.getElementById('pc-review-form-container');
    const cancelBtn = document.getElementById('pc-cancel-review-btn');
    const reviewForm = document.getElementById('pc-review-form');
    const formMessage = document.getElementById('pc-form-message');
    
    // UI Elements for summary
    const avgRatingEl = document.getElementById('pc-average-rating');
    const totalReviewsEl = document.getElementById('pc-total-reviews');
    const summaryStarsEl = document.getElementById('pc-summary-stars');

    // Toggle Form
    writeBtn.addEventListener('click', () => {
      formContainer.style.display = 'block';
      writeBtn.style.display = 'none';
    });

    cancelBtn.addEventListener('click', () => {
      formContainer.style.display = 'none';
      writeBtn.style.display = 'block';
    });

    function generateStars(rating) {
      const starSvgPath = 'M8.48369 0.971883C8.51935 0.89984 8.57444 0.839198 8.64273 0.796799C8.71102 0.754401 8.78981 0.731934 8.87019 0.731934C8.95058 0.731934 9.02936 0.754401 9.09765 0.796799C9.16595 0.839198 9.22103 0.89984 9.25669 0.971883L11.1363 4.77909C11.2601 5.02967 11.4429 5.24647 11.6689 5.41087C11.895 5.57527 12.1576 5.68236 12.4341 5.72296L16.6376 6.3381C16.7172 6.34964 16.7921 6.38323 16.8536 6.43509C16.9151 6.48694 16.961 6.55498 16.9858 6.63152C17.0107 6.70805 17.0137 6.79002 16.9944 6.86816C16.9752 6.94629 16.9344 7.01748 16.8768 7.07366L13.8369 10.0338C13.6364 10.2292 13.4864 10.4704 13.3998 10.7365C13.3132 11.0027 13.2926 11.286 13.3397 11.5619L14.0574 15.7442C14.0715 15.8238 14.0629 15.9058 14.0326 15.9808C14.0023 16.0557 13.9516 16.1206 13.8862 16.1682C13.8207 16.2157 13.7433 16.2438 13.6627 16.2494C13.582 16.2551 13.5014 16.2379 13.4301 16.1999L9.67248 14.2243C9.42489 14.0943 9.14943 14.0264 8.86979 14.0264C8.59014 14.0264 8.31468 14.0943 8.06709 14.2243L4.31033 16.1999C4.239 16.2377 4.1585 16.2546 4.07799 16.2489C3.99748 16.2432 3.92019 16.215 3.85491 16.1675C3.78964 16.12 3.73899 16.0552 3.70874 15.9804C3.67849 15.9055 3.66985 15.8237 3.6838 15.7442L4.40065 11.5627C4.448 11.2867 4.42749 11.0032 4.34088 10.7369C4.25426 10.4705 4.10415 10.2292 3.90349 10.0338L0.863587 7.07448C0.805485 7.01836 0.764312 6.94705 0.744759 6.86868C0.725206 6.7903 0.728058 6.70801 0.75299 6.63118C0.777923 6.55434 0.823934 6.48606 0.885781 6.4341C0.947629 6.38214 1.02283 6.34859 1.10281 6.33728L5.30546 5.72296C5.58232 5.68268 5.84525 5.57573 6.07161 5.41131C6.29797 5.24689 6.48099 5.02992 6.60491 4.77909L8.48369 0.971883Z';
      const filledSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="17" viewBox="0 0 18 17" fill="none" style="margin-right:2px"><path d="${starSvgPath}" fill="#FFE330" stroke="#FFE330" stroke-width="1.46389" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
      const emptySvg = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="17" viewBox="0 0 18 17" fill="none" style="margin-right:2px"><path d="${starSvgPath}" fill="none" stroke="#FFE330" stroke-width="1.46389" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
      const r = Math.max(0, Math.min(5, Math.round(Number(rating) || 0)));
      return filledSvg.repeat(r) + emptySvg.repeat(5 - r);
    }

    // Fetch Reviews
    function fetchReviews() {
      // If we want all reviews for the shop instead of just product, we can omit ?productId=
      // Based on user request to "show all review in that", we will omit productId so all reviews show.
      // fetch(`${appProxyUrl}?productId=${productId}`) 
      fetch(`${appProxyUrl}`)
        .then(res => res.json())
        .then(data => {
          if (data.error) throw new Error(data.error);

          const avg = parseFloat(data.averageRating).toFixed(1);
          avgRatingEl.textContent = avg;
          totalReviewsEl.textContent = `Based on ${data.totalCount} reviews`;
          summaryStarsEl.textContent = generateStars(avg);

          if (data.reviews.length === 0) {
            listContainer.innerHTML = '<p>No reviews yet. Be the first to review!</p>';
            return;
          }

          listContainer.innerHTML = data.reviews.map(review => `
            <div class="pc-review-item">
              <div class="pc-reviewer-info">
                <div class="pc-reviewer-name">${review.author || 'Anonymous'}</div>
                ${review.isVerified ? '<div class="pc-reviewer-badge">Verified Buyer</div>' : ''}
              </div>
              <div class="pc-review-content">
                <div class="pc-review-stars">${generateStars(review.rating)}</div>
                <div class="pc-review-title">${review.title || ''}</div>
                <div class="pc-review-body">${review.body || ''}</div>
              </div>
            </div>
          `).join('');
          
          // Also update the preview badge above if it exists
          const previewBadgeText = document.getElementById('pc-preview-text');
          if(previewBadgeText) {
            previewBadgeText.textContent = `${data.totalCount} Reviews`;
          }
          const previewBadgeStars = document.getElementById('pc-preview-stars');
          if(previewBadgeStars) {
             previewBadgeStars.textContent = generateStars(avg);
          }

        })
        .catch(err => {
          console.error(err);
          listContainer.innerHTML = '<p>Error loading reviews.</p>';
        });
    }

    // Submit Review
    reviewForm.addEventListener('submit', function(e) {
      e.preventDefault();
      
      const formData = new FormData(reviewForm);
      const submitBtn = reviewForm.querySelector('.pc-submit-btn');
      submitBtn.textContent = 'Submitting...';
      submitBtn.disabled = true;

      fetch(appProxyUrl, {
        method: 'POST',
        body: formData
      })
      .then(res => res.json())
      .then(data => {
        submitBtn.textContent = 'Submit Review';
        submitBtn.disabled = false;
        
        if (data.success) {
          formMessage.style.display = 'block';
          formMessage.style.color = 'green';
          formMessage.textContent = 'Review submitted successfully!';
          reviewForm.reset();
          setTimeout(() => {
            formContainer.style.display = 'none';
            writeBtn.style.display = 'block';
            formMessage.style.display = 'none';
            fetchReviews(); // Reload reviews
          }, 2000);
        } else {
          throw new Error(data.error || 'Failed to submit review');
        }
      })
      .catch(err => {
        submitBtn.textContent = 'Submit Review';
        submitBtn.disabled = false;
        formMessage.style.display = 'block';
        formMessage.style.color = 'red';
        formMessage.textContent = err.message;
      });
    });

    // Initial Load
    fetchReviews();
  });
</script>

{% schema %}
{
  "name": "Purrkins Custom Reviews",
  "settings": [],
  "presets": [
    {
      "name": "Purrkins Custom Reviews"
    }
  ]
}
{% endschema %}
