}
.cb-slide-left {
    flex: 0 0 45%;
    display: flex;
    justify-content: center;
    align-items: center;
    max-width: 508px;
}
.cb-slide-left img {
    width: 100%;
    height: auto;
    object-fit: contain;
    mix-blend-mode: multiply;
        max-height: 396px;
}
