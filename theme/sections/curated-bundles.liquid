    font-weight: 400;
    margin-left: 4px;
}
.cb-section {
    margin-bottom: 24px;
}
.cb-section-heading {
    margin: 0 0 4px 0;
    font-family: var(--purrkins-heading-font);
    color: var(--color-text-primary, #121217);
    font-size: 18px;
    font-weight: 700;
    line-height: 2;
}
.cb-inside-grid {
    display: grid;
