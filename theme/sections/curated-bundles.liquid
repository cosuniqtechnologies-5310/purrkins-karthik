    gap: 16px;
}
.cb-inside-pill {
    display: flex;
    padding: 8px;
    align-items: center;
    border-radius: var(--radius-small, 8px);
    background: #FFF;
    gap: 12px;
}
.cb-inside-left-icons {
    display: flex;
    align-items: center;
    gap: 12px;
}
.cb-inside-icon {
