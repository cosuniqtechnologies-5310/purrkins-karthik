<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" defer="defer"></script>
<div class="curated-bundles-block {{ section.settings.custom_class }}" id="cb-{{ section.id }}">
    <div class="purrkins-container purrkins-section-block">
        
        <div class="cb-header">
            <div class="cb-header-left">
                {% if section.settings.heading != blank %}
                    <h2 class="cb-heading purrkins-h2-text">{{ section.settings.heading }}</h2>
                {% endif %}
                {% if section.settings.subheading != blank %}
                    <p class="cb-subheading purrkins-subtext">{{ section.settings.subheading }}</p>
                {% endif %}
            </div>
            {% if section.settings.button_text != blank and section.settings.button_url != blank %}
                <div class="cb-header-right">
                    <a href="{{ section.settings.button_url }}" class="cb-compare-btn">{{ section.settings.button_text }}</a>
                </div>
            {% endif %}
        </div>
        
        {% assign use_slider = section.settings.enable_slider %}
        {% if template.name == 'collection' %}
            {% assign use_slider = false %}
        {% endif %}
        
        <div class="{% if use_slider %}swiper cb-swiper-container{% else %}cb-grid-container{% endif %}">
            <div class="{% if use_slider %}swiper-wrapper{% else %}cb-grid-wrapper{% endif %}">
                {% assign coll = section.settings.collection %}
                {% if coll == blank and collection %}
                    {% assign coll = collection %}
                {% endif %}
                
                {% if coll != blank and coll.products.size > 0 %}
                    {% for product in coll.products %}
                        <div class="{% if use_slider %}swiper-slide{% else %}cb-grid-item{% endif %}">
                            <div class="cb-slide-inner">
                                <div class="cb-slide-left">
                                    <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" class="cb-product-image" width="800" height="800">
                                </div>
                                <div class="cb-slide-right">
                                    <div class="cb-title-row">
                                        <h3 class="cb-product-title purrkins-h3-text">{{ product.title }}</h3>
                                    </div>
                                    
                                    {% if product.metafields.custom.short_description != blank %}
                                        <p class="cb-short-desc purrkins-subtext">{{ product.metafields.custom.short_description }}</p>
                                    {% endif %}
                                    
                                    <div class="cb-qd-item">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="31" height="23" viewBox="0 0 31 23" fill="none">
                                          <path d="M26.9488 14.5563C26.9488 8.45595 21.7356 3.5108 15.3045 3.5108C8.87389 3.5108 3.66016 8.45595 3.66016 14.5563C3.66016 18.6233 7.136 21.9199 11.4231 21.9199H19.186C23.4735 21.9199 26.9488 18.6233 26.9488 14.5563Z" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                          <path d="M15.3072 12.7146V14.5555C15.3072 15.0439 15.103 15.5119 14.7391 15.8571C14.3752 16.2027 13.8813 16.3965 13.3665 16.3965C12.2948 16.3965 11.4258 15.5722 11.4258 14.5555" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                          <path d="M15.3027 12.7146V14.5555C15.3027 15.0439 15.5075 15.5119 15.8714 15.8571C16.2352 16.2027 16.7292 16.3965 17.2434 16.3965C18.3157 16.3965 19.1842 15.5722 19.1842 14.5555" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                          <path d="M14.3359 12.7148H16.2767" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                          <path d="M5.60179 12.7148H0.75" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                          <path d="M29.8616 12.7148H25.0098" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                          <path d="M5.60179 16.3965H0.75" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                          <path d="M29.8616 16.3965H25.0098" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                          <path d="M4.63184 10.1348V0.749312H4.63232C6.4959 0.749312 8.28331 1.45163 9.60151 2.70158L11.1992 4.21718" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                          <path d="M25.9819 10.1348V0.749312C24.1179 0.749312 22.3305 1.45163 21.0128 2.70158L19.415 4.21718" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                          <path d="M10.4521 9.95312C10.9878 9.44502 11.8577 9.44502 12.3929 9.95312" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                          <path d="M18.2178 9.95312C18.7534 9.44502 19.6233 9.44502 20.1585 9.95312" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg>
                                        {{ product.type | default: '3-week+' }}
                                    </div>
                                    
                                    {% if product.metafields.custom.number_of_product != blank or product.metafields.number_of_pouches != blank %}
                                        <div class="cb-meta-row">
                                            <div class="cb-meta-pill">
                                                <span style="line-height: 1;">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="26" viewBox="0 0 20 26" fill="none">
                                                        <path d="M0.75 3.84783H3.74787V6.8457H0.75" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                                        <path d="M3.74902 3.84766H18.7384" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                                        <path d="M3.74902 6.8457H18.7384" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                                        <path d="M18.7402 6.84532C18.7402 9.84319 17.9757 11.3421 17.9757 16.1087C17.9757 19.5263 19.1748 22.5092 18.5753 24.4728C17.2562 25.4621 14.2434 24.0831 9.74659 24.0831C5.24978 24.0831 2.23687 25.4621 0.917861 24.4728C0.318338 22.5092 1.51744 19.5263 1.51744 16.1087C1.51744 11.3421 0.752979 9.84319 0.752979 6.84532V0.749657H18.7402V6.84532Z" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                                                    </svg>
                                                </span>
                                                {% if product.metafields.custom.number_of_product != blank %}{{ product.metafields.custom.number_of_product }}{% endif %}
                                                {% if product.metafields.custom.number_of_product != blank and product.metafields.custom.number_of_pouches != blank %}<span>|</span>{% endif %}
                                                {% if product.metafields.custom.number_of_pouches != blank %}{{ product.metafields.custom.number_of_pouches }}{% endif %}
                                            </div>
                                        </div>
                                    {% endif %}
                                    
                                    {% assign inside_items = product.metafields.custom.bundle_whats_inside.value %}
                                    {% if inside_items != blank %}
                                        <div class="cb-section">
                                            <h4 class="cb-section-heading">What's inside</h4>
                                            <div class="cb-inside-grid">
                                                {% for item in inside_items %}
                                                    <div class="cb-inside-pill">
                                                        <div class="cb-inside-left-icons">
                                                            {% if item.item_icon != blank %}
                                                                <img src="{{ item.item_icon | image_url: width: 64 }}" class="cb-inside-icon" alt="" width="64" height="64">
                                                            {% else %}
                                                                <div></div>
                                                            {% endif %}
                                                            <span class="cb-inside-text">{{ item.item_name }}</span>
                                                        </div>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% endif %}
                                    
                                    {% assign best_items = product.metafields.custom.bundle_best_for.value %}
                                    {% if best_items != blank %}
                                        <div class="cb-section">
                                            <h4 class="cb-section-heading">Best for</h4>
                                            <div class="cb-best-for-row">
                                                {% for tag in best_items %}
                                                    <div class="cb-best-for-pill">
                                                        {% if tag.item_icon != blank %}
                                                            <img src="{{ tag.item_icon | image_url: width: 64 }}" class="cb-best-for-icon" alt="" width="64" height="64">
                                                        {% endif %}
                                                        <span>{{ tag.item_name }}</span>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% endif %}
                                    
                                    <div class="cb-footer-row">
                                        <div class="cb-price-col">
                                            <div class="cb-price purrkins-h3-text">{{ product.price | money_without_trailing_zeros }}</div>
                                            {% if section.settings.subscription_text != blank %}
                                                <div class="cb-sub-text">{{ section.settings.subscription_text }}</div>
                                            {% endif %}
                                        </div>
                                        <div class="cb-btn-col">
                                            <button class="cb-add-to-cart purrkins-btn-secondary cb-ajax-add-to-cart" data-variant-id="{{ product.selected_or_first_available_variant.id }}">Add to Cart</button>
                                        </div>
                                    </div>
                                    
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="{% if use_slider %}swiper-slide{% else %}cb-grid-item{% endif %}">
                        <div style="padding: 40px; text-align: center;">Please select a collection with products in the section settings.</div>
                    </div>
                {% endif %}
            </div>
            <!-- Pagination -->
            {% if use_slider %}
                <div class="swiper-pagination cb-pagination"></div>
            {% endif %}
        </div>
        
    </div>
</div>

<script>
function initCBSwiper_{{ section.id | replace: '-', '_' }}() {
    var container = document.querySelector("#cb-{{ section.id }} .cb-swiper-container");
    if (!container) return;
    
    if (typeof Swiper === 'undefined') return;
    
    if (container.swiper !== undefined) {
        container.swiper.destroy(true, true);
    }
    
    var cbSwiper = new Swiper(container, {
        slidesPerView: 1,
        spaceBetween: 20,
        pagination: {
            el: "#cb-{{ section.id }} .cb-pagination",
            clickable: true,
        },
        autoHeight: true
    });
}

function initCBAddToCart_{{ section.id | replace: '-', '_' }}() {
    const cbBlock = document.getElementById('cb-{{ section.id }}');
    if (cbBlock && !cbBlock.dataset.listenerAdded) {
        cbBlock.dataset.listenerAdded = 'true';
        
        cbBlock.addEventListener('click', function(e) {
            const addBtn = e.target.closest('.cb-ajax-add-to-cart');
            if (addBtn) {
                e.preventDefault();
                e.stopImmediatePropagation();
                
                if (addBtn.disabled) return;
                
                const variantId = parseInt(addBtn.getAttribute('data-variant-id'), 10);
                const qty = 1;
                
                if (!variantId) {
                    alert('Product variant not available.');
                    return;
                }
                
                const originalText = addBtn.innerHTML;
                addBtn.innerHTML = 'Adding...';
                addBtn.disabled = true;
                addBtn.style.opacity = '0.7';

                fetch(window.Shopify.routes ? window.Shopify.routes.root + 'cart/add.js' : '/cart/add.js', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        items: [{ id: variantId, quantity: qty }],
                        sections: 'cart-drawer-section',
                        sections_url: window.location.pathname
                    })
                })
                .then(async res => {
                    const data = await res.json().catch(() => ({}));
                    if (!res.ok) {
                        throw new Error(data.description || data.message || 'Error adding to cart');
                    }
                    return data;
                })
                .then(async data => {
                    addBtn.innerHTML = originalText;
                    addBtn.disabled = false;
                    addBtn.style.opacity = '1';
                    
                    const eventName = (window.StandardEvents && window.StandardEvents.cartLinesUpdate) ? window.StandardEvents.cartLinesUpdate : 'shopify:cart:lines-update';
                    const updateEvent = new CustomEvent(eventName, { bubbles: true });
                    updateEvent.action = 'add';
                    
                    let resolvePromise;
                    const promise = new Promise((resolve) => { resolvePromise = resolve; });
                    updateEvent.promise = promise;
                    document.dispatchEvent(updateEvent);

                    const cartData = await fetch(window.Shopify.routes ? window.Shopify.routes.root + 'cart.js' : '/cart.js').then(r => r.json()).catch(() => null);
                    resolvePromise({ cart: cartData, detail: { items: data.items || [data], sections: data.sections, itemCount: cartData ? cartData.item_count : 0 } });

                    // Forcefully update the cart drawer to ensure immediate sync
                    try {
                        const sectionRes = await fetch((window.Shopify.routes ? window.Shopify.routes.root : '/') + '?section_id=cart-drawer-section');
                        const sectionHtmlText = await sectionRes.text();
                        const html = new DOMParser().parseFromString(sectionHtmlText, 'text/html');
                        const newDrawer = html.querySelector('cart-drawer-component');
                        const existingDrawer = document.querySelector('cart-drawer-component');
                        if (newDrawer && existingDrawer) {
                            existingDrawer.replaceWith(newDrawer);
                        }
                    } catch (e) {
                        console.error('Error forcefully updating cart drawer:', e);
                    }

                    setTimeout(() => {
                        const drawer = document.querySelector('theme-drawer#cart-drawer') || document.querySelector('theme-drawer');
                        if (drawer && !drawer.hasAttribute('open')) {
                            if (typeof drawer.open === 'function') drawer.open();
                            else if (typeof drawer.show === 'function') drawer.show();
                        }
                    }, 100);

                    document.documentElement.dispatchEvent(new CustomEvent('cart:build', {bubbles: true}));
                })
                .catch(err => {
                    console.error(err);
                    addBtn.innerHTML = originalText;
                    addBtn.disabled = false;
                    addBtn.style.opacity = '1';
                    alert('Could not add item to cart: ' + err.message);
                });
            }
        });
    }
}


function tryInitCBSwiper_{{ section.id | replace: '-', '_' }}() {
    if (typeof Swiper !== 'undefined') {
        initCBSwiper_{{ section.id | replace: '-', '_' }}();
    } else {
        setTimeout(tryInitCBSwiper_{{ section.id | replace: '-', '_' }}, 100);
    }
}

document.addEventListener("DOMContentLoaded", function() {
    {% if use_slider %}
    tryInitCBSwiper_{{ section.id | replace: '-', '_' }}();
    {% endif %}
    initCBAddToCart_{{ section.id | replace: '-', '_' }}();
});

if (window.Shopify && window.Shopify.designMode) {
    {% if use_slider %}
    tryInitCBSwiper_{{ section.id | replace: '-', '_' }}();
    {% endif %}
    initCBAddToCart_{{ section.id | replace: '-', '_' }}();
    
    document.addEventListener('shopify:section:load', function(event) {
        if (event.detail.sectionId === '{{ section.id }}') {
            {% if use_slider %}
            tryInitCBSwiper_{{ section.id | replace: '-', '_' }}();
            {% endif %}
            initCBAddToCart_{{ section.id | replace: '-', '_' }}();
        }
    });
}
</script>

<style>
.cb-grid-wrapper {
    display: flex;
    flex-direction: column;
    gap: 40px;
}
.cb-grid-item {
    width: 100%;
}
.curated-bundles-block {
    width: 100%;
}
.cb-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
    flex-wrap: wrap;
    gap: 20px;
}
.cb-heading {
    margin-top: 0;
    margin-bottom: 8px;
}
.cb-subheading {
    margin: 0;
    color: var(--color-text-secondary, #595961);
}
.cb-compare-btn {
    display: inline-flex;
    padding: 12px 24px;
    justify-content: center;
    align-items: center;
    border-radius: 30px;
    border: 1px solid var(--brand-slate-900, #21252A);
    color: var(--brand-slate-900, #21252A);
    font-family: var(--purrkins-heading-font);
    font-size: 16px;
