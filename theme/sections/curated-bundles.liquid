        text-align: center;
    }

    .cb-section-heading {
        font-size: 16px;
    }

    .cb-add-to-cart.purrkins-btn-secondary {
        font-size: 14px;
    }

    .cb-header {
        align-items: center;
    }

    .cb-product-title {
        font-size: 24px;
    }

    .cb-sub-text {
        font-size: 16px;
    }

    .cb-pagination {
        margin-top: 24px;
    }
    .cb-meta-pill, .cb-qd-item{
font-size: 16px;
    }
}

</style>

{% schema %}
{
  "name": "Purrkins Curated Bundles",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Curated bundles"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "The easiest way to feed your cat"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Compare All Bundles >"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select the Collections"
    },
    {
      "type": "text",
      "id": "subscription_text",
      "label": "Subscription Text",
      "default": "Save 15% with subscription"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class"
    },
    {
