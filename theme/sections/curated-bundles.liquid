    flex: 1;
    display: flex;
    flex-direction: column;
}
.cb-title-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 12px;
}
.cb-product-title {
    margin: 0;
}
.cb-short-desc {
    margin-top: 0;
    margin-bottom: 16px;
}
.cb-qd-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
    color: #3E4148;
    font-size: 18px;
    font-weight: 500;
}
.cb-meta-row {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
}
.cb-meta-pill {
