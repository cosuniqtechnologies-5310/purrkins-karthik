<div class="purrkins-custom-reviews-section purrkins-container purrkins-section-block">
  <div style="clear:both"></div>

  <h2 class="pc-main-title">Customer reviews</h2>

  <div class="pc-reviews-wrapper" id="purrkins-reviews-widget" data-product-id="{{ product.id }}">
    <div class="pc-reviews-header">
      <div class="pc-reviews-summary">
        <div class="pc-summary-left">
          <div class="pc-summary-average" id="pc-average-rating">0.0</div>
          <div class="pc-summary-stars" id="pc-summary-stars">☆☆☆☆☆</div>
        </div>
        <div class="pc-summary-bars" id="pc-summary-bars">
          <!-- Populated by JS -->
        </div>
      </div>

      <div class="pc-reviews-images" id="pc-header-images">
        <!-- Image thumbnails will go here -->
      </div>

      <div class="pc-reviews-actions">
        <button class="pc-write-review-btn" id="pc-write-review-btn">Write a Review</button>
      </div>
    </div>

    <!-- Review List -->
    <div class="pc-review-list" id="pc-review-list">
      <div class="pc-loading">Loading reviews...</div>
    </div>

    <div class="pc-read-more-wrapper">
      <button class="pc-read-more-btn" id="pc-read-more-btn" style="display:none;">Read More Review</button>
    </div>
  </div>
</div>

<!-- Write Review Modal -->
<div class="pc-modal-overlay" id="pc-review-modal" style="display: none;">
  <div class="pc-modal-content">
    <button class="pc-modal-close" id="pc-modal-close" type="button" aria-label="Close review modal">
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
    <h2 class="pc-modal-title">Write a review</h2>

    <div class="pc-rating-selector" id="pc-rating-selector">
      <span class="pc-star-select active" data-val="1"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="19" viewBox="0 0 20 19" fill="none">
