</svg></span>
      <span class="pc-star-select active" data-val="2"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="19" viewBox="0 0 20 19" fill="none">
  <path d="M9.4541 0.708984C9.57955 0.322905 10.1255 0.322904 10.251 0.708984L12.002 6.09863C12.1703 6.61658 12.6536 6.9668 13.1982 6.9668H18.8652C19.2711 6.96687 19.4397 7.487 19.1113 7.72559L14.5264 11.0566C14.086 11.3768 13.9021 11.9441 14.0703 12.4619L15.8213 17.8516C15.9466 18.2375 15.5051 18.5584 15.1768 18.3203L10.5918 14.9893C10.1512 14.6691 9.5539 14.6691 9.11328 14.9893L4.5293 18.3203C4.2009 18.5589 3.75843 18.2376 3.88379 17.8516L5.63477 12.4619C5.80303 11.9441 5.61911 11.3768 5.17871 11.0566L0.59375 7.72559C0.265387 7.48702 0.434044 6.96697 0.839844 6.9668H6.50684C7.05144 6.9668 7.53479 6.61656 7.70312 6.09863L9.4541 0.708984Z" stroke="#DEC106" stroke-width="0.838111"/>
