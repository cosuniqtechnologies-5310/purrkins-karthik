<div id="purrkins-about-kitten-first-{{ section.id }}" class="purrkins-about-kitten-first-block {{ section.settings.custom_class }}">
    <div class="purrkins-container akf-inner purrkins-section-block">
        <div class="akf-content">
            {% if section.settings.heading != blank %}
                <h2 class="akf-heading purrkins-h2-text">{{ section.settings.heading }}</h2>
            {% endif %}
            
            {% if section.settings.subheading != blank %}
                <p class="akf-subheading purrkins-subtext">{{ section.settings.subheading }}</p>
            {% endif %}
        </div>
        <div class="akf-image-wrapper">
            {% if section.settings.image != blank %}
                <img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}" class="akf-image" width="1120" height="auto" />
            {% else %}
                <!-- Placeholder if no image uploaded -->
                <div class="akf-placeholder-image" style="width: 100%; height: 400px; background: #e0e0e0; border-radius: 12px; display: flex; align-items: center; justify-content: center;">
                    <span>Product Image Placeholder</span>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<style>
.purrkins-about-kitten-first-block { width: 100%; background-color: var(--neutral-white, #FFF); } 
.akf-inner { margin: 0 auto; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 60px 20px 80px; } 
.akf-content { max-width: 1120px; margin-bottom: 60px; } 
.akf-heading { margin-top: 0; margin-bottom: 16px; } 
.akf-subheading { margin: 0; } 
.akf-image-wrapper { width: 100%; display: flex; justify-content: center; } 
.akf-image { width: 100%; height: auto; max-height: 600px; object-fit: contain; } 
@media(max-width: 1024px){
    .akf-inner{
            padding: 60px 20px;
    }
}
@media(max-width: 991px){ .akf-content { max-width: 685px; margin-bottom: 40px; } } 
@media(max-width: 767px){
    .akf-inner{
            padding: 30px 20px;
    }
    img.akf-image {
    max-width: 362px;
}
}
</style>

{% schema %}
{
  "name": "Purrkins Kitten First",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Kitten-first nutrition from a family with 30 years' experience."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Purrkins is a kitten-first nutrition brand with 30 years of experience and one belief: a kitten's first months shape its future."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class"
    }
  ],
  "presets": [
    {
      "name": "Purrkins About Kitten First"
    }
  ]
}
{% endschema %}
