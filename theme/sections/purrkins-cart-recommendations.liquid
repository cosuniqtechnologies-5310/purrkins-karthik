{% liquid
  if section.settings.collection != blank
    assign rec_collection = section.settings.collection
  else
    assign rec_collection = collections.all
  endif
  assign max_count = section.settings.max_products | default: 4
%}

<div id="purrkins-cart-recommendations-{{ section.id }}" class="purrkins-cart-recommendations {{ section.settings.custom_class }}" style="padding-top: {{ section.settings.padding_top | default: 48 }}px; padding-bottom: {{ section.settings.padding_bottom | default: 72 }}px;{% if section.settings.background_color != blank %} background-color: {{ section.settings.background_color }};{% endif %}">
  <div class="purrkins-container">
    <div class="pk-cart-rec-header">
      <h3 class="pk-cart-rec-title purrkins-h3-text">{{ section.settings.heading | default: 'You may also like' }}</h3>
      {% if section.settings.view_all_link != blank and section.settings.view_all_label != blank %}
        <a href="{{ section.settings.view_all_link }}" class="pk-cart-rec-view-all">
          <span>{{ section.settings.view_all_label }}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      {% endif %}
    </div>

    <div class="pk-cart-rec-grid">
      {% assign displayed = 0 %}
      {% for product in rec_collection.products %}
        {% assign in_cart = false %}
        {% for item in cart.items %}
          {% if item.product_id == product.id %}
            {% assign in_cart = true %}
            {% break %}
          {% endif %}
        {% endfor %}

        {% unless in_cart %}
          <div class="pk-cart-rec-item">
            {% render 'purrkins-collection-card', product: product %}
          </div>
          {% assign displayed = displayed | plus: 1 %}
          {% if displayed >= max_count %}{% break %}{% endif %}
        {% endunless %}
      {% endfor %}

      {% comment %} Fallback: if cart has many items and fewer than max_count were displayed, backfill {% endcomment %}
      {% if displayed < max_count %}
        {% for product in rec_collection.products %}
          {% if displayed >= max_count %}{% break %}{% endif %}
          <div class="pk-cart-rec-item">
            {% render 'purrkins-collection-card', product: product %}
          </div>
          {% assign displayed = displayed | plus: 1 %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

<style>
.purrkins-cart-recommendations {
  width: 100%;
  box-sizing: border-box;
}

.purrkins-cart-recommendations .purrkins-container {
  max-width: 1336px;
  margin: 0 auto;
  padding-left: 20px;
  padding-right: 20px;
  box-sizing: border-box;
  overflow: visible;
}

.pk-cart-rec-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28px;
  gap: 16px;
}

.pk-cart-rec-title {
  margin: 0;
  font-family: var(--purrkins-heading-font, 'Bricolage Grotesque', sans-serif);
  font-size: 32px;
  font-weight: 800;
  color: #16130F;
  letter-spacing: -0.5px;
  line-height: 1.2;
}

.pk-cart-rec-view-all {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-family: var(--purrkins-heading-font, 'Bricolage Grotesque', sans-serif);
  font-size: 15px;
  font-weight: 700;
  color: #16130F;
  text-decoration: none;
  padding: 8px 16px;
  border-radius: 9999px;
  background: #FAF9F5;
  border: 1px solid #ECECEC;
  transition: all 0.2s ease;
}

.pk-cart-rec-view-all:hover {
  background: #FED000;
  border-color: #FED000;
  color: #16130F;
  transform: translateX(2px);
}

.pk-cart-rec-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24px;
}

.pk-cart-rec-item {
  display: flex;
  flex-direction: column;
}

.pk-cart-rec-item .pf-collection-card-wrap {
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.pk-cart-rec-item .pf-collection-card-wrap:hover {
  transform: translateY(-4px);
  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.08);
}

@media (max-width: 1024px) {
  .pk-cart-rec-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
}

@media (max-width: 640px) {
  .pk-cart-rec-title {
    font-size: 24px;
  }
  
  .pk-cart-rec-header {
    margin-bottom: 20px;
  }
  
  .pk-cart-rec-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  
  .pk-cart-rec-view-all {
    padding: 6px 12px;
    font-size: 13px;
  }
}
</style>

{% schema %}
{
  "name": "Cart Recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Number of products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all link text",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link URL",
      "default": "/collections/all"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS class"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Cart Recommendations"
    }
  ]
}
{% endschema %}
