<div class="pk-contact-section" id="pk-contact-{{ section.id }}">
  <div class="pk-contact-header">
    <h1 class="pk-contact-title">{{ section.settings.heading }}</h1>
    <p class="pk-contact-subtitle">{{ section.settings.subheading }}</p>
  </div>

  <div class="pk-contact-form-container">
    <form id="pk-contact-form-{{ section.id }}" class="pk-contact-form" novalidate>
      <div
        class="pk-form-success"
        id="pk-success-{{ section.id }}"
        style="display:none; align-items: center; background: #ECFDF5; color: #065F46; padding: 16px; border-radius: 12px; margin-bottom: 24px; font-weight: 500;"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          style="color: #10B981; margin-right: 8px;"
        >
          <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline>
        </svg>
        Thanks for reaching out! We'll get back to you shortly.
      </div>

      <div
        class="pk-form-error"
        id="pk-error-{{ section.id }}"
        style="display:none; background: #FEF2F2; color: #991B1B; padding: 16px; border-radius: 12px; margin-bottom: 24px; font-weight: 500;"
      >
        Please check the errors below and try again.
      </div>

      <div class="pk-form-row">
        <div class="pk-form-group">
          <label for="ContactForm-name-{{ section.id }}">Your Name *</label>
          <input
            type="text"
            id="ContactForm-name-{{ section.id }}"
            name="contact[name]"
            placeholder="Full Name"
            value="{% if customer %}{{ customer.name }}{% endif %}"
            required
          >
        </div>
        <div class="pk-form-group">
          <label for="ContactForm-phone-{{ section.id }}">Mobile Number *</label>
          <input
            type="tel"
            id="ContactForm-phone-{{ section.id }}"
            name="contact[phone]"
            placeholder="+91 |"
            value="{% if customer %}{{ customer.phone }}{% endif %}"
            required
            oninput="this.value = this.value.replace(/[^0-9]/g, '')"
          >
        </div>
      </div>

      <div class="pk-form-group">
        <label for="ContactForm-email-{{ section.id }}">Your Email *</label>
        <input
          type="email"
          id="ContactForm-email-{{ section.id }}"
          name="contact[email]"
          placeholder="yourname@example.com"
          value="{% if customer %}{{ customer.email }}{% endif %}"
          required
        >
      </div>

      <div class="pk-form-group">
        <label for="ContactForm-topic-{{ section.id }}">What is this about? *</label>
        <div class="pk-select-wrapper">
          <select id="ContactForm-topic-{{ section.id }}" name="contact[Topic]" required>
            <option value="" disabled selected>Select an option</option>
            <option value="Kitten Related">Kitten Related</option>
            <option value="Adult Cat">Adult Cat</option>
            <option value="Order Tracking/Issue">Order Tracking/Issue</option>
            <option value="Other">Other</option>
          </select>
          <svg
            class="pk-select-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </div>
      </div>

      <div class="pk-form-group">
        <label for="ContactForm-body-{{ section.id }}">Message *</label>
        <textarea
          id="ContactForm-body-{{ section.id }}"
          name="contact[body]"
          placeholder="My kitten is always sleepy..."
          required
          rows="5"
        ></textarea>
      </div>

      <div class="pk-form-submit">
        <button type="submit" class="pk-submit-btn" id="pk-submit-{{ section.id }}">Send Message</button>
      </div>
    </form>

    <script>
      (function () {
        var form = document.getElementById('pk-contact-form-{{ section.id }}');
        if (!form) return;

        form.addEventListener(
          'submit',
          function (e) {
            e.preventDefault();
            e.stopPropagation();

            var submitBtn = document.getElementById('pk-submit-{{ section.id }}');
            var successEl = document.getElementById('pk-success-{{ section.id }}');
            var errorEl = document.getElementById('pk-error-{{ section.id }}');

            if (submitBtn.disabled) return false;
            submitBtn.disabled = true;
            submitBtn.textContent = 'Sending...';
            errorEl.style.display = 'none';

            try {
              var name = form.querySelector('[name="contact[name]"]').value.trim();
              var rawPhone = form.querySelector('[name="contact[phone]"]').value.trim();
              var email = form.querySelector('[name="contact[email]"]').value.trim();
              var topic = form.querySelector('[name="contact[Topic]"]').value;
              var message = form.querySelector('[name="contact[body]"]').value.trim();

              if (!name || !rawPhone || !email || !topic || !message) {
                errorEl.textContent = 'Please fill in all required fields.';
                errorEl.style.display = 'block';
                submitBtn.disabled = false;
                submitBtn.textContent = 'Send Message';
                return false;
              }

              var phone = '+91' + rawPhone.replace(/^\+91/, '');

              var payload = {
                name: name,
                phone: phone,
                email: email,
                topic: topic,
                message: message,
                tag: 'Contact Form',
                accepts_marketing: true,
              };

              fetch('/apps/purrkins/contact-us/customer', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify(payload),
              })
                .then(function (response) {
                  return response.json().catch(function () {
                    return {};
                  });
                })
                .then(function (data) {
                  if (data.success) {
                    if (successEl) successEl.style.display = 'flex';
                    submitBtn.textContent = 'Send Message';
                    submitBtn.disabled = false;
                    setTimeout(function () {
                      if (successEl) successEl.style.display = 'none';
                      form.reset();
                    }, 5000);
                  } else {
                    errorEl.textContent = data.message || 'Something went wrong.';
                    errorEl.style.display = 'block';
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Send Message';
                  }
                })
                .catch(function (err) {
                  errorEl.textContent = 'Something went wrong. Please try again.';
                  errorEl.style.display = 'block';
                  submitBtn.disabled = false;
                  submitBtn.textContent = 'Send Message';
                });
            } catch (err) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Send Message';
            }

            return false;
          },
          false
        );
      })();
    </script>
  </div>
</div>

<style>
  .pk-contact-section {
    padding: 80px 20px 100px;
    background: linear-gradient(180deg, #fdf9f0 0%, #e9e6f5 100%);
    font-family: var(--purrkins-body-font, sans-serif);
    min-height: 80vh;
  }

  .pk-contact-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 40px;
  }

  .pk-contact-title {
    font-family: var(--purrkins-heading-font, sans-serif);
    font-size: 48px;
    font-weight: 800;
    color: #111827;
    margin: 0 0 16px;
    letter-spacing: -1px;
  }

  .pk-contact-subtitle {
    font-size: 18px;
    color: #4b5563;
    margin: 0;
  }

  .pk-contact-form-container {
    max-width: 700px;
    margin: 0 auto;
    background: #ffffff;
    border-radius: 20px;
    padding: 50px 60px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);
  }

  .pk-form-row {
    display: flex;
    gap: 24px;
    margin-bottom: 24px;
  }
  .pk-form-row > .pk-form-group {
    flex: 1;
    margin-bottom: 0;
  }

  .pk-form-group {
    margin-bottom: 24px;
  }

  .pk-form-group label {
    display: block;
    font-size: 14px;
    color: #6b7280;
    margin-bottom: 8px;
    font-weight: 500;
  }

  .pk-form-group input,
  .pk-form-group textarea,
  .pk-form-group select {
    width: 100%;
    border: 1px solid #d1d5db;
    border-radius: 20px;
    padding: 14px 20px;
    font-size: 16px;
    color: #1f2937;
    background-color: #ffffff;
    transition: border-color 0.2s, box-shadow 0.2s;
    font-family: inherit;
    appearance: none;
    -webkit-appearance: none;
  }

  .pk-form-group input:focus,
  .pk-form-group textarea:focus,
  .pk-form-group select:focus {
    outline: none;
    border-color: #9ca3af;
    box-shadow: 0 0 0 3px rgba(156, 163, 175, 0.1);
  }

  .pk-form-group input::placeholder,
  .pk-form-group textarea::placeholder {
    color: #9ca3af;
  }

  .pk-select-wrapper {
    position: relative;
  }

  .pk-select-icon {
    position: absolute;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    color: #9ca3af;
    pointer-events: none;
  }

  .pk-form-submit {
    text-align: center;
    margin-top: 32px;
  }

  .pk-submit-btn {
    background: var(--semantic-brand, #ffe330);
    color: #111827;
    border: none;
    border-radius: 40px;
    padding: 16px 48px;
    font-size: 18px;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    transition: transform 0.2s, background-color 0.2s;
  }

  .pk-submit-btn:hover {
    transform: translateY(-2px);
    background-color: #facc15;
  }

  .pk-form-success {
    display: flex;
    align-items: center;
    background: #ecfdf5;
    color: #065f46;
    padding: 16px;
    border-radius: 12px;
    margin-bottom: 24px;
    font-weight: 500;
  }
  .pk-form-error {
    background: #fef2f2;
    color: #991b1b;
    padding: 16px;
    border-radius: 12px;
    margin-bottom: 24px;
    font-weight: 500;
  }

  @media (max-width: 767px) {
    .pk-contact-section {
      padding: 60px 16px 80px;
    }
    .pk-contact-title {
      font-size: 36px;
    }
    .pk-contact-form-container {
      padding: 30px 20px;
      border-radius: 16px;
    }
    .pk-form-row {
      flex-direction: column;
      gap: 24px;
    }
    .pk-submit-btn {
      width: 100%;
      padding: 16px;
    }
  }
</style>

{% schema %}
{
  "name": "Purrkins Contact Form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in touch"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Purrkins food, order, or plan? Send us a note; we'll reply within one working day."
    }
  ],
  "presets": [
    {
      "name": "Purrkins Contact Form"
    }
  ]
}
{% endschema %}
