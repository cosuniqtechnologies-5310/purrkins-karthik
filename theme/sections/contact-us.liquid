<div id="purrkins-contact-us-{{ section.id }}" class="purrkins-contact-us-block {{ section.settings.custom_class }}">
    <div class="purrkins-container contact-us-inner purrkins-section-block">
        <div class="contact-us-header">
            {% if section.settings.heading != blank %}
                <h1 class="contact-us-heading purrkins-h3-text">{{ section.settings.heading }}</h1>
            {% endif %}
            {% if section.settings.subheading != blank %}
                <p class="contact-us-subheading purrkins-subtext">{{ section.settings.subheading }}</p>
            {% endif %}
        </div>

        <div class="contact-us-grid">
            <div class="contact-us-info-col">
                <div class="contact-us-details purrkins-subtext">
                    {% if section.settings.contact_details != blank %}
                        {{ section.settings.contact_details }}
                    {% else %}
                        <p><strong>Contact</strong><br>Email: hello@purrkins.com</p>
                    {% endif %}
                </div>
                
                {% if section.settings.illustration != blank %}
                    <div class="contact-us-illustration">
                        <img src="{{ section.settings.illustration | image_url: width: 600 }}" alt="{{ section.settings.illustration.alt | default: 'Contact Illustration' | escape }}" width="407" height="auto" />
                    </div>
                {% endif %}
            </div>

            <div class="contact-us-form-col">
                <div class="contact-us-form-card">
                    <!-- Plain HTML form — submits JSON to app proxy, no page reload -->
                    <form id="cu-form-{{ section.id }}" class="wpcf7-form" novalidate>
                        <div class="cu-form-success" id="cu-success-{{ section.id }}" style="display:none; color:#5fa99e; font-weight:bold; text-align:center; padding: 20px 0;">
                            Thanks for contacting us! We'll get back to you soon.
                        </div>
                        <div class="cu-form-error" id="cu-error-{{ section.id }}" style="display:none; color:#D32F2F; text-align:center; margin-bottom:16px; font-size:14px;"></div>

                        <div id="cu-fields-{{ section.id }}">
                            <div class="form-row-2">
                                <div>
                                    <label for="cuName-{{ section.id }}">Your Name *</label>
                                    <input type="text" id="cuName-{{ section.id }}" name="cu_name"
                                        value="{% if customer %}{{ customer.name }}{% endif %}"
                                        placeholder="Full Name" required>
                                </div>
                                <div>
                                    <label for="cuPhone-{{ section.id }}">Mobile Number *</label>
                                    <input type="tel" id="cuPhone-{{ section.id }}" name="cu_phone"
                                        value="{% if customer %}{{ customer.phone }}{% endif %}"
                                        placeholder="+91 |" required
                                        oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                                </div>
                            </div>

                            <div>
                                <label for="cuEmail-{{ section.id }}">Your Email *</label>
                                <input type="email" id="cuEmail-{{ section.id }}" name="cu_email"
                                    value="{% if customer %}{{ customer.email }}{% endif %}"
                                    placeholder="yourname@example.com" autocorrect="off" autocapitalize="off" required>
                            </div>

                            <div>
                                <label for="cuSubject-{{ section.id }}">What is this about? *</label>
                                <select id="cuSubject-{{ section.id }}" name="cu_topic" required>
                                    <option value="" disabled selected>Select an option</option>
                                    <option value="Kitten Related">Kitten Related</option>
                                    <option value="Adult Cat">Adult Cat</option>
                                    <option value="Order Issue">Order Issue</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>

                            <div>
                                <label for="cuMessage-{{ section.id }}">Message *</label>
                                <textarea rows="4" id="cuMessage-{{ section.id }}" name="cu_message"
                                    placeholder="My kitten is always sleepy..." required></textarea>
                            </div>

                            <div class="submit-wrapper">
                                <button type="submit" class="wpcf7-submit" id="cu-submit-{{ section.id }}">Send Message</button>
                            </div>
                        </div>
                    </form>

                    <script>
                    (function() {
                        var form = document.getElementById('cu-form-{{ section.id }}');
                        if (!form) return;

                        form.addEventListener('submit', function(e) {
                            e.preventDefault();
                            e.stopPropagation();

                            var submitBtn = document.getElementById('cu-submit-{{ section.id }}');
                            var fieldsEl = document.getElementById('cu-fields-{{ section.id }}');
                            var successEl = document.getElementById('cu-success-{{ section.id }}');
                            var errorEl = document.getElementById('cu-error-{{ section.id }}');

                            if (submitBtn.disabled) return false;
                            submitBtn.disabled = true;
                            submitBtn.textContent = 'Sending...';
                            errorEl.style.display = 'none';

                            try {
                                var name = form.querySelector('[name="cu_name"]').value.trim();
                                var rawPhone = form.querySelector('[name="cu_phone"]').value.trim();
                                var email = form.querySelector('[name="cu_email"]').value.trim();
                                var topic = form.querySelector('[name="cu_topic"]').value;
                                var message = form.querySelector('[name="cu_message"]').value.trim();

                                if (!name || !rawPhone || !email || !topic || !message) {
                                    errorEl.textContent = 'Please fill in all required fields.';
                                    errorEl.style.display = 'block';
                                    submitBtn.disabled = false;
                                    submitBtn.textContent = 'Send Message';
                                    return false;
                                }

                                var phone = '+91' + rawPhone.replace(/^\+91/, '');

                                var payload = {
                                    name: name,
                                    phone: phone,
                                    email: email,
                                    topic: topic,
                                    message: message,
                                    tag: 'contact-us',
                                    accepts_marketing: true
                                };

                                console.log('[ContactUs] Sending:', JSON.stringify(payload));

                                fetch('/apps/purrkins/contact-us/customer', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                                    body: JSON.stringify(payload)
                                })
                                .then(function(response) {
                                    return response.json().catch(function() { return {}; });
                                })
                                .then(function(data) {
                                    console.log('[ContactUs] Response:', data);
                                    // Show success message at top — keep fields visible
                                    if (successEl) successEl.style.display = 'block';
                                    submitBtn.textContent = 'Send Message';
                                    submitBtn.disabled = false;
                                    // Reset form and hide success after 5s
                                    setTimeout(function() {
                                        if (successEl) successEl.style.display = 'none';
                                        form.reset();
                                    }, 5000);
                                })
                                .catch(function(err) {
                                    console.error('[ContactUs] Error:', err);
                                    errorEl.textContent = 'Something went wrong. Please try again.';
                                    errorEl.style.display = 'block';
                                    submitBtn.disabled = false;
                                    submitBtn.textContent = 'Send Message';
                                });

                            } catch(err) {
                                console.error('[ContactUs] Submit error:', err);
                                submitBtn.disabled = false;
                                submitBtn.textContent = 'Send Message';
                            }

                            return false;
                        }, false);
                    })();
                    </script>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.purrkins-contact-us-block {
    width: 100%;
}

.contact-us-inner {
    border-radius: var(--radius-medium, 16px);
    background: linear-gradient(0deg, var(--accent-purple-light, #EAE8F9) -5.4%, var(--primary-yellow-100, #F6F3DF) 100%);
    padding: 60px 48px 38px 48px;
    margin: 20px auto 80px;
    max-width: 1258px;
}

.contact-us-header {
    text-align: center;
    margin-bottom: 40px;
}

.contact-us-heading {
    margin: 0 0 16px;
    color: var(--primary-slate-900, #21252A);
}

.contact-us-subheading {
    margin: 0;
    margin: 0 auto;
}

.contact-us-details h5 strong, .contact-us-details h5 {
    margin: 0;
    color: var(--color-text-primary, #121217);
    font-family: var(--purrkins-heading-font);
    font-size: 20px;
    font-weight: 700;
}

.contact-us-details strong {
    color: var(--color-text-primary, #121217);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.6;
}

.contact-us-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 60px;
    align-items: stretch;
}

.contact-us-info-col {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.contact-us-details {
    color: var(--color-text-secondary, #595961);
}

.contact-us-details p {
    margin: 0 0 16px;
    color: var(--color-text-primary, #121217);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.6;
}

.contact-us-illustration {
    max-width: 407px;
}

.contact-us-illustration img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
}

.contact-us-form-card {
padding: 48px;
    border-radius: var(--radius-medium, 16px);
    border: 1px solid var(--brand-slate-50, #F0F0F1);
    background: var(--color-background, #FFF);
}

/* WPCF7 Form Styling to match screenshot */
.contact-us-form-card .wpcf7-form {
    display: flex;
    flex-direction: column;
    gap: 28px;
}

.contact-us-form-card .form-row-2 {
    display: flex;
    gap: 24px;
}

.contact-us-form-card .form-row-2 > div {
    flex: 1;
}

.contact-us-form-card label {
    display: block;
    color: var(--color-text-secondary, #595961);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    margin-bottom: 8px;
}

.contact-us-form-card p {
    margin: 0;
}

.contact-us-form-card input[type="text"],
.contact-us-form-card input[type="email"],
.contact-us-form-card input[type="tel"],
.contact-us-form-card select,
.contact-us-form-card textarea {
    width: 100%;
    font-size: 16px;
    color: var(--primary-slate-900, #21252A);
    transition: border-color 0.3s;
    box-sizing: border-box;
    display: flex;
    height: 40px;
    padding: 6.803px 13.606px;
    font-family: var(--purrkins-primary-font);
    border-radius: var(--radius-medium, 16px);
    border: 0.3px solid var(--color-text-secondary, #595961);
    background: var(--color-background, #FFF);
}

.contact-us-form-card select {
    appearance: none;
    background-image: url('data:image/svg+xml;charset=US-ASCII,<svg width="12" height="8" viewBox="0 0 12 8" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1 1.5L6 6.5L11 1.5" stroke="%23595961" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>');
    background-repeat: no-repeat;
    background-position: right 20px center;
}

.contact-us-form-card textarea {
    resize: vertical;
    height: 120px;
    border-radius: var(--radius-medium, 16px);
    border: 0.3px solid var(--color-text-secondary, #595961);
    background: var(--color-background, #FFF);
}

.contact-us-form-card input:focus,
.contact-us-form-card select:focus,
.contact-us-form-card textarea:focus {
    outline: none;
    border-color: var(--primary-slate-900, #21252A);
}

.contact-us-form-card .wpcf7-submit {
margin: 0 auto;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    border-radius: 999px;
    background: var(--semantic-brand, #FFE330);
    display: inline-flex;
    padding: 16px 28px;
    justify-content: center;
    align-items: center;
    color: var(--semantic-text-primary, #21252A);
    font-family: var(--purrkins-heading-font);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.18px;
    border: none;
    cursor: pointer;
}

.contact-us-form-card .wpcf7-submit:hover {
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(255, 227, 48, 0.4);
}

.contact-us-form-card .submit-wrapper {
    text-align: center;
    margin-top: 8px;
}

.contact-us-details p:last-child{
    margin:0;
}

.purrkins-contact-us-block .wpcf7 .wpcf7-response-output {
    margin: 0;
}

@media (max-width: 991px) {
    .contact-us-grid {
            gap: 24px;
        display: flex;
        flex-direction: column-reverse;
    }
    .contact-us-illustration {
        margin: 40px auto 0;
        text-align: center;
    }
    .contact-us-illustration img {
        margin: 0 auto;
    }
    .contact-us-inner{
        background: none;
        padding: 0;
        border-radius: 0;
    }
    .contact-us-info-col {
    background: linear-gradient(141deg, #FFF6C3 0%, #F9F8F0 41.99%, #EAE8F9 75.94%);
    padding: 50px 20px;
}
.contact-us-header {
    padding: 0 20px;
    margin-bottom: 32px;
}
.contact-us-form-col {
     padding: 0 20px;
}
}

@media (max-width: 767px) {
    .contact-us-inner{
        margin: 32px auto 0;
    }
    .contact-us-form-card {
        padding: 0;
        border: none;
    }
    .contact-us-form-card .form-row-2 {
        flex-direction: column;
        gap: 16px;
    }
    .contact-us-form-card .wpcf7-form{
        gap: 16px;
    }
    .contact-us-illustration {
    display: none;
}
.contact-us-info-col{
    text-align: center;
}
.contact-us-form-card label{
    font-size: 14px;
}
}
@media(max-width: 480px){
    .contact-us-form-card .wpcf7-submit {
    width: 100%;
}
}
</style>

{% schema %}
{
  "name": "Purrkins Contact Us",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in touch"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Questions about your kitten's food, order, or plan? Send us a note; we'll reply within one working day."
    },
    {
      "type": "richtext",
      "id": "contact_details",
      "label": "Contact Details",
      "default": "<p><strong>Contact</strong><br>Email: hello@purrkins.com</p>"
    },
    {
      "type": "image_picker",
      "id": "illustration",
      "label": "Illustration Image"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom CSS Class"
    }
  ],
  "presets": [
    {
      "name": "Purrkins Contact Us"
    }
  ]
}
{% endschema %}
