<div class="purrkins-quiz-results-section" style="background-color: #F8F8F8; padding: 60px 20px;">
  <div class="purrkins-container" style="max-width: 1196px; margin: 0 auto;">
    {% if customer %}
      <div class="quiz-results-card">
        <div class="quiz-results-header">
          <div>
            <h2 class="quiz-results-title">Your quiz answers</h2>
            <p class="quiz-results-meta">Everything below is built from these answers.</p>
          </div>
          <a href="/pages/byob" class="purrkins-btn-secondary retake-quiz-btn">Retake Quiz</a>
        </div>

        <div class="quiz-pills-container">
          {% assign note_lines = customer.note | split: '
' %}
          {% assign kitten_name = 'your kitten' %}
          
          {% for line in note_lines %}
            {% assign key_value = line | split: ': ' %}
            {% if key_value.size >= 2 %}
              {% assign key = key_value[0] | strip %}
              {% assign val = key_value[1] | strip %}
              
              {% if key == 'Kitten Name' %}
                {% assign kitten_name = val %}
              {% elsif key == 'Focus Areas' %}
                {% assign areas = val | split: ', ' %}
                {% for area in areas %}
                  <span class="quiz-pill">{{ area }}</span>
                {% endfor %}
              {% elsif key == 'Allergies' %}
                <!-- skip allergies pill or show if short? -->
              {% else %}
                <span class="quiz-pill">
                  {% if key == 'Age' or key == 'Weight' %}
                    {{ key }} • {{ val }}
                  {% else %}
                    {{ val }}
                  {% endif %}
                </span>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>

        <div class="quiz-recommendations-section">
          <h2 class="quiz-results-title">Recommend for {{ kitten_name }}</h2>
          <div class="quiz-recommendations-grid">
            {% for block in section.blocks %}
              {% if block.type == 'product' %}
                {% assign prod = all_products[block.settings.product] %}
                {% if prod != blank %}
                  <div class="quiz-rec-card" style="background-color: {{ block.settings.bg_color }};">
                    <div class="quiz-rec-image">
                      <img src="{{ prod.featured_image | image_url: width: 200 }}" alt="{{ prod.title }}" width="100" height="100" loading="lazy">
                    </div>
                    <div class="quiz-rec-content">
                      <h3>{{ prod.title }}</h3>
                      <p>{{ block.settings.description | default: prod.metafields.custom.short_description | default: 'Nourishing fuel for your kitten.' }}</p>
                      
                      <form method="post" action="/cart/add" class="quiz-rec-form">
                        <input type="hidden" name="id" value="{{ prod.variants.first.id }}">
                        <button type="submit" class="quiz-rec-btn">Add to Cart</button>
                      </form>
                    </div>
                  </div>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    {% else %}
      <div class="quiz-results-card" style="text-align: center;">
        <h2 class="quiz-results-title">Sign in to view your quiz results</h2>
        <a href="/account/login" class="purrkins-btn-primary" style="margin-top: 20px; display: inline-block;">Log In</a>
      </div>
    {% endif %}
  </div>
</div>

<style>
.quiz-results-card {
  background: #FFF;
  border-radius: 20px;
  padding: 40px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.05);
}

.quiz-results-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 30px;
}

.quiz-results-title {
  font-family: var(--purrkins-heading-font);
  font-size: 32px;
  font-weight: 700;
  color: #121217;
  margin: 0 0 10px 0;
}

.quiz-results-meta {
  color: #595961;
  font-size: 16px;
  margin: 0;
}

.retake-quiz-btn {
  background: transparent;
  border: 2px solid #121217;
  color: #121217;
  border-radius: 30px;
  padding: 10px 24px;
  font-weight: 600;
  text-decoration: none;
  font-size: 16px;
  transition: all 0.2s;
}

.retake-quiz-btn:hover {
  background: #121217;
  color: #FFF;
}

.quiz-pills-container {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 50px;
}

.quiz-pill {
  background: #F4F4F5;
  color: #121217;
  padding: 8px 20px;
  border-radius: 20px;
  font-size: 16px;
  font-weight: 600;
}

.quiz-recommendations-section {
  border-top: 1px solid #EAEAEA;
  padding-top: 40px;
}

.quiz-recommendations-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  margin-top: 30px;
}

.quiz-rec-card {
  border-radius: 20px;
  padding: 30px;
  display: flex;
  flex-direction: column;
}

.quiz-rec-image {
  background: #FFF;
  border-radius: 16px;
  width: 80px;
  height: 80px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24px;
}

.quiz-rec-image img {
  max-width: 60px;
  max-height: 60px;
  object-fit: contain;
}

.quiz-rec-content h3 {
  font-family: var(--purrkins-heading-font);
  font-size: 24px;
  font-weight: 700;
  color: #121217;
  margin: 0 0 12px 0;
}

.quiz-rec-content p {
  color: #595961;
  font-size: 16px;
  line-height: 1.5;
  margin: 0 0 24px 0;
  flex-grow: 1;
}

.quiz-rec-btn {
  background: #21252A;
  color: #FFF;
  border: none;
  border-radius: 30px;
  padding: 12px 24px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  width: auto;
  display: inline-block;
  transition: opacity 0.2s;
}

.quiz-rec-btn:hover {
  opacity: 0.9;
}

@media (max-width: 768px) {
  .quiz-results-header {
    flex-direction: column;
    gap: 20px;
  }
  .quiz-recommendations-grid {
    grid-template-columns: 1fr;
  }
}
</style>

{% schema %}
{
  "name": "Quiz Results Profile",
  "settings": [],
  "blocks": [
    {
      "type": "product",
      "name": "Recommended Product",
      "limit": 3,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Card Background Color",
          "default": "#EAF6F0"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Custom Description",
          "info": "Leave blank to use product default"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Quiz Results Profile"
    }
  ]
}
{% endschema %}
