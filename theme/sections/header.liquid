<style>
#header-group {
  position: sticky;
  top: 0;
  z-index: 999;
}
.site-header {
  position: relative;
}
.infobar {
  background-color: var(--primary-slate-900);
  padding: 8px;
  text-align: center;
  color: var(--neutral-white, #FFF);
  font-size: 16px;
  font-style: normal;
  font-weight: 400;
  line-height: 1.5;
}
.main-header {
  background-color: var(--semantic-brand);
  color: var(--semantic-text-primary);
}
.header-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 17px 20px;
}
.main-header a {
  color: var(--semantic-text-primary);
  text-decoration: none;
}
.header-left, .header-right {
  display: flex;
  align-items: center;
  gap: 24px;
}
.header-nav ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  gap: 32px;
}
.header-nav a {
  color: var(--semantic-text-primary, #21252A);
  font-size: 20px;
  font-weight: 500;
  line-height: 1.4;
}
.header-center {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
}
.btn-build-box {
  padding: 10px 20px;
  display: flex;
  align-items: center;
  gap: 8px;
  border-radius: var(--radius-pill, 999px);
  background: var(--neutral-white, #FFF);
  font-family: var(--purrkins-heading-font);
  font-size: 18px;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: 0.18px;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.btn-build-box:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgb(33 37 42 / 40%);
}

.header-icons {
  display: flex;
  gap: 24px;
  align-items: center;
}
.header-icon {
  width: 32px;
  height: 32px;
}
.header-cart-count {
  position: absolute;
  top: -4px;
  right: -8px;
  background-color: #121217;
  color: #fff;
  font-size: 11px;
  font-weight: 600;
  border-radius: 50%;
  width: 18px;
  height: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.site-branding .header-logo-image {
  display: flex;
}
/* Mobile Menu Toggle */
.mobile-menu-toggle {
  display: none;
  background: none;
  border: none;
  cursor: pointer;
  padding: 10px;
  z-index: 101;
}
.hamburger-box {
  width: 32px;
  height: 20px;
  display: inline-block;
  position: relative;
}
.hamburger-inner, .hamburger-inner::before, .hamburger-inner::after {
  width: 24px;
  height: 3px;
  background-color: var(--semantic-text-primary);
  position: absolute;
  transition: transform 0.15s ease, opacity 0.15s ease, left 0.15s ease;
  border-radius: 4px;
}
.hamburger-inner {
  top: 50%;
  margin-top: -1.5px;
  left: 0;
}
.hamburger-inner::before {
  content: "";
  top: -8px;
  left: 0;
}
.hamburger-inner::after {
  content: "";
  bottom: -8px;
  left: 0;
}
.mobile-menu-toggle.is-active .hamburger-inner {
  background-color: transparent;
}
.mobile-menu-toggle.is-active .hamburger-inner::before {
  transform: translateY(8px) rotate(45deg);
  left: 4px;
}
.mobile-menu-toggle.is-active .hamburger-inner::after {
  transform: translateY(-8px) rotate(-45deg);
  left: 4px;
}

@media (max-width: 991px) {
  .header-nav { display: none; }
  .header-nav.is-active {
    display: flex;
position: absolute;
        top: 100%;
        left: 0;
        width: 100%;
        background-color: #FFE330;
        padding: 20px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        z-index: 100;
        flex-direction: column;
  }
  .header-nav ul { flex-direction: column; gap: 16px; }
  .mobile-menu-toggle { display: block; }
  .btn-build-box span { display: none; }
  .btn-build-box { padding: 10px; }
  .header-center { margin-left: 16px; }
}
</style>

<header id="purrkins-header" class="site-header">
    {% if section.settings.infobar_content != blank %}
    <div class="infobar">
        {{ section.settings.infobar_content }}
    </div>
    {% endif %}
    
    <div class="main-header">
        <div class="purrkins-container header-inner">
            <div class="header-left">
                <button id="mobile-menu-toggle" class="mobile-menu-toggle" aria-label="Toggle menu">
                    <span class="hamburger-box">
                        <span class="hamburger-inner"></span>
                    </span>
                </button>
                <nav id="site-navigation" class="header-nav">
                    <ul>
                      {% for link in linklists[section.settings.menu].links %}
                        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                      {% endfor %}
                    </ul>
                </nav>
            </div>
            
            <div class="header-center">
                <div class="site-branding">
                    <a href="{{ routes.root_url }}" rel="home" class="header-logo-image">
                        {% if section.settings.logo != blank %}
                            <img src="{{ section.settings.logo | image_url: width: 400 }}" alt="{{ section.settings.logo.alt | default: shop.name | escape }}" width="{{ section.settings.logo_width }}" height="auto" />
                        {% else %}
                            <span style="font-size: 24px; font-weight: 800;">{{ shop.name }}</span>
                        {% endif %}
                    </a>
                </div>
            </div>
            
            <div class="header-right">
                {% if section.settings.header_button_text != blank %}
                <a href="{{ section.settings.header_button_link }}" class="btn-build-box">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                        <path d="M5.10156 11.1312L12.0938 13.449C12.2981 13.5167 12.5188 13.5167 12.7231 13.449L19.7153 11.1312" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round"/>
                        <path d="M12.4082 13.5531V22.0312" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round"/>
                        <path d="M12.095 21.9271C12.2993 21.9948 12.52 21.9948 12.7243 21.9271L19.0312 19.8365C19.4403 19.7008 19.7165 19.3183 19.7165 18.8873V15.8904C19.7165 15.4594 19.9927 15.0769 20.4019 14.9412L20.6076 14.873C21.2239 14.6687 21.4851 13.9405 21.1392 13.391L19.9076 11.4348C19.7841 11.2385 19.5962 11.0913 19.376 11.0183L12.7243 8.8134C12.52 8.74568 12.2993 8.74568 12.095 8.8134L5.44331 11.0183C5.22317 11.0913 5.03524 11.2385 4.91169 11.4348L3.6801 13.391C3.33421 13.9405 3.59544 14.6687 4.21171 14.873L4.41746 14.9412C4.8266 15.0769 5.1028 15.4594 5.1028 15.8904V18.8873C5.1028 19.3183 5.37901 19.7008 5.78816 19.8365L12.095 21.9271Z" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round"/>
                        <path d="M12.4084 13.5531L10.723 16.2304C10.4779 16.6197 9.99875 16.7916 9.56206 16.6468L5.10156 15.1682" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round"/>
                        <path d="M12.4082 13.5531L14.0937 16.2304C14.3388 16.6197 14.8179 16.7916 15.2546 16.6468L19.7151 15.1682" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round"/>
                        <path d="M12.4082 6.04398V2.00001" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round"/>
                        <path d="M8.6548 7.05038L6.63281 3.54822" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round"/>
                        <path d="M16.1631 7.05038L18.1851 3.54822" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round"/>
                    </svg>
                    <span>{{ section.settings.header_button_text }}</span>
                </a>
                {% endif %}
                
                <div class="header-icons">
                    <a href="{{ routes.search_url }}" aria-label="Search">
                        <svg class="header-icon" xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 21 21" fill="none">
                          <path d="M14.5853 11.0425C13.8951 13.2398 11.8418 14.834 9.41673 14.834C6.42509 14.834 4 12.4089 4 9.41753C4 6.42589 6.42509 4.00079 9.41673 4.00079C11.8421 4.00079 13.8951 5.59494 14.5853 7.79253" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M16.9992 17L13.2461 13.2468" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </a>
                    {% if shop.customer_accounts_enabled %}
                        <a href="{% if customer %}/pages/my-dashboard{% else %}{{ routes.account_login_url }}?return_to=/pages/my-dashboard{% endif %}" aria-label="User Account">
                            <svg class="header-icon" xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 21 21" fill="none">
                              <path d="M10.5016 10.4992C12.2413 10.4992 13.6516 9.08892 13.6516 7.34922C13.6516 5.60952 12.2413 4.19922 10.5016 4.19922C8.76187 4.19922 7.35156 5.60952 7.35156 7.34922C7.35156 9.08892 8.76187 10.4992 10.5016 10.4992Z" stroke="#21252A" stroke-width="1.5"/>
                              <path d="M4.19922 17.5004C4.5968 16.1373 5.42578 14.9398 6.56172 14.0879C7.69766 13.2359 9.07929 12.7754 10.4992 12.7754C11.9191 12.7754 13.3008 13.2359 14.4367 14.0879C15.5727 14.9398 16.4016 16.1373 16.7992 17.5004" stroke="#21252A" stroke-width="1.5" stroke-linecap="round"/>
                            </svg>
                        </a>
                    {% endif %}
                    <a href="{{ routes.cart_url }}" class="header-cart-link" aria-label="Cart" style="position: relative;" id="cart-icon-bubble">
                        <svg class="header-icon" xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 21 21" fill="none">
                          <path d="M3.5 5.25H5.25L6.65 14.35C6.73181 14.7512 6.95174 15.1111 7.2715 15.3669C7.59126 15.6227 7.99059 15.7583 8.4 15.75H15.3125C15.7345 15.7548 16.1441 15.6069 16.4657 15.3335C16.7873 15.0602 16.9992 14.6798 17.0625 14.2625L18.025 7.875H6.125" stroke="#21252A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                          <path d="M8.74844 19.6004C9.42499 19.6004 9.97344 19.0519 9.97344 18.3754C9.97344 17.6988 9.42499 17.1504 8.74844 17.1504C8.07189 17.1504 7.52344 17.6988 7.52344 18.3754C7.52344 19.0519 8.07189 19.6004 8.74844 19.6004Z" fill="#21252A"/>
                          <path d="M15.3109 19.6004C15.9875 19.6004 16.5359 19.0519 16.5359 18.3754C16.5359 17.6988 15.9875 17.1504 15.3109 17.1504C14.6344 17.1504 14.0859 17.6988 14.0859 18.3754C14.0859 19.0519 14.6344 19.6004 15.3109 19.6004Z" fill="#21252A"/>
                        </svg>
                        {% if cart.item_count > 0 %}
                            <span class="header-cart-count">{{ cart.item_count }}</span>
                        {% endif %}
                    </a>
                </div>
            </div>
        </div>
    </div>
</header>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var toggle = document.getElementById('mobile-menu-toggle');
        var nav = document.getElementById('site-navigation');
        if(toggle && nav) {
            toggle.addEventListener('click', function(e) {
                e.preventDefault();
                toggle.classList.toggle('is-active');
                nav.classList.toggle('is-active');
            });
        }
    });
</script>

{% schema %}
{
  "name": "Purrkins Header",
  "class": "section-header",
  "settings": [
    {
      "type": "text",
      "id": "infobar_content",
      "label": "Announcement Bar Text",
      "default": "Subscribe and get your 20% off for your first purchase | Free delivery over ₹999"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 250,
      "step": 10,
      "default": 130,
      "unit": "px",
      "label": "Custom logo width"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "header_button_text",
      "label": "Button Text",
      "default": "Build Your Own Box"
    },
    {
      "type": "url",
      "id": "header_button_link",
      "label": "Button Link"
    }
  ]
}
{% endschema %}
