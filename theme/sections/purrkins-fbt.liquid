{{ 'purrkins-fbt.css' | asset_url | stylesheet_tag }}

{% assign fbt_products = product.metafields.custom.frequently_bought_together.value %}

{% if fbt_products != blank %}
<div class="pf-fbt-section purrkins-container purrkins-section-block">
    <h3 class="pf-fbt-heading purrkins-h3-text">{{ section.settings.heading | escape }}</h3>
    
    <div class="swiper pf-fbt-swiper">
        <div class="pf-fbt-grid swiper-wrapper">
            {% for fbt_product in fbt_products %}
                {%- comment -%} Determine badge text and colors based on the product's first collection {%- endcomment -%}
                {% assign collection = fbt_product.collections.first %}
                {% assign badge_text = collection.title %}
                {% assign card_bg_color = collection.metafields.custom.card_bg_color.value | default: '#f0f8ff' %}
                {% assign card_main_color = collection.metafields.custom.card_primary_color.value | default: '#0070f3' %}
                
                <div class="pf-product-card-wrap swiper-slide">
                    <div class="pf-product-card" style="background-color: {{ card_bg_color }};">
                        {% if badge_text != blank %}
                            <span class="pf-product-badge" style="background-color: {{ card_bg_color }}; border: 1px solid {{ card_main_color }}; color: {{ card_main_color }};">
                                {{ badge_text | escape }}
                            </span>
                        {% endif %}
                        
                        <a href="{{ fbt_product.url }}" class="pf-product-image">
                            {{ fbt_product.featured_image | image_url: width: 600 | image_tag: alt: fbt_product.title, loading: 'lazy' }}
                        </a>
                    </div>
                    
                    <div class="pf-product-info pf-fbt-info">
                        <h4 class="pf-product-title purrkins-h6-text">
                            <a href="{{ fbt_product.url }}">{{ fbt_product.title | escape }}</a>
                        </h4>
                        <div class="pf-product-price">
                            <span class="price-val">{{ fbt_product.price | money }}</span>
                            <span class="price-sep">|</span>
                            <span class="price-size">
                                {% if fbt_product.variants.first.weight > 0 %}
                                    {{ fbt_product.variants.first.weight | weight_with_unit }}
                                {% else %}
                                    70g
                                {% endif %}
                            </span>
                        </div>
                        <div class="pf-product-excerpt">
                            {{ fbt_product.metafields.custom.short_description.value | default: 'Real broth for daily hydration' | escape }}
                        </div>
                        
                        <div class="pf-fbt-action">
                            <form method="post" action="/cart/add">
                                <input type="hidden" name="id" value="{{ fbt_product.variants.first.id }}">
                                <button type="submit" class="pf-add-to-cart-btn pf-fbt-add-btn purrkins-btn-primary">
                                    Add to Cart
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
                
                {% unless forloop.last %}
                    <div class="pf-fbt-plus">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
                            <path d="M12 4V20M4 12H20" stroke="#121217" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </div>
                {% endunless %}
                
            {% endfor %}
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var fbtSwiperInstance = null;

    function initFbtSwiper() {
        if (window.matchMedia('(max-width: 991px)').matches) {
            if (!fbtSwiperInstance && typeof Swiper !== 'undefined') {
                fbtSwiperInstance = new Swiper('.pf-fbt-swiper', {
                    slidesPerView: 'auto',
                    spaceBetween: 16,
                    observer: true,
                    observeParents: true,
                });
            }
        } else {
            if (fbtSwiperInstance) {
                fbtSwiperInstance.destroy(true, true);
                fbtSwiperInstance = null;
            }
        }
    }

    initFbtSwiper();
    window.addEventListener('resize', initFbtSwiper);
});
</script>
{% endif %}

{% schema %}
{
  "name": "Bought Together",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What your fellow kitten parents are pairing together"
    },
    {
      "type": "header",
      "content": "Dynamic Setup",
      "info": "To power this section, create a Product Metafield called 'frequently_bought_together' (Namespace: 'custom') of type 'List of products'."
    }
  ],
  "presets": [
    {
      "name": "Bought Together"
    }
  ]
}
{% endschema %}
