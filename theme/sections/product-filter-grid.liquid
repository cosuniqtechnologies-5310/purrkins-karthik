    font-family: var(--purrkins-heading-font);
    font-size: 16px;
    font-weight: 700;
    line-height: 20px;
  }
  .pf-cat-btn:hover {
    opacity: 0.85;
  }
  .pf-cat-btn.active {
    background: var(--dynamic-color, #558a29);
    border-color: var(--dynamic-color, #558a29);
    color: #ffffff;
  }
  .pf-cat-btn.active svg {
    color: #ffffff;
  }
  .pf-cat-btn .pf-cat-icon {
    width: 54px;
    height: 54px;
    object-fit: contain;
    transition: all 0.2s ease;
  }
