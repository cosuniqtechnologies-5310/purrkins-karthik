<div id="product-filter-{{ section.id }}" class="product-filter-block {{ section.settings.custom_class }}">
  <div class="purrkins-container pf-container purrkins-section-block">
    <div class="pf-header">
      <h2 class="pf-heading purrkins-h2-text purrkins-heading-mb">{{ section.settings.heading }}</h2>
      <p class="pf-subheading purrkins-subtext">{{ section.settings.subheading }}</p>
    </div>

    <div class="pf-controls-row">
      <div class="pf-filter-left">
        {% for block in section.blocks %}
          {% if block.type == 'category' and block.settings.collection != blank %}
            {% assign cat_collection = block.settings.collection %}
            {% assign cat_bg = cat_collection.metafields.custom.card_bg_color | default: '#F4F7FB' %}
            {% assign cat_main = cat_collection.metafields.custom.card_primary_color | default: '#424953' %}
            {% assign cat_icon = cat_collection.image %}

            <button
              type="button"
              class="pf-cat-btn"
              data-slug="{{ cat_collection.handle }}"
              style="--dynamic-color: {{ cat_main }}; --dynamic-bg: {{ cat_bg }};"
              {{ block.shopify_attributes }}
            >
              {% if cat_icon != blank %}
                <img
                  src="{{ cat_icon | image_url: width: 48 }}"
                  alt="{{ cat_collection.title | escape }}"
                  width="24"
                  height="24"
                  class="pf-cat-icon"
                >
              {% endif %}
              <span>{{ cat_collection.title }}</span>
            </button>
          {% endif %}
        {% endfor %}
      </div>
      <div class="pf-filter-right">
        <div class="pf-tags-dropdown-toggle" id="pf-tags-mobile-toggle">
          <span id="pf-tags-selected-text">Filter by Benefit</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M5 7.5L10 12.5L15 7.5" stroke="#121217" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="pf-tags-wrapper" id="pf-tags-wrapper">
          {% assign unique_benefits = '' %}
          {% for block in section.blocks %}
            {% if block.type == 'category' and block.settings.collection != blank %}
              {% for product in block.settings.collection.products limit: 12 %}
                {% assign prod_benefit = product.metafields.custom.benefit %}
                {% if prod_benefit != blank %}
                  {% assign benefit_with_delim = prod_benefit | append: '|||' %}
                  {% unless unique_benefits contains benefit_with_delim %}
                    {% assign unique_benefits = unique_benefits | append: benefit_with_delim %}
                  {% endunless %}
                {% endif %}
              {% endfor %}
            {% endif %}
          {% endfor %}

          {% assign benefit_array = unique_benefits | split: '|||' %}
          {% for benefit in benefit_array %}
            <button type="button" class="pf-tag-pill" data-slug="{{ benefit | handle }}">
              {{ benefit }}
            </button>
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="pf-products-carousel swiper" id="pf-products-carousel-{{ section.id }}">
      <div class="pf-products-grid swiper-wrapper" id="pf-products-grid-{{ section.id }}">
        {% assign rendered_products = '' %}
        {% for block in section.blocks %}
          {% if block.type == 'category' and block.settings.collection != blank %}
            {% assign collection_to_use = block.settings.collection %}
            {% for product in collection_to_use.products limit: 12 %}
              {% assign prod_id_string = product.id | append: '' %}
              {% unless rendered_products contains prod_id_string %}
                {% render 'purrkins-filter-card', product: product, current_collection: collection_to_use %}
                {% assign rendered_products = rendered_products | append: prod_id_string | append: ',' %}
              {% endunless %}
            {% endfor %}
          {% endif %}
        {% endfor %}

        {% if rendered_products == '' %}
          <p class="pf-no-products swiper-slide">
            No products found. Please assign collections with products in the section settings.
          </p>
        {% endif %}
      </div>
    </div>

    <!-- Inline Quick View Container -->
    <div id="pf-quick-view-container-{{ section.id }}" class="pf-quick-view-container"></div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const sectionId = '{{ section.id }}';
    const container = document.getElementById('product-filter-' + sectionId);
    if (!container) return;

    const catBtns = container.querySelectorAll('.pf-cat-btn');
    const tagPills = container.querySelectorAll('.pf-tag-pill');
    const productsGrid = container.querySelector('#pf-products-grid-' + sectionId);
    const allCards = Array.from(productsGrid.querySelectorAll('.pf-product-card-wrap'));

    let activeCat = '';
    let activeTags = [];
    let productSwiper;

    function initSwiper() {
      if (productSwiper) {
        productSwiper.destroy(true, true);
      }
      productSwiper = new Swiper('#pf-products-carousel-' + sectionId, {
        slidesPerView: 'auto',
        spaceBetween: 20,
        loop: false,
        grabCursor: true,
        breakpoints: {
          576: { spaceBetween: 20 },
          992: { spaceBetween: 30 },
        },
      });
    }

    // Inline Quick View Logic
    const qvContainer = document.getElementById('pf-quick-view-container-' + sectionId);

    function closeQuickView() {
      if (!qvContainer) return;
      qvContainer.style.maxHeight = '0px';
      qvContainer.style.opacity = '0';
      qvContainer.style.opacity = '0';
      qvContainer.setAttribute('data-current-product', '');
    }

    function openQuickView(url, productId) {
      if (!qvContainer) return;

      // Show loading state
      qvContainer.innerHTML = '<div class="pf-qv-loading"><span class="qv-spinner"></span></div>';
      qvContainer.style.maxHeight = '300px';
      qvContainer.style.opacity = '1';
      qvContainer.style.opacity = '1';

      fetch(`${url}?section_id=main-product-quick-view`)
        .then((res) => res.text())
        .then((html) => {
          const parser = new DOMParser();
          const doc = parser.parseFromString(html, 'text/html');
          const newContent = doc.getElementById(`shopify-section-main-product-quick-view`);

          if (newContent) {
            qvContainer.innerHTML = newContent.innerHTML;
            qvContainer.setAttribute('data-current-product', productId);

            // Set height to scroll height for smooth animation
            setTimeout(() => {
              qvContainer.style.maxHeight = qvContainer.scrollHeight + 100 + 'px';
            }, 50);
          } else {
            qvContainer.innerHTML = '<div style="text-align: center;">Error loading product.</div>';
          }
        })
        .catch((err) => {
          console.error(err);
          qvContainer.innerHTML = '<div style="text-align: center;">Error loading product.</div>';
        });
    }

    // Auto-open first product
    function openFirstProduct() {
      const firstCard = productsGrid.querySelector('.pf-product-card-wrap');
      if (firstCard) {
        const url = firstCard.querySelector('.pf-product-image').getAttribute('href');
        const pId = firstCard.getAttribute('data-product-id');
        if (url && pId) {
          openQuickView(url, pId);
        }
      }
    }

    // Init on load
    initSwiper();
    setTimeout(openFirstProduct, 500); // slight delay to ensure DOM is ready

    // Event delegation for clicks on product cards
    productsGrid.addEventListener('click', function (e) {
      // Find if we clicked on a card link
      const link = e.target.closest('a.pf-product-image, h4.pf-product-title a');
      if (!link) return;

      const cardWrap = link.closest('.pf-product-card-wrap');
      if (!cardWrap) return;

      e.preventDefault();

      const url = link.getAttribute('href');
      const productId = cardWrap.getAttribute('data-product-id');

      if (qvContainer.getAttribute('data-current-product') === productId) {
        if (qvContainer.style.maxHeight !== '0px') {
          closeQuickView();
          return;
        }
      }

      openQuickView(url, productId);

      // Optionally scroll to container
      setTimeout(() => {
        qvContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }, 100);
    });

    // Event delegation for the Bowl Modal inside Quick View
    if (qvContainer) {
      // Intercept Quick View Add to Cart form submissions
      qvContainer.addEventListener('submit', function (e) {
        const form = e.target;
        if (form && form.action && form.action.includes('/cart/add')) {
          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();

          const btn = form.querySelector('.btn-add-to-cart');
          const formData = new FormData(form);
          if (window.purrkinsAddToCart) {
            window.purrkinsAddToCart(null, btn, formData);
          } else {
            console.error('purrkinsAddToCart is not defined');
          }
        }
      });

      // Listen for quantity changes to update price
      qvContainer.addEventListener('change', function (e) {
        const nativeSelect = e.target;
        if (nativeSelect.name === 'quantity') {
          const qty = parseInt(nativeSelect.value, 10);
          const form = nativeSelect.closest('form');
          if (form) {
            const priceDisplay = form.querySelector('.pf-qv-price-display');
            if (priceDisplay) {
              const basePrice = parseInt(priceDisplay.getAttribute('data-base-price'), 10);
              if (!isNaN(basePrice) && !isNaN(qty)) {
                const newPrice = basePrice * qty;
                // Shopify price is in cents/paise
                const formattedPrice = '₹' + (newPrice / 100).toString();
                priceDisplay.innerText = formattedPrice;
              }
            }
          }
        }
      });

      qvContainer.addEventListener('click', function (e) {
        // Handle "What's in the bowl" click
        const btnBowl = e.target.closest('.pf-btn-bowl');
        if (btnBowl) {
          const currentProductId = qvContainer.getAttribute('data-current-product');
          const bowlModal = qvContainer.querySelector('#pf-bowl-modal-' + currentProductId);
          if (bowlModal) {
            bowlModal.style.display = 'flex';
            setTimeout(() => bowlModal.classList.add('visible'), 10);
          }
        }

        // Handle modal close
        const btnClose = e.target.closest('.pf-bowl-close');
        const overlay = e.target.classList.contains('pf-bowl-overlay') ? e.target : null;
        if (btnClose || overlay) {
          const currentProductId = qvContainer.getAttribute('data-current-product');
          const bowlModal = qvContainer.querySelector('#pf-bowl-modal-' + currentProductId);
          if (bowlModal) {
            bowlModal.classList.remove('visible');
            setTimeout(() => (bowlModal.style.display = 'none'), 300);
          }
        }

        // Handle tab switching
        const tabBtn = e.target.closest('.pf-bowl-tab');
        if (tabBtn) {
          const currentProductId = qvContainer.getAttribute('data-current-product');
          const bowlModal = qvContainer.querySelector('#pf-bowl-modal-' + currentProductId);
          if (bowlModal) {
            const tabs = bowlModal.querySelectorAll('.pf-bowl-tab');
            const contents = bowlModal.querySelectorAll('.pf-bowl-tab-content');

            tabs.forEach((t) => t.classList.remove('active'));
            contents.forEach((c) => c.classList.remove('active'));

            tabBtn.classList.add('active');
            const targetContent = bowlModal.querySelector('#' + tabBtn.dataset.target);
            if (targetContent) targetContent.classList.add('active');
          }
        }

        // Custom Select dropdown logic for Quick View
        const selectTrigger = e.target.closest('.pf-custom-select-trigger');
        if (selectTrigger) {
          const selectContainer = selectTrigger.closest('.pf-custom-select-container');
          if (selectContainer) selectContainer.classList.toggle('open');
        } else {
          const openSelects = qvContainer.querySelectorAll('.pf-custom-select-container.open');
          openSelects.forEach((c) => {
            // Only close if we didn't click inside an option (handled below)
            if (!e.target.closest('.pf-custom-select-option')) {
              c.classList.remove('open');
            }
          });
        }

        const selectOption = e.target.closest('.pf-custom-select-option');
        if (selectOption) {
          const selectContainer = selectOption.closest('.pf-custom-select-container');
          if (selectContainer) {
            const selectLabel = selectContainer.querySelector('.pf-custom-select-label');
            const nativeSelect = selectContainer.parentElement.querySelector('select[name="quantity"]');

            if (selectLabel) selectLabel.innerText = selectOption.innerText;
            if (nativeSelect) {
              nativeSelect.value = selectOption.getAttribute('data-value');
              nativeSelect.dispatchEvent(new Event('change', { bubbles: true }));
            }
            selectContainer.classList.remove('open');
          }
        }
      });
    }

    function filterProducts() {
      // Clear the grid completely
      productsGrid.innerHTML = '';

      let hasVisibleCards = false;

      // Re-append only matching cards
      allCards.forEach((card) => {
        const cardCat = card.getAttribute('data-category') || '';
        const cardBenefit = card.getAttribute('data-benefit') || '';
        const cardBenefitSlug = cardBenefit
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/(^-|-$)/g, '');

        let catMatch = true;
        if (activeCat !== '') {
          catMatch = cardCat === activeCat;
        }

        let tagMatch = true;
        if (activeTags.length > 0) {
          tagMatch = activeTags.includes(cardBenefitSlug);
        }

        if (catMatch && tagMatch) {
          card.style.display = ''; // Ensure it's visible
          productsGrid.appendChild(card);
          hasVisibleCards = true;
        }
      });

      // If no cards match, we can show a 'No products' message if we had one
      // (Optional: handle empty state here if needed)

      // Re-init swiper to recalculate layout perfectly
      initSwiper();
    }

    catBtns.forEach((btn) => {
      btn.addEventListener('click', function () {
        if (this.classList.contains('active')) {
          this.classList.remove('active');
          activeCat = '';
        } else {
          catBtns.forEach((b) => b.classList.remove('active'));
          this.classList.add('active');
          activeCat = this.getAttribute('data-slug');
        }
        filterProducts();
      });
    });

    tagPills.forEach((pill) => {
      pill.addEventListener('click', function () {
        const slug = this.getAttribute('data-slug');

        if (this.classList.contains('active')) {
          this.classList.remove('active');
          activeTags = activeTags.filter((t) => t !== slug);
        } else {
          this.classList.add('active');
          if (!activeTags.includes(slug)) {
            activeTags.push(slug);
          }
        }

        // Update mobile dropdown text
        const toggleText = container.querySelector('#pf-tags-selected-text');
        if (toggleText) {
          if (activeTags.length > 0) {
            const firstActive = container.querySelector(`.pf-tag-pill[data-slug="${activeTags[0]}"]`);
            if (firstActive) {
              toggleText.textContent =
                firstActive.textContent.trim() + (activeTags.length > 1 ? ` (+${activeTags.length - 1})` : '');
            }
          } else {
            toggleText.textContent = 'Filter by Benefit';
          }
        }

        // Close dropdown on mobile after selection
        const tagsWrapper = container.querySelector('#pf-tags-wrapper');
        if (tagsWrapper) {
          if (window.innerWidth <= 767) {
            tagsWrapper.classList.remove('is-open');
          }
        }

        filterProducts();
      });
    });

    const mobileToggle = container.querySelector('#pf-tags-mobile-toggle');
    const tagsWrapper = container.querySelector('#pf-tags-wrapper');
    if (mobileToggle && tagsWrapper) {
      mobileToggle.addEventListener('click', function (e) {
        e.stopPropagation();
        tagsWrapper.classList.toggle('is-open');
      });
      document.addEventListener('click', function (e) {
        if (!mobileToggle.contains(e.target) && !tagsWrapper.contains(e.target)) {
          tagsWrapper.classList.remove('is-open');
        }
      });
    }
  });
</script>

<style>
