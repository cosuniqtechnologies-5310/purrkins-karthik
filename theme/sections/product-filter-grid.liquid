  .pf-product-price .price-val {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .pf-product-price .price-sep {
    font-size: 18px;
    font-weight: 400;
    color: #e0e0e3;
  }
  .pf-product-price .price-size {
    font-size: 18px;
    font-weight: 500;
    color: var(--semantic-text-primary, #21252a);
  }

  @media (max-width: 991px) {
    .pf-controls-row {
      flex-direction: column;
      align-items: flex-start;
      margin-bottom: 40px;
      gap: 25px;
    }
    .pf-filter-right {
      justify-content: center;
    }
    .pf-tags-wrapper {
      justify-content: flex-start;
    }
    .pf-header {
      margin-bottom: 24px;
    }
  }

  .pf-products-grid {
    padding-bottom: 20px;
  }

  /* Inline Quick View Container */
  .pf-quick-view-container {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: max-height 0.5s ease-in-out, opacity 0.5s ease-in-out, padding 0.5s ease-in-out;
    background: #ffffff;
    border-radius: 24px;
    margin-top: 60px;
  }
  .pf-qv-loading {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 150px;
  }
  .qv-spinner {
    display: inline-block;
    width: 30px;
    height: 30px;
    border: 3px solid rgba(0, 0, 0, 0.1);
    border-radius: 50%;
    border-top-color: var(--color-text-primary);
    animation: spin 1s ease-in-out infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (max-width: 767px) {
    .pf-controls-row {
      align-items: center;
    }
    .pf-header {
      text-align: center;
    }
    .pf-cat-btn {
      min-width: unset;
      width: calc(50% - 5px);
    }
    .pf-product-price .price-val {
      font-size: 20px;
    }
    .pf-product-price .price-size {
      font-size: 16px;
    }
    .pf-filter-left {
      row-gap: 10px;
      column-gap: 9px;
    }
    .pf-product-excerpt {
      font-size: 14px;
    }
