    max-width: 260px;
    padding: 8.182px 16.364px;
  }
  .pf-tags-wrapper {
    display: flex;
    flex-wrap: wrap;
    row-gap: 11px;
    column-gap: 10px;
  }
  .pf-tag-pill {
    background: #fff;
    cursor: pointer;
    transition: all 0.2s ease;
    border-radius: 999px;
    border: 1px solid var(--primary-slate-300, #aaadb2);
    display: flex;
    padding: 4px 14px;
    justify-content: center;
    align-items: center;
    gap: 10px;
    color: var(--primary-slate-300, #aaadb2);
    font-size: 18px;
    font-weight: 500;
    line-height: 1.5;
    font-family: var(--purrkins-primary-font);
    min-width: 185px;
  }
  .pf-tag-pill:hover,
  .pf-tag-pill.active {
    border: 1px solid var(--primary-yellow-400, #f6e051);
    background: var(--primary-yellow-100, #f6f3df);
    color: var(--primary-yellow-800, #685b0c);
  }

  .product-filter-block {
    overflow-x: hidden;
  }
  .pf-products-carousel {
    position: relative;
    overflow: hidden !important;
    transition: opacity 0.3s ease;
    margin-right: calc(-50vw + 50%);
    width: calc(100% + (50vw - 50%)) !important;
  }
  .pf-products-grid .swiper-slide {
    width: calc((100vw - 40px) / 1.2);
    height: auto;
  }
  @media (min-width: 576px) {
