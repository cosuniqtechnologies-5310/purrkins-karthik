{% assign collection_to_use = product.collections.first %}
{% assign cat_main_color = collection_to_use.metafields.custom.card_primary_color | default: '#333' %}
{% assign cat_bg_color = collection_to_use.metafields.custom.card_bg_color | default: '#f9f9f9' %}
{% assign badge_text = collection_to_use.title | default: 'Product' %}
{% assign life_stage = product.metafields.custom.suitable_for_age | default: '3-week+' %}

<div class="pf-qv-inner" id="QuickView-{{ product.id }}">
  <!-- Left: Gallery -->
  <div style="flex: 1; display: flex; flex-direction: column; min-width: 0; max-width: 100%;">
    <div class="pf-qv-gallery">
      <div class="pf-qv-thumbnails-wrapper">
        <div
          class="pf-qv-thumbnails"
          style="-webkit-mask-image: linear-gradient(to bottom, black 75%, transparent 100%); mask-image: linear-gradient(to bottom, black 75%, transparent 100%);"
        >
          {% for media in product.media offset: 1 %}
            {% assign border_color = 'transparent' %}
            {% if forloop.first %}
              {% assign border_color = '#E1E2E3' %}
            {% endif %}
            <img
              src="{{ media | image_url: width: 120 }}"
              data-full="{{ media | image_url: width: 800 }}"
              width="60"
              height="60"
              class="pf-qv-thumb"
              style="border-color: {{ border_color }};"
              onclick="document.getElementById('pf-qv-main-img').src=this.getAttribute('data-full'); document.querySelectorAll('.pf-qv-thumb').forEach(el=>el.style.borderColor='transparent'); this.style.borderColor='#E1E2E3';"
            >
          {% endfor %}
        </div>
        <!-- Scroll Arrow -->
        {% if product.media.size > 3 %}
          <div
            class="pf-qv-scroll-arrow"
            style="position: absolute; bottom: -5px; left: 50%; transform: translateX(-50%); width: 40px; height: 40px; display: flex; justify-content: center; align-items: center; cursor: pointer; z-index: 10;"
            onclick="this.previousElementSibling.scrollBy({top: 100, behavior: 'smooth'})"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40" fill="none">
              <g clip-path="url(#clip0_4832_143720)">
                <path d="M36.3686 20.0012C36.3686 29.041 29.0404 36.3691 20.0007 36.3691C10.961 36.3691 3.63281 29.041 3.63281 20.0012C3.63281 10.9615 10.961 3.63335 20.0007 3.63335C29.0404 3.63335 36.3686 10.9615 36.3686 20.0012Z" fill="#21252A"/>
                <path d="M26 18L20.7071 23.2929C20.3166 23.6834 19.6834 23.6834 19.2929 23.2929L14 18" stroke="white" stroke-width="1.5" stroke-linecap="round"/>
              </g>
              <defs>
                <clipPath id="clip0_4832_143720">
                  <rect width="40" height="40" fill="white"/>
                </clipPath>
              </defs>
            </svg>
          </div>
        {% endif %}
      </div>
      <div class="pf-qv-main-image" style="position: relative;">
        {% if product.tags.size > 0 %}
          <div class="pf-qv-lifestage">
            {{ product.tags.last }}
          </div>
        {% endif %}

        <!-- Favourite Icon -->
        <button class="pf-qv-fav" data-product-id="{{ product.id }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="29" height="29" viewBox="0 0 29 29" fill="none">
            <path d="M15.1609 25.0003C14.7524 25.1445 14.0797 25.1445 13.6712 25.0003C10.1874 23.811 2.40268 18.8495 2.40268 10.4401C2.40268 6.72796 5.39401 3.72461 9.08212 3.72461C11.2686 3.72461 13.2027 4.78179 14.4161 6.41561C15.6294 4.78179 17.5756 3.72461 19.75 3.72461C23.4381 3.72461 26.4295 6.72796 26.4295 10.4401C26.4295 18.8495 18.6448 23.811 15.1609 25.0003Z" stroke="#21252A" stroke-width="1.80201" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>

        {% assign main_media = product.media[1] | default: product.featured_image %}
        <img
          id="pf-qv-main-img"
          src="{{ main_media | image_url: width: 800 }}"
          alt="{{ product.title | escape }}"
          width="{{ main_media.width }}"
          height="{{ main_media.height }}"
          loading="lazy"
        >
      </div>
    </div>
    <button class="pf-btn-bowl">What's in the bowl? +</button>
  </div>

  <!-- Right: Info -->
  <div class="pf-qv-info">
    <span
      class="pf-qv-badge"
      style="background-color: {{ cat_bg_color }}; border: 1px solid {{ cat_main_color }}; color: {{ cat_main_color }};"
    >
      {{- badge_text -}}
    </span>
    <h2 class="purrkins-h2-text purrkins-heading-mb">{{ product.title }}</h2>
    {% assign short_desc = product.metafields.custom.short_description | default: 'Real broth for daily hydration' %}
    {% if short_desc != blank %}
      <p class="purrkins-subtext">{{ short_desc | strip_html | truncatewords: 20 }}</p>
    {% endif %}

    <div class="pf-qv-info-bottom">
      <div class="pf-star-rating">
        <span>6.8k Reviews</span>
        <div style="display: flex;">
          {% for i in (1..5) %}
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M9.38457 1.86886C9.42023 1.79681 9.47532 1.73617 9.54361 1.69377C9.6119 1.65137 9.69069 1.62891 9.77107 1.62891C9.85145 1.62891 9.93024 1.65137 9.99853 1.69377C10.0668 1.73617 10.1219 1.79681 10.1576 1.86886L12.0372 5.67606C12.161 5.92665 12.3438 6.14344 12.5698 6.30784C12.7959 6.47224 13.0584 6.57934 13.335 6.61993L17.5385 7.23507C17.6181 7.24661 17.6929 7.28021 17.7545 7.33206C17.816 7.38391 17.8618 7.45195 17.8867 7.52849C17.9116 7.60502 17.9146 7.68699 17.8953 7.76513C17.8761 7.84327 17.8353 7.91445 17.7777 7.97064L14.7378 10.9308C14.5373 11.1262 14.3873 11.3673 14.3007 11.6335C14.2141 11.8997 14.1935 12.183 14.2406 12.4589L14.9583 16.6412C14.9723 16.7208 14.9637 16.8028 14.9335 16.8777C14.9032 16.9527 14.8524 17.0176 14.787 17.0651C14.7216 17.1126 14.6442 17.1408 14.5635 17.1464C14.4829 17.152 14.4023 17.1349 14.3309 17.0969L10.5734 15.1213C10.3258 14.9912 10.0503 14.9233 9.77066 14.9233C9.49102 14.9233 9.21556 14.9912 8.96797 15.1213L5.21121 17.0969C5.13988 17.1346 5.05938 17.1516 4.97887 17.1459C4.89836 17.1402 4.82107 17.112 4.75579 17.0645C4.69052 17.017 4.63987 16.9522 4.60962 16.8774C4.57937 16.8025 4.57073 16.7207 4.58468 16.6412L5.30153 12.4597C5.34888 12.1836 5.32837 11.9002 5.24176 11.6339C5.15514 11.3675 5.00503 11.1262 4.80437 10.9308L1.76447 7.97145C1.70636 7.91533 1.66519 7.84402 1.64564 7.76565C1.62608 7.68727 1.62894 7.60498 1.65387 7.52815C1.6788 7.45132 1.72481 7.38303 1.78666 7.33107C1.84851 7.27911 1.92371 7.24556 2.00369 7.23426L6.20634 6.61993C6.4832 6.57965 6.74613 6.4727 6.97249 6.30828C7.19885 6.14386 7.38187 5.92689 7.50579 5.67606L9.38457 1.86886Z" fill="#FFE330" stroke="#FFE330" stroke-width="1.46389" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          {% endfor %}
        </div>
      </div>
    </div>

    <div class="pf-quick-details">
      <div class="pf-weight-selector">
        <span class="pf-qv-weight">
          {% if product.variants.first.weight > 0 %}
            {{ product.variants.first.weight | round -}}
            {{- product.variants.first.weight_unit }}
          {% else %}
            70g
          {% endif %}
        </span>
      </div>

      <span class="pf-qd-item">
        <svg xmlns="http://www.w3.org/2000/svg" width="31" height="23" viewBox="0 0 31 23" fill="none">
          <path d="M26.9488 14.5563C26.9488 8.45595 21.7356 3.5108 15.3045 3.5108C8.87389 3.5108 3.66016 8.45595 3.66016 14.5563C3.66016 18.6233 7.136 21.9199 11.4231 21.9199H19.186C23.4735 21.9199 26.9488 18.6233 26.9488 14.5563Z" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M15.3072 12.7146V14.5555C15.3072 15.0439 15.103 15.5119 14.7391 15.8571C14.3752 16.2027 13.8813 16.3965 13.3665 16.3965C12.2948 16.3965 11.4258 15.5722 11.4258 14.5555" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M15.3027 12.7146V14.5555C15.3027 15.0439 15.5075 15.5119 15.8714 15.8571C16.2352 16.2027 16.7292 16.3965 17.2434 16.3965C18.3157 16.3965 19.1842 15.5722 19.1842 14.5555" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M14.3359 12.7148H16.2767" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M5.60179 12.7148H0.75" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M29.8616 12.7148H25.0098" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M5.60179 16.3965H0.75" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M29.8616 16.3965H25.0098" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M4.63184 10.1348V0.749312H4.63232C6.4959 0.749312 8.28331 1.45163 9.60151 2.70158L11.1992 4.21718" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M25.9819 10.1348V0.749312C24.1179 0.749312 22.3305 1.45163 21.0128 2.70158L19.415 4.21718" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M10.4521 9.95312C10.9878 9.44502 11.8577 9.44502 12.3929 9.95312" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
          <path d="M18.2178 9.95312C18.7534 9.44502 19.6233 9.44502 20.1585 9.95312" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {{ product.type }}
      </span>
      {% assign is_wet_or_dry = false %}
      {% for c in product.collections %}
        {% if c.title == 'Wet Food' or c.title == 'Dry Food' %}
          {% assign is_wet_or_dry = true %}
          {% break %}
        {% endif %}
      {% endfor %}
      {% if is_wet_or_dry %}
        <span class="pf-qd-item">
          <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 25 25" fill="none">
            <path d="M8.38 1.89617L8.95309 1.32308C9.71719 0.558974 10.9561 0.558974 11.7202 1.32308C12.4843 2.08718 12.4843 3.32605 11.7202 4.09016L8.38 7.43033L5.03987 4.09021C4.27577 3.3261 4.27577 2.08723 5.03987 1.32313C5.80398 0.559023 7.04285 0.559023 7.80696 1.32313L8.38 1.89617Z" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M19.9247 23.837H4.66321C2.50199 23.837 0.75 22.085 0.75 19.9238H23.838C23.838 22.085 22.086 23.837 19.9247 23.837Z" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M23.8393 6.22852L17.8193 12.4442" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M20.1192 19.9256C21.1999 19.9256 22.0758 19.0495 22.0758 17.969C22.0758 16.8884 21.1999 16.0124 20.1192 16.0124C20.1192 13.8511 18.3672 12.0992 16.206 12.0992C16.0349 12.0992 15.8667 12.111 15.7021 12.1335C15.0305 10.9449 13.7554 10.1426 12.2928 10.1426C10.8302 10.1426 9.55506 10.9449 8.88346 12.1335C8.71886 12.111 8.55074 12.0992 8.37958 12.0992C6.21841 12.0992 4.46637 13.8511 4.46637 16.0124C3.38574 16.0124 2.50977 16.8884 2.50977 17.969C2.50977 19.0495 3.38574 19.9256 4.46637 19.9256" stroke="#21252A" stroke-width="1.5" stroke-miterlimit="10" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="8.38065" cy="16.0115" r="0.978303" fill="#21252A"/>
            <circle cx="12.2937" cy="14.0545" r="0.978303" fill="#21252A"/>
          </svg>
          Balanced meal
        </span>
      {% endif %}
    </div>

    <!-- Benefits Grid -->
    <div class="pf-qv-benefits">
      {% if product.metafields.custom.key_benefits.value != blank %}
        {% for benefit in product.metafields.custom.key_benefits.value %}
          <div>
            <div class="pf-qv-benefits-icon">
              {% if benefit.icon != blank %}
                <img
                  src="{{ benefit.icon | image_url: width: 100 }}"
                  width="54"
                  height="54"
                  alt="{{ benefit.name | escape }}"
                  loading="lazy"
                  style="display:inline-block; max-width: 54px;"
                >
              {% else %}
                &#128049;
              {% endif %}
            </div>
            <span>{{ benefit.name }}</span>
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <!-- Add to cart -->
    <div class="pf-qv-addtocart-wrapper">
      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ product.variants.first.id }}">
        <div class="pf-qv-addtocart">
          <select name="quantity" class="pf-qv-packs-select">
            <option value="1">1 Pack</option>
            <option value="2">2 Packs</option>
            <option value="3">3 Packs</option>
            <option value="4">4 Packs</option>
            <option value="5">5 Packs</option>
          </select>
          <button
            type="submit"
            class="btn-add-to-cart pf-add-to-cart-btn"
            {% unless product.available %}
              disabled
            {% endunless %}
          >
            <span class="pf-qv-price-display" data-base-price="{{ product.price }}">
              {{- product.price | money_without_trailing_zeros | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' -}}
            </span>
            | <span class="pf-qv-add-text">{% if product.available %}Add to Cart{% else %}Sold Out{% endif %}</span>
          </button>
        </div>
      {% endform %}
    </div>
  </div>
</div>

<style>
  /* ==========================================================================
   1. Base Layout & Structure
   ========================================================================== */
  .pf-qv-inner {
    display: flex;
    gap: 60px;
    position: relative;
    padding: 6px 0;
    flex-wrap: wrap;
  }

  /* ==========================================================================
   2. Image Gallery
   ========================================================================== */
  .pf-qv-gallery {
    flex: 1;
    display: flex;
    gap: 20px;
  }
  .pf-qv-thumbnails-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-bottom: 20px;
    max-width: 94px;
  }
  .pf-qv-thumbnails {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: 500px;
    overflow-y: auto;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .pf-qv-thumbnails::-webkit-scrollbar {
    display: none;
  }
  img.pf-qv-thumb {
    object-fit: contain;
    border-radius: var(--border-radius-purrkins);
    border: 1px solid #e1e2e3;
    cursor: pointer;
    background: #fff;
    padding: 4px;
  }
  .pf-qv-main-image {
    flex: 1;
    border-radius: 22px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 526px;
    background-color: #e8f5ff;
    max-width: 100%;
  }
  #pf-qv-main-img {
    width: 100%;
    object-fit: cover;
    height: 100%;
    border-radius: var(--border-radius-purrkins);
  }

  /* ==========================================================================
   3. Product Info Section
   ========================================================================== */
  .pf-qv-info {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .pf-qv-info h2 {
    margin-top: 0;
    margin-bottom: 8px !important;
  }
  .pf-qv-info h4 {
    margin-bottom: 0 !important;
  }
  .pf-qv-info p.purrkins-subtext {
    font-family: var(--purrkins-primary-font);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.16px;
    font-size: 18px;
    margin: 0 0 10px;
    color: #26262b;
  }

  /* Badges & Rating */
  span.pf-qv-badge {
    color: #ffffff;
    font-size: 14px;
    padding: 6px 14px;
    font-weight: 700;
    border-radius: 999px;
    display: inline-block;
    margin-bottom: 14px;
    width: max-content;
    font-family: var(--purrkins-heading-font);
    line-height: 1.4;
  }
  .pf-qv-lifestage {
    color: var(--color-text-primary, #121217);
    font-family: var(--purrkins-heading-font);
    font-size: 14px;
    font-style: normal;
    font-weight: 700;
    line-height: 20px;
    letter-spacing: 0.14px;
    position: absolute;
    top: 20px;
    left: 20px;
    z-index: 2;
    display: inline-flex;
    padding: 5px 14px;
    justify-content: center;
    align-items: center;
    gap: 10px;
    border-radius: 1078.562px;
    border: 1.08px solid var(--brand-slate-900, #21252a);
  }
  .pf-star-rating {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
  }
  .pf-star-rating span {
    color: var(--color-text-primary, #121217);
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
  }

  /* Quick Details */
  .pf-quick-details {
    display: flex;
    gap: 18px;
    align-items: center;
    margin-bottom: 32px;
  }
  .pf-qd-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    font-weight: 500;
  }
  span.pf-qv-weight {
    color: var(--color-text-primary, #121217);
    text-align: center;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
    border-radius: 20px;
    background: var(--brand-yellow-100, #f6f3df);
    display: flex;
    width: 64px;
    padding: 6px 0;
    justify-content: center;
    align-items: center;
  }

  /* Benefits Section */
  .pf-qv-benefits {
    display: flex;
    flex-wrap: wrap;
    column-gap: 20px;
    row-gap: 24px;
    margin-bottom: 48px;
    color: var(--brand-slate-800, #32373e);
    text-align: center;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.5;
  }
  .pf-qv-benefits > div {
    max-width: 130px;
    width: 100%;
  }
  .pf-qv-benefits .pf-qv-benefits-icon {
    width: 80px;
    margin: 0 auto;
  }
  .pf-qv-benefits .pf-qv-benefits-icon img {
    width: 67px;
    height: 67px;
  }

  /* Actions & Buttons */
  .pf-qv-info-bottom {
    display: flex;
    align-items: center;
    gap: 20px;
    margin: 8px 0;
  }
  button.pf-qv-fav {
    position: absolute;
    top: 20px;
    right: 20px;
    border: none;
    cursor: pointer;
    z-index: 2;
    border-radius: 16px;
    background: var(--color-background, #fff);
    display: flex;
    width: 50px;
    height: 50px;
    justify-content: center;
    align-items: center;
    gap: 9.611px;
    aspect-ratio: 1 / 1;
  }
  .pf-qv-info .pf-qv-addtocart {
    display: flex;
    gap: 40px;
  }
  .pf-qv-info .pf-qv-addtocart select {
    border-radius: var(--radius-pill, 999px);
    border: 2px solid var(--brand-slate-900, #21252a);
    display: flex;
    width: 140px;
    height: 52px;
    padding: 0 32px 0 16px;
    justify-content: center;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    color: var(--color-text-primary, #121217);
    text-align: center;
    font-family: var(--purrkins-heading-font);
    font-size: 16px;
    font-weight: 700;
    line-height: 20px;
    -webkit-appearance: none;
    appearance: none;
    background-color: transparent;
    background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="11" height="6" viewBox="0 0 11 6" fill="none"><path d="M0.750015 0.75L5.25002 4.75L9.75002 0.75" stroke="%2321252A" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>');
    background-repeat: no-repeat;
    background-position: right 16px center;
    outline: none;
  }
  .pf-qv-info .pf-qv-addtocart .btn-add-to-cart {
    border-radius: 999px;
    background: var(--brand-yellow-500, #ffe330);
    display: flex;
    padding: 14px 28px;
    justify-content: center;
    align-items: center;
    gap: 10px;
    border: none;
    color: var(--color-text-primary, #121217);
    font-family: var(--purrkins-heading-font);
    font-size: 18px;
    font-weight: 700;
    line-height: 24px;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    width: 100%;
    max-width: 386px;
  }
  .pf-qv-info .pf-qv-addtocart .btn-add-to-cart:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(255, 227, 48, 0.4);
  }
  .pf-qv-info .pf-qv-addtocart .btn-add-to-cart[disabled] {
    background: #ccc;
    cursor: not-allowed;
    box-shadow: none;
    transform: none;
  }

  /* ==========================================================================
   4. Bowl Modal
   ========================================================================== */
  .pf-bowl-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 99999;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .pf-bowl-modal.visible {
    opacity: 1;
  }
  .pf-bowl-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
  }
  .pf-bowl-content {
    position: relative;
    background: #fff;
    border-radius: var(--border-radius-purrkins);
    width: 85%;
    max-width: 890px;
    padding: 36px 50px 50px 50px;
    z-index: 10;
    transform: translateY(20px);
    transition: transform 0.3s ease;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    box-sizing: border-box;
  }
  .pf-bowl-modal.visible .pf-bowl-content {
    transform: translateY(0);
  }
  .pf-bowl-close {
    position: absolute;
    top: 20px;
    right: 20px;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    border-radius: 999px;
    background: var(--primary-yellow-200, #f1eabc);
    width: 34px;
    height: 34px;
    justify-content: center;
    align-items: center;
    color: var(--primary-yellow-700, #a08c0a);
    font-family: var(--purrkins-heading-font);
    font-size: 16px;
    font-weight: 700;
  }
  button.pf-btn-bowl {
    margin-top: 24px;
    background: #fff;
    cursor: pointer;
    align-self: center;
    border-radius: 999px;
    border: 2px solid var(--brand-slate-900, #21252a);
    color: var(--color-text-primary, #121217);
    font-family: var(--purrkins-heading-font);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
    display: inline-flex;
    height: 52px;
    padding: 14px 22px;
    justify-content: center;
    align-items: center;
    gap: 10px;
  }

  /* Bowl Tabs */
  .pf-bowl-tabs {
    display: flex;
    gap: 32px;
    margin-bottom: 30px;
    border-bottom: 1.275px solid #303030;
    justify-content: space-between;
  }
  .pf-bowl-tab {
    background: none;
    border: none;
    padding: 10px 0 20px;
    cursor: pointer;
    position: relative;
    font-family: var(--purrkins-heading-font);
    color: #303030;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.32px;
  }
  .pf-bowl-tab.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 5px;
    background: #ffe330;
  }
  .pf-bowl-tab-content {
    display: none;
  }
  .pf-bowl-tab-content.active {
    display: block;
  }

  /* Bowl Ingredients Content */
  .pf-bowl-key-ingredients {
    display: flex;
    gap: 80px;
    margin-bottom: 20px;
    justify-content: space-between;
  }
  .pf-bowl-ingredient h4 {
    margin-bottom: 8px;
    margin-top: 0;
    color: #303030;
    font-size: 22px;
    font-weight: 600;
    line-height: 32px;
  }
  .pf-bowl-ingredient h2 {
    margin: 0;
    color: #303030;
    font-family: var(--purrkins-heading-font);
    font-size: 42px;
    font-weight: 800;
    line-height: 1.16;
    letter-spacing: -0.72px;
  }
  .pf-bowl-full-ingredients,
  .pf-bowl-text-content {
    color: #303030;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.6;
  }

  /* ==========================================================================
   5. Media Queries
   ========================================================================== */

  /* Tablet (Max 991px) */
  @media (max-width: 991px) {
    .pf-qv-inner {
      flex-direction: column;
      gap: 40px;
    }
    .pf-qv-gallery {
      flex-direction: column-reverse;
      width: 100%;
      min-width: 0;
    }
    .pf-qv-thumbnails-wrapper {
      flex-direction: row;
      overflow-x: auto;
      padding-bottom: 0;
      width: 100%;
      max-width: none;
      min-width: 0;
      justify-content: center;
    }
    .pf-qv-thumbnails {
      flex-direction: row;
      max-height: none;
      max-width: 100%;
      -webkit-mask-image: none !important;
      mask-image: none !important;
      gap: 12px;
    }
    img.pf-qv-thumb {
      width: 72px;
      height: 72px;
      flex-shrink: 0;
    }
    .pf-qv-main-image {
      width: 100%;
      max-width: 526px;
      margin: auto;
    }
    .pf-qv-scroll-arrow {
      display: none !important;
    }
    .pf-qv-info {
      width: 100%;
    }
    .pf-quick-details .pf-qd-item {
      display: none;
    }
    .pf-quick-details .pf-qd-item:first-of-type {
      display: flex;
      gap: 4px;
      font-size: 14px;
    }

    /* Bowl Modal */
    .pf-bowl-content {
      padding: 48px;
    }
    .pf-bowl-tab {
      font-size: 22px;
    }
    .pf-bowl-ingredient h4 {
      font-size: 18px;
    }
    .pf-bowl-ingredient h2 {
      font-size: 36px;
    }
    .pf-bowl-full-ingredients,
    .pf-bowl-text-content {
      font-size: 16px;
    }
  }

  /* Mobile (Max 767px) */
  @media (max-width: 767px) {
    .pf-qv-info {
      align-items: center;
    }
    .pf-qv-info h4 {
      text-align: center;
    }
    .pf-qv-info-bottom {
      flex-direction: row-reverse;
    }
    .pf-star-rating,
    span.pf-qv-weight {
      margin: 0;
      font-size: 14px;
    }
    .pf-qv-info .pf-qv-addtocart {
      gap: 16px;
      flex-direction: column;
      width: 100%;
    }
    .pf-qv-info .pf-qv-addtocart .btn-add-to-cart {
      width: 100%;
      max-width: 100%;
      font-size: 18px;
    }
    .pf-qv-info .pf-qv-addtocart select {
      width: 100%;
    }
    .pf-qv-benefits {
      gap: 16px;
      border-radius: 16px;
      background: #f7f7f7;
      padding: 30px 10px;
      margin-bottom: 32px;
      justify-content: center;
      font-size: 16px;
    }
    .pf-qv-benefits > div {
      max-width: 177px;
      width: calc(50% - 12px);
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .pf-qv-benefits span {
      max-width: 130px;
    }

    /* Bowl Modal */
    .pf-bowl-content {
      padding: 40px 20px;
    }
    .pf-bowl-close {
      top: 15px;
      right: 15px;
    }
    .pf-bowl-tabs {
      gap: 20px;
      overflow-x: auto;
      white-space: nowrap;
      border-bottom: 1px solid #303030;
      margin-bottom: 16px;
      padding-bottom: 0;
    }
    .pf-bowl-tab {
      font-size: 14px;
      padding: 10px 0 15px;
    }
    .pf-bowl-key-ingredients {
      gap: 24px;
      margin-bottom: 16px;
    }
    .pf-bowl-ingredient h4 {
      font-size: 16px;
    }
    .pf-bowl-ingredient h2 {
      font-size: 24px;
    }
  }
</style>

<!-- Bowl Modal -->
<div id="pf-bowl-modal-{{ product.id }}" class="pf-bowl-modal" style="display: none;">
  <div class="pf-bowl-overlay"></div>
  <div class="pf-bowl-content">
    <button class="pf-bowl-close">X</button>

    <div class="pf-bowl-tabs">
      <button class="pf-bowl-tab active" data-target="bowl-ingredients-{{ product.id }}">Ingredients</button>
      <button class="pf-bowl-tab" data-target="bowl-feeding-{{ product.id }}">Description</button>
      <button class="pf-bowl-tab" data-target="bowl-delivery-{{ product.id }}">Product Information</button>
    </div>

    <div class="pf-bowl-tab-content active" id="bowl-ingredients-{{ product.id }}">
      {% if product.metafields.custom.key_ingredients_tab.value != blank %}
        <div class="pf-bowl-key-ingredients">
          {% for ingredient in product.metafields.custom.key_ingredients_tab.value %}
            <div class="pf-bowl-ingredient">
              <h4>{{ ingredient.name }}</h4>
              <h2>{{ ingredient.percentage }}</h2>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <div class="pf-bowl-full-ingredients">
        {{ product.metafields.custom.full_ingredients | metafield_tag }}
      </div>
    </div>

    <div class="pf-bowl-tab-content" id="bowl-feeding-{{ product.id }}">
      <div class="pf-bowl-text-content">
        {{ product.description }}
      </div>
    </div>

    <div class="pf-bowl-tab-content" id="bowl-delivery-{{ product.id }}">
      <div class="pf-bowl-text-content">
        {{ product.metafields.custom.product_information | metafield_tag }}
      </div>
    </div>
  </div>
</div>
